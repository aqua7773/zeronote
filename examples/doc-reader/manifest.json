{
  "manifestVersion": 1,
  "id": "doc-reader",
  "name": "文档阅读器",
  "version": "0.1.0",
  "apiVersion": "^0.1.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "只读打开电子书和文档",
  "category": "reader",
  "capabilities": ["fs:read", "command", "view:main", "store"],
  "contributes": {
    "commands": [
      { "id": "doc-reader.open", "title": "文档阅读器：打开当前库里的文档…" }
    ]
  }
}
