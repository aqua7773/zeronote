{
  "znp": 1,
  "manifest": {
    "manifestVersion": 1,
    "id": "secrets",
    "name": "密码库",
    "version": "0.1.7",
    "apiVersion": "^0.2.0",
    "entry": "index.js",
    "styles": [
      "styles.css"
    ],
    "platforms": [
      "desktop",
      "android"
    ],
    "description": "绝密账号库：平台 / 账号两级，整库加密存 .zn/secrets/，需要先装「安全」插件提供密钥环",
    "category": "tool",
    "capabilities": [
      "command",
      "fs:read",
      "fs:write",
      "view:main"
    ],
    "activationEvents": [
      "onStartup"
    ],
    "dependencies": [
      "security"
    ],
    "contributes": {
      "commands": [
        {
          "id": "secrets.open",
          "title": "密码库：打开"
        },
        {
          "id": "secrets.lock",
          "title": "密码库：立即锁定"
        },
        {
          "id": "secrets.new-platform",
          "title": "密码库：新建平台"
        },
        {
          "id": "secrets.goto-recycle",
          "title": "密码库：回收站"
        },
        {
          "id": "secrets.recheck",
          "title": "密码库：重新检查密钥环"
        }
      ],
      "panels": [
        {
          "id": "secrets.panel",
          "title": "密码库",
          "location": "main"
        }
      ]
    },
    "sha256": "d408bc36bf14c70354fa6276c7354628b09cd6020b344b6f3eddf3404abdd979"
  },
  "files": {
    "index.js": "/**\n * 密码库插件（期 1b）—— 绝密账号 / 账号密码\n *\n * 方案：`docs/安全插件-方案-2026-10-25.md` §4.5（accepted）\n * 需求：§8.6 绝密账号管理\n *\n * ## 三条铁律（改这个文件之前先读）\n *\n * ① **明文只在解锁期存在**：落盘只有 `.zn/secrets/secrets.zn` 一份密文。\n * ② **绝不进内核索引**：不调 `index.write`、不写 `.md`、不写临时文件 ——\n *    一旦进索引，明文就落盘了（方案 §4.5「三条内存规则」）。\n * ③ **锁定时清空引用**：`db = null` + 清显示缓存。JS 无法保证擦除\n *    （Uint8Array 能 fill(0)，字符串不能），所以文档只说\"尽力清空\"，见方案 §6。\n *\n * ## 与 `security` 插件的关系\n *\n * 软依赖：`service.consume('crypto')` 拿不到就降级显示\"先去市场装安全插件\"，**不崩、不阻塞加载**。\n * 本插件**不碰密钥**：加密/解密全部经 `crypto` 服务，AAD 由服务端绑定 `secrets|secrets|<用途>`。\n *\n * ## 纯函数为什么都 export\n *\n * `tests/secrets.test.ts` 直接 import 这些函数测（与 `examples/security` 同做法）。\n * 只有 UI / 落盘 / 宿主交互留给 CDP 实测。\n */\n\n/* ───────────────────────── 常量 ───────────────────────── */\n\n/**\n * 消费的密钥环 id。\n *\n * rev173.416 起**由安全插件分配**：本插件只声明「我需要一个密钥环」，实际是哪个环\n * 由用户在「安全 → 密钥环分配」里定。默认 `secrets`（管理员没分配时读不到环）。\n */\nexport let RING = 'secrets'\n/** 加密容器 id —— 独立于 `private`（私密笔记），AAD 因此不会串 */\nexport const CONTAINER = 'secrets'\n/** 整库密文（单文件；**不是一条一文件** —— 方案 §4.5 已定） */\nexport const VAULT_FILE = '.zn/secrets/secrets.zn'\n/**\n * security 插件的 vault（只读：判断 secrets 环有没有建立）。\n *\n * rev173.335（真人测试9 #2）：「密码库插件一直显示未建立密钥环」的根因 ——\n * `security` 自 rev173.182 起把 vault **按环拆文件**（`.zn/security/vault.<环id>.json`），\n * 旧单文件 `vault.json` 只在还没迁移过的库上还有。这里原来只读旧单文件 ⇒\n * 迁移过的库存永远显示「还没建立」，而安全插件自己却说「已建立」（截图两张互相矛盾就是这个）。\n * 现在先读拆分文件、旧单文件兜底。\n */\nexport const SECURITY_VAULT_DIR = '.zn/security'\n/** 某个环的 vault 文件（库内相对路径，与 security 的 `vaultFileOf` 对齐） */\nexport function securityVaultFileOf(ringId) {\n  return `${SECURITY_VAULT_DIR}/vault.${ringId}.json`\n}\n/** 旧版单文件（按环拆之前）—— 只读兼容 */\nexport const SECURITY_VAULT = `${SECURITY_VAULT_DIR}/vault.json`\n\n/**\n * 单环 vault 文件（security rev173.182 拆出来的新格式）里是不是这个环。\n * 结构：`{ v: 2, ring: { id, ... } }`（见 security 的 `vaultPartPayload`）。\n */\nexport function hasRingPart(vaultText, ringId = RING) {\n  try {\n    return JSON.parse(vaultText)?.ring?.id === ringId\n  } catch {\n    return false\n  }\n}\nexport const PANEL_ID = 'secrets.panel'\n\n/** 空闲锁定：secrets 环比 notes 环狠一档（方案 §4.5 表：60 秒 vs 3 分钟） */\nexport const IDLE_LOCK_MS = 60_000\n/** 复制密码后多久清剪贴板（需求 §8.6：1 分钟） */\nexport const CLIP_TTL_MS = 60_000\n/** 回收站保留期（需求 §8.6：7 天） */\nexport const TRASH_TTL_MS = 7 * 24 * 60 * 60 * 1000\n/** 「显示密码」自动收起时间 —— 需求没规定，取 15 秒（够抄下来，又不至于一直摊着） */\nexport const REVEAL_TTL_MS = 15_000\n/** 密码默认长度（需求 §8.6：16 位） */\nexport const PASSWORD_LEN = 16\n\n/**\n * 密码字符集（需求 §8.6：大小写 + 数字，**排除 0/O/1/l/I**，不含符号）。\n *\n * 为什么排除这五个：手抄 / 口头念时最容易混淆。去掉后：\n * 小写 25（去 `l`）· 大写 24（去 `I` `O`）· 数字 8（去 `0` `1`）。\n */\nexport const ALPHABET = {\n  lower: 'abcdefghijkmnopqrstuvwxyz',\n  upper: 'ABCDEFGHJKLMNPQRSTUVWXYZ',\n  digit: '23456789',\n}\n\nconst ALL_CHARS = ALPHABET.lower + ALPHABET.upper + ALPHABET.digit\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\nconst nowMs = () => Date.now()\n\n/* ───────────────────────── 纯函数（tests/ 直接 import） ───────────────────────── */\n\n/** 唯一 id。优先 `crypto.randomUUID`（桌面 + Android WebView 都在）；老环境退回时间戳 + 随机尾巴 */\nexport function newId(prefix = '') {\n  const c = globalThis.crypto\n  if (c?.randomUUID) return prefix + c.randomUUID()\n  return prefix + nowMs().toString(36) + Math.random().toString(36).slice(2, 10)\n}\n\n/**\n * `[0, n)` 的均匀随机整数（注入式：测试传自己的 randInt，生产传系统随机）。\n *\n * 拒绝采样：直接 `% n` 在 n 不能整除 2^32 时有偏（密码学场合要避免）。\n */\nexport function defaultRandInt(n) {\n  if (!Number.isInteger(n) || n <= 0) throw new Error('randInt 的范围必须是正整数')\n  const c = globalThis.crypto\n  if (!c?.getRandomValues) {\n    // 没有 Web Crypto 时（不该发生）退回 Math.random —— 宁愿能生成，也不静默出空密码\n    return Math.floor(Math.random() * n)\n  }\n  const buf = new Uint32Array(1)\n  const limit = Math.floor(0x1_0000_0000 / n) * n\n  for (;;) {\n    c.getRandomValues(buf)\n    if (buf[0] < limit) return buf[0] % n\n  }\n}\n\n/**\n * 生成密码：默认 16 位，保证**至少各有一个**小写 / 大写 / 数字，然后洗牌。\n *\n * 为什么不纯随机拼：三类字符不设下限时，16 位里漏掉一类的概率约 5%（\n * `(25/57)^16 ≈ 0.0004`… 实际是小写漏掉的概率极低，但**全是小写字母**这种整类缺失\n * 在短密码上很常见）。保证三类都有，强度与可读性都更稳。\n */\nexport function generatePassword(length = PASSWORD_LEN, randInt = defaultRandInt) {\n  const len = Math.max(5, Math.trunc(Number(length) || PASSWORD_LEN))\n  const chars = [\n    ALPHABET.lower[randInt(ALPHABET.lower.length)],\n    ALPHABET.upper[randInt(ALPHABET.upper.length)],\n    ALPHABET.digit[randInt(ALPHABET.digit.length)],\n  ]\n  while (chars.length < len) chars.push(ALL_CHARS[randInt(ALL_CHARS.length)])\n  // Fisher–Yates：把固定的「小写·大写·数字」前缀打散，否则前三位恒定有序\n  for (let i = chars.length - 1; i > 0; i--) {\n    const j = randInt(i + 1)\n    const tmp = chars[i]\n    chars[i] = chars[j]\n    chars[j] = tmp\n  }\n  return chars.join('')\n}\n\n/** 空库 */\nexport function emptyDb() {\n  return { v: 1, updatedAt: 0, platforms: [] }\n}\n\n/**\n * 容错归一化：解密出来的 JSON 可能来自旧版本 / 手改过的备份。\n * 缺字段补默认，**不抛错**（每次弹错都让整个密码库打不开，代价太大）。\n */\nexport function normalizeDb(raw) {\n  const out = emptyDb()\n  if (!raw || typeof raw !== 'object') return out\n  out.updatedAt = Number(raw.updatedAt) || 0\n  const list = Array.isArray(raw.platforms) ? raw.platforms : []\n  for (const p of list) {\n    if (!p || typeof p !== 'object') continue\n    const accounts = Array.isArray(p.accounts) ? p.accounts : []\n    out.platforms.push({\n      id: String(p.id ?? newId('p_')),\n      name: String(p.name ?? '未命名平台'),\n      site: String(p.site ?? ''),\n      createdAt: Number(p.createdAt) || 0,\n      /* 平台整体进回收站（真人测试12 #2）：账号不动，整包一起躺 7 天 */\n      deletedAt: p.deletedAt ? Number(p.deletedAt) : null,\n      accounts: accounts\n        .filter((a) => a && typeof a === 'object')\n        .map((a) => ({\n          id: String(a.id ?? newId('a_')),\n          account: String(a.account ?? ''),\n          password: String(a.password ?? ''),\n          note: String(a.note ?? ''),\n          createdAt: Number(a.createdAt) || 0,\n          updatedAt: Number(a.updatedAt) || 0,\n          deletedAt: a.deletedAt ? Number(a.deletedAt) : null,\n        })),\n    })\n  }\n  return out\n}\n\n/** 平台按名称排序（**必须传 locale** —— rev173.154 的教训：不传 locale 在 CI 的 en-US 下排法不同） */\nexport function sortPlatforms(platforms) {\n  return [...platforms].sort((a, b) => String(a.name).localeCompare(String(b.name), 'zh'))\n}\n\n/** 密码掩码。长度不泄露真实长度（固定 8 个点，够看出\"有东西\"即可） */\nexport function maskSecret() {\n  return '········'\n}\n\n/** 某个平台下**活跃**（未进回收站）的账号 */\nexport function activeAccounts(platform) {\n  return (platform?.accounts ?? []).filter((a) => !a.deletedAt)\n}\n\n/** **活跃平台**（未整体进回收站）—— 列表 / 搜索 / 计数一律用它，别再各写一遍 `!p.deletedAt` */\nexport function activePlatforms(db) {\n  return (db?.platforms ?? []).filter((p) => !p.deletedAt)\n}\n\n/** 平台名 / 站点是否命中搜索词（**不搜密码** —— 需求 §8.6 明确） */\nexport function matchesPlatform(platform, q) {\n  const s = String(q ?? '').toLowerCase()\n  if (!s) return true\n  return (\n    String(platform?.name ?? '').toLowerCase().includes(s) ||\n    String(platform?.site ?? '').toLowerCase().includes(s)\n  )\n}\n\n/** 账号 / 备注是否命中搜索词（**不搜密码**） */\nexport function matchesAccount(account, q) {\n  const s = String(q ?? '').toLowerCase()\n  if (!s) return true\n  return (\n    String(account?.account ?? '').toLowerCase().includes(s) ||\n    String(account?.note ?? '').toLowerCase().includes(s)\n  )\n}\n\n/**\n * 列表树：`[{ platform, accounts }]`。\n *\n * 搜索语义：**平台命中 ⇒ 它下面全部账号都显示**（用户想找的是这个平台）；\n * 否则只显示命中账号的平台。\n *\n * **没有账号的平台也显示**（rev173.163 实测修）：第一版把空平台过滤掉了，\n * 结果\"新建平台 → 保存 → 列表里什么都没有\"，用户没法往里加账号。\n * 空平台在无搜索时保留，有搜索词时只在平台名/站点命中时出现。\n */\nexport function visibleTree(db, query = '') {\n  const q = String(query ?? '').trim().toLowerCase()\n  const out = []\n  for (const p of activePlatforms(db)) {\n    const active = activeAccounts(p)\n    if (!q) {\n      out.push({ platform: p, accounts: active })\n      continue\n    }\n    const hitPlatform = matchesPlatform(p, q)\n    const hitAccounts = active.filter((a) => matchesAccount(a, q))\n    if (!hitPlatform && !hitAccounts.length) continue\n    out.push({ platform: p, accounts: hitPlatform ? active : hitAccounts })\n  }\n  return out.sort((a, b) => String(a.platform.name).localeCompare(String(b.platform.name), 'zh'))\n}\n\n/**\n * 回收站条目（按删除时间倒序）+ 到期时间。\n *\n * 两种条目（真人测试12 #2 起）：\n *  · `kind: 'account'` —— 单个账号（原有语义，`account` 有值）\n *  · `kind: 'platform'` —— 整个平台连账号一起（`account` 为 null）\n *\n * ⚠️ 平台已整体删除时**不再单列它下面的账号** —— 否则同一个包会在回收站里\n * 出现 1 个平台 + N 个账号，用户点「恢复」会恢复出一个半截状态。\n */\nexport function trashList(db) {\n  const out = []\n  for (const p of db?.platforms ?? []) {\n    if (p.deletedAt) {\n      out.push({ kind: 'platform', platform: p, account: null, expiresAt: p.deletedAt + TRASH_TTL_MS })\n      continue\n    }\n    for (const a of p.accounts ?? []) {\n      if (!a.deletedAt) continue\n      out.push({ kind: 'account', platform: p, account: a, expiresAt: a.deletedAt + TRASH_TTL_MS })\n    }\n  }\n  return out.sort(\n    (x, y) =>\n      (y.account?.deletedAt ?? y.platform.deletedAt) - (x.account?.deletedAt ?? x.platform.deletedAt),\n  )\n}\n\n/** 真删超过 7 天的回收站条目，返回删掉的条数（整个平台算 1 条） */\nexport function purgeExpired(db, now = nowMs()) {\n  let removed = 0\n  const keepPlatforms = []\n  for (const p of db?.platforms ?? []) {\n    // 平台整体过期 ⇒ 连账号一起消失，不再按账号重复计数\n    if (p.deletedAt && now - p.deletedAt > TRASH_TTL_MS) {\n      removed++\n      continue\n    }\n    const keep = []\n    for (const a of p.accounts ?? []) {\n      if (a.deletedAt && now - a.deletedAt > TRASH_TTL_MS) {\n        removed++\n        continue\n      }\n      keep.push(a)\n    }\n    p.accounts = keep\n    keepPlatforms.push(p)\n  }\n  if (keepPlatforms.length !== (db?.platforms?.length ?? 0)) db.platforms = keepPlatforms\n  if (removed) db.updatedAt = now\n  return removed\n}\n\n/** 统计（面板抬头用）—— 已删平台算 1 条回收站，它的账号不再单独计数 */\nexport function describeDb(db) {\n  let platforms = 0\n  let accounts = 0\n  let trash = 0\n  for (const p of db?.platforms ?? []) {\n    if (p.deletedAt) {\n      trash++\n      continue\n    }\n    platforms++\n    for (const a of p.accounts ?? []) {\n      if (a.deletedAt) trash++\n      else accounts++\n    }\n  }\n  return { platforms, accounts, trash }\n}\n\n/** 找一个平台 */\nexport function findPlatform(db, platformId) {\n  return (db?.platforms ?? []).find((p) => p.id === platformId) ?? null\n}\n\n/** 找一个账号（含已删除的 —— 回收站里也要能操作） */\nexport function findAccount(db, platformId, accountId) {\n  return findPlatform(db, platformId)?.accounts?.find((a) => a.id === accountId) ?? null\n}\n\n/** 新建平台（重名允许：同名不同站点是合法场景） */\nexport function addPlatform(db, { name, site = '', now = nowMs(), id = null } = {}) {\n  const platform = {\n    id: id ?? newId('p_'),\n    name: String(name ?? '').trim(),\n    site: String(site ?? '').trim(),\n    createdAt: now,\n    deletedAt: null,\n    accounts: [],\n  }\n  db.platforms.push(platform)\n  db.updatedAt = now\n  return platform\n}\n\n/** 改平台名 / 站点 */\nexport function renamePlatform(db, platformId, { name, site, now = nowMs() } = {}) {\n  const p = findPlatform(db, platformId)\n  if (!p) return null\n  if (name != null) p.name = String(name).trim()\n  if (site != null) p.site = String(site).trim()\n  db.updatedAt = now\n  return p\n}\n\n/** 加账号 */\nexport function addAccount(\n  db,\n  platformId,\n  { account = '', password = '', note = '', now = nowMs(), id = null } = {},\n) {\n  const p = findPlatform(db, platformId)\n  if (!p) return null\n  const acc = {\n    id: id ?? newId('a_'),\n    account: String(account ?? '').trim(),\n    password: String(password ?? ''),\n    note: String(note ?? ''),\n    createdAt: now,\n    updatedAt: now,\n    deletedAt: null,\n  }\n  p.accounts.push(acc)\n  db.updatedAt = now\n  return acc\n}\n\n/** 改账号（`patch` 里只取认得的字段） */\nexport function updateAccount(db, platformId, accountId, patch = {}, now = nowMs()) {\n  const acc = findAccount(db, platformId, accountId)\n  if (!acc) return null\n  if (patch.account != null) acc.account = String(patch.account).trim()\n  if (patch.password != null) acc.password = String(patch.password)\n  if (patch.note != null) acc.note = String(patch.note)\n  acc.updatedAt = now\n  db.updatedAt = now\n  return acc\n}\n\n/** 软删除（进回收站） */\nexport function trashAccount(db, platformId, accountId, now = nowMs()) {\n  const acc = findAccount(db, platformId, accountId)\n  if (!acc || acc.deletedAt) return null\n  acc.deletedAt = now\n  acc.updatedAt = now\n  db.updatedAt = now\n  return acc\n}\n\n/** 从回收站恢复 */\nexport function restoreAccount(db, platformId, accountId, now = nowMs()) {\n  const acc = findAccount(db, platformId, accountId)\n  if (!acc || !acc.deletedAt) return null\n  acc.deletedAt = null\n  acc.updatedAt = now\n  db.updatedAt = now\n  return acc\n}\n\n/** 真删除（不可撤销；UI 必须二次确认） */\nexport function purgeAccount(db, platformId, accountId, now = nowMs()) {\n  const p = findPlatform(db, platformId)\n  if (!p) return false\n  const before = p.accounts.length\n  p.accounts = p.accounts.filter((a) => a.id !== accountId)\n  if (p.accounts.length === before) return false\n  db.updatedAt = now\n  return true\n}\n\n/* ─── 平台整体删除（真人测试12 #2「密码库只有新建平台，无法删除平台」） ───\n *\n * 为什么**给平台自己加 deletedAt**，而不是把下面每个账号标删：\n *  · 账号标删 ⇒ 回收站里会出现「1 个平台 + N 个账号」的碎条目，恢复一半就成半截状态；\n *  · 平台标删 ⇒ 整包一个条目，恢复即完整回来，到期即整包消失。\n * 账号自己原来的 deletedAt 原样保留（进平台回收站前就躺着的那些，恢复后仍在账号回收站）。\n */\n\n/** 平台整体进回收站 */\nexport function trashPlatform(db, platformId, now = nowMs()) {\n  const p = findPlatform(db, platformId)\n  if (!p || p.deletedAt) return null\n  p.deletedAt = now\n  db.updatedAt = now\n  return p\n}\n\n/** 从回收站恢复整个平台（连同它下面账号的原有状态一起回来） */\nexport function restorePlatform(db, platformId, now = nowMs()) {\n  const p = findPlatform(db, platformId)\n  if (!p || !p.deletedAt) return null\n  p.deletedAt = null\n  db.updatedAt = now\n  return p\n}\n\n/** 彻底删除整个平台（不可撤销；UI 必须二次确认） */\nexport function purgePlatform(db, platformId, now = nowMs()) {\n  const before = (db?.platforms ?? []).length\n  db.platforms = (db?.platforms ?? []).filter((p) => p.id !== platformId)\n  if (db.platforms.length === before) return false\n  db.updatedAt = now\n  return true\n}\n\n/** 剩余保留天数（回收站行用；向上取整，剩 6 小时算 1 天） */\nexport function daysLeft(expiresAt, now = nowMs()) {\n  return Math.max(0, Math.ceil((expiresAt - now) / (24 * 60 * 60 * 1000)))\n}\n\n/* ───────────────────────── 插件状态（闭包内，不落盘） ───────────────────────── */\n\n/** crypto 服务（null = 安全插件没装 / 还没加载） */\nlet svc = null\n/** 解密后的整库（null = 没解锁） */\nlet db = null\n/** 上一次 render 的 state 快照（ViewApi 没有 getState，命令里读输入值靠它） */\nlet ui = {}\n/** 忙碌态（KDF 派生 1 秒期间要让人看见） */\nlet busy = ''\n/** 状态条消息 */\nlet message = { text: '', tone: 'muted' }\n/** 视图：list / edit / recycle */\nlet mode = 'list'\n/** 展开的平台 id */\nlet expanded = new Set()\n/** 展开的账号 id（卡片化后账号也折叠，收起时只看账号名） */\nlet expandedAccounts = new Set()\n/** 待二次确认的删除：`{ kind: 'platform', platformId }`；null = 没有在等确认 */\nlet confirmDelete = null\n/** 正在显示明文的账号 id（15 秒后自动收起） */\nlet revealed = new Set()\nconst revealTimers = new Map()\n/** 编辑态 */\nlet editing = null // { kind: 'platform' | 'account', platformId, accountId }\n/** secrets 环是否已建立（首屏就能提示，不用等解锁失败） */\nlet ringReady = false\n/**\n * 本机指纹状态（rev173.336 · 真人测试10 #1「密码库解锁界面无法调用指纹」）。\n *\n * `available` = 这台设备有可用的生物识别硬件/适配器（Windows Hello / Android 指纹）；\n * `bound` = **这个环**（`secrets`）在这台设备上绑过。\n *\n * 为什么缓存成同步可读：面板 render 是同步的（UINode 声明式），不能在里面 await IPC。\n * 刷新时机 = 拿到服务 / 解锁 / 锁定 / 绑定 / 解除 —— 见 `refreshBiometric`。\n */\nlet biometric = { available: false, bound: false }\n\n/** 从 crypto 服务读指纹状态（服务没有 biometric 扩展 = 老版安全插件 ⇒ 都是 false） */\nasync function refreshBiometric() {\n  try {\n    const b = svc?.biometric\n    if (!b) {\n      biometric = { available: false, bound: false }\n      return biometric\n    }\n    biometric = { available: Boolean(b.available()), bound: Boolean(b.bound(RING)) }\n  } catch {\n    biometric = { available: false, bound: false }\n  }\n  return biometric\n}\n/** 最近一次操作时间（空闲锁定用） */\nlet lastActive = 0\n/** 外部写入后重查「安全」vault 的间隔（rev173.393；只在前台 + 未解锁时生效） */\nconst RING_RECHECK_MS = 30_000\n/** 剪贴板：值 + 计划清空的时刻（后台冻结时靠时间戳补判） */\nlet clip = { value: '', deadline: 0 }\nlet clipTimer = null\n/** 面板 id 常量在顶部 */\n\n/* ───────────────────────── 剪贴板（原生优先，网页 API 回退） ───────────────────────── */\n\n/** 插件在宿主页面里跑，拿注入的 Tauri 入口（桌面 / 浏览器之外没有它） */\nfunction ipc() {\n  return globalThis.__TAURI_INTERNALS__ || null\n}\n\n/**\n * 写剪贴板。\n *\n * 为什么不用 `navigator.clipboard` 一条路：Android WebView 把 `clipboard-read` 固定成 denied\n * （`src/App.tsx:2969` 实测），写虽然可用，但桌面 WebView2 在非焦点状态下也会失败 ⇒\n * 先走原生 `tauri-plugin-clipboard-manager`（capabilities 已放行 read/write text），失败再回退。\n */\nasync function clipboardWrite(text) {\n  const t = ipc()\n  if (t) {\n    try {\n      await t.invoke('plugin:clipboard-manager|write_text', { text })\n      return true\n    } catch {\n      /* 回退 */\n    }\n  }\n  try {\n    await navigator.clipboard.writeText(text)\n    return true\n  } catch {\n    return false\n  }\n}\n\n/** 读剪贴板（Android 后台受限 ⇒ 读不到就当空，不抛错） */\nasync function clipboardRead() {\n  const t = ipc()\n  if (t) {\n    try {\n      const s = await t.invoke('plugin:clipboard-manager|read_text')\n      if (typeof s === 'string') return s\n    } catch {\n      /* 回退 */\n    }\n  }\n  try {\n    return await navigator.clipboard.readText()\n  } catch {\n    return ''\n  }\n}\n\n/**\n * 复制密码 + 计划 60 秒后清空。\n *\n * **只在剪贴板内容仍是这个密码时才清** —— 否则会误删用户后复制的东西（方案 §4.5）。\n */\nfunction copySecret(value) {\n  clip = { value, deadline: nowMs() + CLIP_TTL_MS }\n  if (clipTimer) clearTimeout(clipTimer)\n  clipTimer = setTimeout(() => void settleClipboard(), CLIP_TTL_MS)\n}\n\n/** 到点清剪贴板；也被「解锁 / 面板重开」调用（Android 后台定时器会被冻结） */\nasync function settleClipboard() {\n  clipTimer = null\n  const pending = clip\n  clip = { value: '', deadline: 0 }\n  if (!pending.value) return\n  const cur = await clipboardRead()\n  if (cur !== pending.value) return\n  await clipboardWrite('')\n}\n\n/* ───────────────────────── 落盘 ───────────────────────── */\n\nfunction setMessage(text, tone = 'muted') {\n  message = { text, tone }\n}\n\n/**\n * rev173.416：向 security 声明「我需要一个密钥环」，并跟上它分配给我的那个环。\n *\n * 插件不再挑环（用户 2026-11-07 拍板：密钥由安全插件分配）；`svc.demand()` 幂等\n * 登记需求并返回当前分配（没分配 ⇒ null）。拿不到服务 / 安全插件版本旧 ⇒\n * 保持默认 `secrets`，行为与之前一致。\n */\nfunction adoptRing() {\n  try {\n    const got = svc?.demand?.()\n    if (typeof got === 'string' && got) RING = got\n  } catch {\n    /* 没装安全插件 / 版本旧：保持默认，等 service:available 再来 */\n  }\n}\n\n/**\n * 读 security 的 vault 看 secrets 环建了没有（只读，不写别人的文件）。\n *\n * 两种布局都要认（rev173.335）：\n *  · 新：`.zn/security/vault.<环id>.json` ⇒ `{ v: 2, ring: { id, ... } }`\n *  · 旧：`.zn/security/vault.json` ⇒ `{ v: 1, rings: { <环id>: {...} } }`\n * 先新后旧；两个都不存在 = 安全插件没建过这个环（正常首次态）。\n */\nasync function checkRingReady(api) {\n  try {\n    const text = await api.fs.readText(securityVaultFileOf(RING))\n    if (hasRingPart(text, RING)) {\n      ringReady = true\n      return ringReady\n    }\n  } catch {\n    // 没有拆分文件是正常态（还没建过 / 还没迁移）—— 继续看旧单文件\n  }\n  try {\n    const text = await api.fs.readText(SECURITY_VAULT)\n    ringReady = Boolean(JSON.parse(text)?.rings?.[RING])\n  } catch {\n    ringReady = false // 文件不存在 = 安全插件没建过任何环\n  }\n  return ringReady\n}\n\n/**\n * 重查判定（rev173.393 纯函数，单测覆盖）：已解锁 / 状态没变 ⇒ 不刷新。\n *\n * 已解锁时不查 —— 内存里已有数据，重查只会让面板在「有环 / 无环」之间跳来跳去。\n */\nexport function ringNeedsRefresh({ unlocked, before, after }) {\n  if (unlocked) return false\n  return before !== after\n}\n\n/**\n * 外部写入后重查一次「环建了没有」（rev173.393）。\n *\n * 面板原来只在 `apply()` / 手动点「重新检查」时读 —— 同步把 vault 拉下来之后一直显示\n * 「还没建立密钥环」。见 `ringNeedsRefresh`。\n */\nasync function refreshRingIfChanged(api, reason) {\n  const before = ringReady\n  if (db !== null) return false\n  await checkRingReady(api).catch(() => before)\n  if (!ringNeedsRefresh({ unlocked: db !== null, before, after: ringReady })) return false\n  api.host.log?.('info', `[secrets] 密钥环状态变化（${reason}）⇒ 存在=${ringReady}`)\n  api.view.refresh(PANEL_ID)\n  return true\n}\n\n/**\n * 解锁并加载整库。\n *\n * 两种失败要分开：**环还没建**（去安全插件建）vs **密码不对**（重输）。\n * `crypto.unlock` 抛的是普通 Error，只能按消息文本判 —— 所以这里不静默吞错，\n * 把原文带上，用户能看见到底是哪一步坏了。\n */\nasync function unlockAndLoad(api, password) {\n  if (!svc) throw new Error('没拿到 crypto 服务（安全插件没装？）')\n  adoptRing() // rev173.416：解锁前跟上最新的环分配（用户可能刚在安全面板改过）\n  const pw = String(password ?? '')\n  if (!pw) throw new Error('请输入主密码')\n  await svc.unlock(RING, pw) // Argon2id 约 1 s（桌面）：调用方先渲染\"正在派生…\"\n  return afterUnlocked(api)\n}\n\n/**\n * **服务侧已解锁之后**的收尾（rev173.336 抽出来给指纹用）。\n *\n * 指纹解锁的前提是 DEK 已经由安全插件解出来并写进它的 live 表；这里只做「读整库 +\n * 重置视图状态 + 过期清理」，与主密码路径共用同一段，避免两条路慢慢漂。\n */\nasync function afterUnlocked(api) {\n  db = await loadDb(api)\n  lastActive = nowMs()\n  mode = 'list'\n  expanded = new Set()\n  expandedAccounts = new Set()\n  confirmDelete = null\n  revealed = new Set()\n  const removed = purgeExpired(db)\n  if (removed) await saveDb(api) // 过期清理要落盘，否则每次解锁都白算\n  setMessage('', 'muted')\n  return db\n}\n\n/**\n * 生物识别错误 → 人话（rev173.336）。\n *\n * 安全插件的 `biometricErrorMessage` 在它自己的模块里，消费者拿不到（crypto 服务只给动作）；\n * 这里按同样的错误码写一份精简版，别把 `biometryLockout` 原样甩给用户。\n */\nfunction fingerprintErrorText(e) {\n  const raw = String(e?.message ?? e ?? '')\n  if (/AEADBadTag|Failed to decrypt|decrypt the data/i.test(raw)) {\n    return '指纹解不开这把密文 —— 多半是换过 / 新增过指纹。请用主密码解锁后重新绑定'\n  }\n  if (/userCancel|Cancel|canceled|cancelled/i.test(raw)) return '已取消'\n  if (/biometryLockout|Lockout|too many/i.test(raw)) return '指纹尝试次数过多，请稍后再试或用主密码'\n  if (/biometryNotEnrolled|not enrolled/i.test(raw)) return '系统里没有录入指纹'\n  if (/biometryNotAvailable|No hardware|unavailable/i.test(raw)) return '这台设备当前用不了指纹'\n  if (/还没绑定|没有绑定/.test(raw)) return '这台设备还没绑定指纹 —— 用主密码解锁后绑定'\n  return raw\n}\n\n/** 读整库密文 → 明文对象。文件不存在 = 首次（空库） */\nasync function loadDb(api) {\n  let text = ''\n  try {\n    if (await api.fs.exists(VAULT_FILE)) text = await api.fs.readText(VAULT_FILE)\n  } catch {\n    text = ''\n  }\n  if (!text.trim()) return emptyDb()\n  const plain = await svc.decryptText({ ring: RING, container: CONTAINER, payload: text.trim() })\n  return normalizeDb(JSON.parse(plain))\n}\n\n/**\n * 整库加密写盘。\n *\n * 坏文件**不覆盖**：解密失败时 `db` 根本不会被赋值（异常向上抛），调用方也就不该走到这里。\n * 这里再加一道 —— 没有 db 就别写，避免把空库盖掉真实数据。\n */\nasync function saveDb(api) {\n  if (!db) throw new Error('密码库没解锁，拒绝写入')\n  const payload = await svc.encrypt({\n    ring: RING,\n    container: CONTAINER,\n    data: JSON.stringify(db),\n  })\n  try {\n    await api.fs.mkdir('.zn/secrets')\n  } catch {\n    /* 目录已存在 */\n  }\n  await api.fs.writeText(VAULT_FILE, payload)\n  lastActive = nowMs()\n}\n\n/* ───────────────────────── 锁定 ───────────────────────── */\n\nfunction lockNow(api, reason = 'manual') {\n  db = null\n  revealed = new Set()\n  for (const t of revealTimers.values()) clearTimeout(t)\n  revealTimers.clear()\n  editing = null\n  mode = 'list'\n  expanded = new Set()\n  expandedAccounts = new Set()\n  confirmDelete = null\n  try {\n    svc?.lock(RING)\n  } catch {\n    /* 服务侧没解锁过（例如别的窗口）—— 无所谓，本地引用已经清掉 */\n  }\n  setMessage(reason === 'idle' ? '空闲 60 秒，已自动锁定' : '', 'muted')\n  api.view.refresh(PANEL_ID)\n}\n\n/** 空闲判定：Android 后台会冻结定时器 ⇒ 只靠时间戳，不靠\"定时器还在跑\" */\nfunction checkIdle(api) {\n  if (!db || !lastActive) return\n  if (nowMs() - lastActive > IDLE_LOCK_MS) lockNow(api, 'idle')\n}\n\n/** 任何用户操作都刷新活动时间 */\nfunction touch() {\n  lastActive = nowMs()\n}\n\n/* ───────────────────────── 面板 ───────────────────────── */\n\nconst BINDS = {\n  search: 'secrets.search',\n  pw: 'secrets.pw',\n  name: 'secrets.name',\n  site: 'secrets.site',\n  account: 'secrets.account',\n  password: 'secrets.password',\n  note: 'secrets.note',\n}\n\n/** 读一个 bind 的值（render 快照里取） */\nfunction val(bind) {\n  const v = ui[bind]\n  return typeof v === 'string' ? v : ''\n}\n\nfunction textNode(value, variant, tone) {\n  const n = { type: 'text', value }\n  if (variant) n.variant = variant\n  if (tone) n.tone = tone\n  return n\n}\n\nfunction btn(label, action, extra = {}) {\n  return { type: 'button', label, onClick: action, ...extra }\n}\n\n/** 「安全插件没装」的降级视图（软依赖标准做法：不崩、给出去哪装） */\nfunction noServiceView() {\n  return {\n    type: 'stack',\n    gap: 'md',\n    children: [\n      textNode('🔒 密码库还没连上加密服务', 'title'),\n      textNode(\n        '本插件不自己保管密钥 —— 加密由「安全」插件提供的 crypto 服务完成。请先从市场安装「安全」插件，再回来。',\n        'body',\n      ),\n      {\n        type: 'row',\n        gap: 'sm',\n        children: [btn('打开插件管理', 'secrets.open-plugins', { variant: 'default' })],\n      },\n      textNode('（装好安全插件后不用重启本插件：服务一出现这里会自动刷新）', 'caption', 'muted'),\n    ],\n  }\n}\n\n/** 锁定视图：输主密码 */\nfunction lockedView() {\n  const children = [\n    textNode('🔒 密码库已锁定', 'title'),\n    textNode('这里要的是「账号密码」那把主密码 —— 与私密笔记的主密码是两把，互不派生。', 'caption', 'muted'),\n  ]\n\n  if (!ringReady) {\n    children.push(\n      textNode('还没建立「账号密码」密钥环。', 'body', 'warn'),\n      textNode('去「安全」插件新建一个密钥环，选「账号密码」这一档。', 'caption', 'muted'),\n      {\n        type: 'row',\n        gap: 'sm',\n        children: [btn('打开安全插件', 'secrets.open-security'), btn('重新检查', 'secrets.recheck', { variant: 'ghost' })],\n      },\n    )\n    return { type: 'stack', gap: 'md', children }\n  }\n\n  children.push({\n    type: 'field',\n    label: '主密码',\n    hint: busy === RING ? '正在派生密钥…（Argon2id，桌面约 1 秒）' : undefined,\n    children: {\n      type: 'input',\n      bind: BINDS.pw,\n      secret: true,\n      placeholder: '账号密码库的主密码',\n      onSubmit: 'secrets.unlock',\n    },\n  })\n  children.push({\n    type: 'row',\n    gap: 'sm',\n    children: [btn('解锁', 'secrets.unlock', { send: BINDS.pw, variant: 'default' })],\n  })\n  /* 指纹解锁（rev173.336 · 真人测试10 #1）：绑过这台设备就直接给按钮，不用先输主密码 */\n  if (biometric.available && biometric.bound) {\n    children.push({\n      type: 'row',\n      gap: 'sm',\n      children: [btn('用指纹解锁', 'secrets.biometric-unlock', { variant: 'ghost' })],\n    })\n  }\n  if (message.text) children.push(textNode(message.text, 'caption', message.tone))\n  children.push(textNode('空闲 60 秒自动锁定 · 主密码只在本机内存里用于派生，不落盘', 'caption', 'muted'))\n  return { type: 'stack', gap: 'md', children }\n}\n\n/**\n * 一个账号 = **一张小卡片**（真人测试12 #3，参考用户给的布局图）。\n *\n * 收起时只有一行（账号 + 复制/修改/删除 + 展开箭头）；\n * 展开才显示密码与备注 —— 密码用「按住 👁 才显示」，松手立刻收起。\n *\n * ⚠️ `stack.children` 只吃 UINode，`{key,node}` 是 `list.items` 的包装形式。\n * 第一版这里返回了包装对象 ⇒ 整段 JSON 被当文本摊在界面上（rev173.163 实测抓到）。\n */\nfunction accountCard(platform, account) {\n  const open = expandedAccounts.has(account.id)\n  const shown = revealed.has(account.id)\n  const payload = { platformId: platform.id, accountId: account.id }\n  const children = [\n    {\n      type: 'row',\n      gap: 'sm',\n      align: 'center',\n      wrap: true,\n      cssClass: 'sx-row-between',\n      children: [\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          wrap: true,\n          children: [textNode(account.account || '（未填账号）')],\n        },\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          children: [\n            btn('复制', 'secrets.copy', { variant: 'ghost', payload }),\n            btn('修改', 'secrets.edit-account', { variant: 'ghost', payload }),\n            btn('删除', 'secrets.del-account', { variant: 'danger', payload, cssClass: 'sx-danger-ghost' }),\n            btn(open ? '▾' : '▸', 'secrets.toggle-account', { variant: 'ghost', payload, cssClass: 'sx-caret' }),\n          ],\n        },\n      ],\n    },\n  ]\n  if (open) {\n    children.push({\n      type: 'stack',\n      gap: 'sm',\n      cssClass: 'sx-account-detail',\n      children: [\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          wrap: true,\n          /* 值靠左、按钮靠右 —— 两行的「复制」落在同一列（真人测试12 复看） */\n          cssClass: 'sx-row-between',\n          children: [\n            {\n              type: 'row',\n              gap: 'sm',\n              align: 'center',\n              wrap: true,\n              children: [\n                textNode('密码：', 'caption', 'muted'),\n                textNode(shown ? account.password || '（空）' : maskSecret(), 'caption', shown ? 'warn' : 'muted'),\n              ],\n            },\n            {\n              type: 'row',\n              gap: 'sm',\n              align: 'center',\n              children: [\n                /* 按住显示（真人测试12 #3）：按下显示明文，松手立刻收起。\n                   onClick 必须给（契约必填），但按下-松开之间已经走完，所以指向空命令。 */\n                {\n                  type: 'button',\n                  label: '👁',\n                  onClick: 'secrets.noop',\n                  onDown: 'secrets.reveal-hold',\n                  onUp: 'secrets.reveal-release',\n                  payload,\n                  variant: 'ghost',\n                  cssClass: 'sx-hold',\n                },\n                btn('复制', 'secrets.copy', { variant: 'ghost', payload }),\n              ],\n            },\n          ],\n        },\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          wrap: true,\n          cssClass: 'sx-row-between',\n          children: [\n            {\n              type: 'row',\n              gap: 'sm',\n              align: 'center',\n              wrap: true,\n              children: [\n                textNode('备注：', 'caption', 'muted'),\n                textNode(account.note || '（空）', 'caption', account.note ? 'default' : 'muted'),\n              ],\n            },\n            ...(account.note\n              ? [\n                  {\n                    type: 'row',\n                    gap: 'sm',\n                    align: 'center',\n                    children: [btn('复制', 'secrets.copy-note', { variant: 'ghost', payload })],\n                  },\n                ]\n              : []),\n          ],\n        },\n      ],\n    })\n  }\n  return { type: 'stack', gap: 'sm', cssClass: 'sx-card sx-account-card', children }\n}\n\n/**\n * 一个平台 = **一张大卡片**（真人测试12 #2 / #3）。\n *\n * 标题行右侧：＋账号 / 修改 / 删除 / 展开箭头。\n * 点「删除」不立刻删 —— 先把卡片切成确认态（真人测试12 #2 要求二次确认），\n * 确认后才整体进回收站（平台 + 它的账号，7 天可恢复）。\n */\nfunction platformCard(platform, accounts) {\n  const open = expanded.has(platform.id)\n  const confirming = confirmDelete?.kind === 'platform' && confirmDelete.platformId === platform.id\n  const total = (platform.accounts ?? []).length\n  const children = [\n    {\n      type: 'row',\n      gap: 'sm',\n      align: 'center',\n      /* 标题 / 徽标靠左、操作按钮靠右（真人测试12 复看：按钮原先紧贴标题，视觉上挤在一起） */\n      /* 2026-11-05 用户要求（手机）：操作按钮**与平台名称同一行**，不换行。\n         ⇒ 去掉 `wrap`；左侧 `.sx-platform-head` 可内部折行，右侧 `.sx-platform-actions`\n         保持单行（窄屏由 styles.css 收紧按钮内边距）。 */\n      cssClass: 'sx-row-between sx-platform-head-row',\n      children: [\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          wrap: true,\n          cssClass: 'sx-platform-head',\n          children: [\n            textNode(platform.name, 'title'),\n            { type: 'badge', text: `${accounts.length} 个账号`, tone: 'default' },\n            ...(platform.site ? [textNode(platform.site, 'caption', 'muted')] : []),\n          ],\n        },\n        {\n          type: 'row',\n          gap: 'sm',\n          align: 'center',\n          cssClass: 'sx-platform-actions',\n          children: [\n            btn('＋账号', 'secrets.new-account', { variant: 'ghost', payload: { platformId: platform.id } }),\n            btn('修改', 'secrets.edit-platform', { variant: 'ghost', payload: { platformId: platform.id } }),\n            btn('删除', 'secrets.ask-del-platform', { variant: 'danger', payload: { platformId: platform.id }, cssClass: 'sx-danger-ghost' }),\n            btn(open ? '▾' : '▸', 'secrets.toggle', { variant: 'ghost', payload: { platformId: platform.id }, cssClass: 'sx-caret' }),\n          ],\n        },\n      ],\n    },\n  ]\n  if (confirming) {\n    children.push({\n      type: 'stack',\n      gap: 'sm',\n      cssClass: 'sx-confirm',\n      children: [\n        textNode(\n          `删除「${platform.name}」？它下面的 ${total} 个账号会一起进回收站（保留 7 天，可恢复）。`,\n          'caption',\n          'warn',\n        ),\n        {\n          type: 'row',\n          gap: 'sm',\n          children: [\n            btn('确认删除', 'secrets.del-platform', { variant: 'danger', payload: { platformId: platform.id } }),\n            btn('取消', 'secrets.cancel-del-platform', { variant: 'ghost', payload: { platformId: platform.id } }),\n          ],\n        },\n      ],\n    })\n  }\n  if (open) {\n    children.push(\n      ...(accounts.length\n        ? accounts.map((a) => accountCard(platform, a))\n        : [textNode('还没有账号 —— 点上面的「＋账号」加一个', 'caption', 'muted')]),\n    )\n  }\n  return { type: 'stack', gap: 'sm', cssClass: 'sx-card sx-platform-card', children }\n}\n\n/** 列表视图 */\nfunction listView() {\n  const q = val(BINDS.search)\n  const tree = visibleTree(db, q)\n  const stat = describeDb(db)\n\n  const children = [\n    {\n      type: 'row',\n      gap: 'sm',\n      align: 'center',\n      wrap: true,\n      children: [\n        textNode(`🔓 密码库 · ${stat.platforms} 个平台 / ${stat.accounts} 个账号`, 'title'),\n        {\n          type: 'badge',\n          text: stat.trash ? `回收站 ${stat.trash}` : '回收站空',\n          tone: stat.trash ? 'warn' : 'muted',\n        },\n        btn('回收站', 'secrets.goto-recycle', { variant: 'ghost' }),\n        btn('锁定', 'secrets.lock', { variant: 'ghost' }),\n      ],\n    },\n    /* 指纹绑定（rev173.336 · 真人测试10 #1）：解锁后才谈得上绑定；没硬件就不显示 */\n    ...(biometric.available\n      ? [\n          {\n            type: 'row',\n            gap: 'sm',\n            align: 'center',\n            wrap: true,\n            children: [\n              { type: 'badge', text: biometric.bound ? '本机已绑定指纹' : '本机未绑定指纹', tone: biometric.bound ? 'success' : 'muted' },\n              biometric.bound\n                ? btn('解除本机指纹', 'secrets.biometric-unbind', { variant: 'ghost' })\n                : btn('绑定本机指纹', 'secrets.biometric-bind', { variant: 'ghost' }),\n            ],\n          },\n        ]\n      : []),\n    {\n      type: 'input',\n      bind: BINDS.search,\n      placeholder: '搜索平台 / 账号 / 备注（不搜密码）',\n    },\n    {\n      type: 'row',\n      gap: 'sm',\n      children: [btn('＋ 新建平台', 'secrets.new-platform', { variant: 'default' })],\n    },\n    ...(message.text ? [textNode(message.text, 'caption', message.tone)] : []),\n    { type: 'divider' },\n    {\n      type: 'list',\n      items: tree.map(({ platform, accounts }) => ({\n        key: platform.id,\n        node: platformCard(platform, accounts),\n      })),\n      empty: q ? `没有匹配「${q}」的账号` : '还没有账号 —— 点「＋ 新建平台」开始',\n    },\n  ]\n  return { type: 'stack', gap: 'md', children }\n}\n\n/** 编辑视图（新建平台 / 改平台 / 新建账号 / 改账号） */\nfunction editView() {\n  const isAccount = editing?.kind === 'account'\n  const platform = findPlatform(db, editing?.platformId)\n  const editingExisting = isAccount ? Boolean(editing?.accountId) : Boolean(editing?.platformId)\n  const title = isAccount ? (editingExisting ? '编辑账号' : '新建账号') : editingExisting ? '编辑平台' : '新建平台'\n  const children = [\n    textNode(title, 'title'),\n    textNode(\n      isAccount\n        ? `平台：${platform?.name ?? '（未知）'}`\n        : '一个平台可以有多个账号（同一站点的小号、团队号）',\n      'caption',\n      'muted',\n    ),\n  ]\n\n  if (!isAccount) {\n    children.push({\n      type: 'field',\n      label: '平台名',\n      hint: '例如 GitHub / 银行 / 邮箱',\n      children: { type: 'input', bind: BINDS.name, placeholder: '平台名' },\n    })\n    children.push({\n      type: 'field',\n      label: '站点（可选）',\n      children: { type: 'input', bind: BINDS.site, placeholder: '例如 github.com' },\n    })\n  } else {\n    children.push({\n      type: 'field',\n      label: '账号',\n      children: { type: 'input', bind: BINDS.account, placeholder: '登录名 / 邮箱 / 手机号' },\n    })\n    children.push({\n      type: 'field',\n      label: '密码',\n      hint: '默认隐藏 · 保存后落在整库密文里',\n      children: {\n        type: 'row',\n        gap: 'sm',\n        children: [\n          { type: 'input', bind: BINDS.password, secret: true, placeholder: '密码' },\n          btn('生成', 'secrets.gen', { variant: 'ghost' }),\n        ],\n      },\n    })\n    children.push({\n      type: 'field',\n      label: '备注（可选）',\n      children: { type: 'textarea', bind: BINDS.note, rows: 3, placeholder: '例如：绑定手机、二级密码提示' },\n    })\n  }\n\n  children.push({\n    type: 'row',\n    gap: 'sm',\n    children: [\n      btn('保存', 'secrets.save', { variant: 'default' }),\n      btn('取消', 'secrets.cancel', { variant: 'ghost' }),\n    ],\n  })\n  if (message.text) children.push(textNode(message.text, 'caption', message.tone))\n  return { type: 'stack', gap: 'md', children }\n}\n\n/** 回收站里的一个账号条目 */\nfunction accountTrashItem({ platform, account, expiresAt }, now) {\n  return {\n    key: `a:${account.id}`,\n    node: {\n      type: 'row',\n      gap: 'sm',\n      align: 'center',\n      wrap: true,\n      children: [\n        textNode(`${platform.name} · ${account.account || '（未填账号）'}`),\n        { type: 'badge', text: `剩 ${daysLeft(expiresAt, now)} 天`, tone: 'muted' },\n        btn('恢复', 'secrets.restore', {\n          variant: 'ghost',\n          payload: { platformId: platform.id, accountId: account.id },\n        }),\n        btn('彻底删除', 'secrets.purge', {\n          variant: 'danger',\n          payload: { platformId: platform.id, accountId: account.id },\n          cssClass: 'sx-danger-ghost',\n        }),\n      ],\n    },\n  }\n}\n\n/** 回收站里的一个整平台条目（真人测试12 #2） */\nfunction platformTrashItem({ platform, expiresAt }, now) {\n  return {\n    key: `p:${platform.id}`,\n    node: {\n      type: 'row',\n      gap: 'sm',\n      align: 'center',\n      wrap: true,\n      children: [\n        textNode(`${platform.name} · ${(platform.accounts ?? []).length} 个账号`),\n        { type: 'badge', text: '平台', tone: 'warn' },\n        { type: 'badge', text: `剩 ${daysLeft(expiresAt, now)} 天`, tone: 'muted' },\n        btn('恢复', 'secrets.restore-platform', { variant: 'ghost', payload: { platformId: platform.id } }),\n        btn('彻底删除', 'secrets.purge-platform', { variant: 'danger', payload: { platformId: platform.id }, cssClass: 'sx-danger-ghost' }),\n      ],\n    },\n  }\n}\n\n/** 回收站视图 */\nfunction recycleView() {\n  const rows = trashList(db)\n  const now = nowMs()\n  return {\n    type: 'stack',\n    gap: 'md',\n    children: [\n      {\n        type: 'row',\n        gap: 'sm',\n        align: 'center',\n        children: [\n          textNode('🗑 回收站', 'title'),\n          { type: 'badge', text: `${rows.length} 项`, tone: rows.length ? 'warn' : 'muted' },\n          btn('返回', 'secrets.goto-list', { variant: 'ghost' }),\n        ],\n      },\n      textNode('删除的条目保留 7 天，到期自动清除。恢复或彻底删除都在这里。', 'caption', 'muted'),\n      {\n        type: 'list',\n        items: rows.map((row) => (row.kind === 'platform' ? platformTrashItem(row, now) : accountTrashItem(row, now))),\n        empty: '回收站是空的',\n      },\n      ...(message.text ? [textNode(message.text, 'caption', message.tone)] : []),\n    ],\n  }\n}\n\n/** 面板总入口 */\nfunction panelNode() {\n  if (!svc) return noServiceView()\n  if (!db) return lockedView()\n  if (mode === 'edit') return editView()\n  if (mode === 'recycle') return recycleView()\n  return listView()\n}\n\n/* ───────────────────────── 命令实现 ───────────────────────── */\n\n/** 打开某面板：冷启动时 `core.panel.*` 可能还没注册（doc-reader / tag-panel 同款重试） */\nasync function openCorePanel(api, panelId, fallbackTitle) {\n  for (let i = 0; i < 5; i++) {\n    try {\n      await api.command.execute(`core.panel.${panelId}`)\n      return\n    } catch {\n      await sleep(30)\n    }\n  }\n  api.host.notify(`打不开${fallbackTitle}（内核还没注册面板命令）`, 'warn')\n}\n\n/** 进编辑态：把当前值预填进输入框 */\nfunction enterEdit(api, next) {\n  editing = next\n  mode = 'edit'\n  setMessage('', 'muted')\n  if (next.kind === 'platform') {\n    const p = findPlatform(db, next.platformId)\n    api.view.setState(BINDS.name, p?.name ?? '')\n    api.view.setState(BINDS.site, p?.site ?? '')\n  } else {\n    const a = findAccount(db, next.platformId, next.accountId)\n    api.view.setState(BINDS.account, a?.account ?? '')\n    api.view.setState(BINDS.password, a?.password ?? '')\n    api.view.setState(BINDS.note, a?.note ?? '')\n  }\n  api.view.refresh(PANEL_ID)\n}\n\n/** 显示密码 + 15 秒自动收起 */\nfunction reveal(api, platformId, accountId) {\n  const acc = findAccount(db, platformId, accountId)\n  if (!acc) return\n  if (revealed.has(accountId)) {\n    revealed.delete(accountId)\n    const t = revealTimers.get(accountId)\n    if (t) clearTimeout(t)\n    revealTimers.delete(accountId)\n    api.view.refresh(PANEL_ID)\n    return\n  }\n  revealed.add(accountId)\n  const timer = setTimeout(() => {\n    revealed.delete(accountId)\n    revealTimers.delete(accountId)\n    api.view.refresh(PANEL_ID)\n  }, REVEAL_TTL_MS)\n  revealTimers.set(accountId, timer)\n  api.view.refresh(PANEL_ID)\n}\n\n/* ───────────────────────── 插件入口 ───────────────────────── */\n\nexport default {\n  async apply(api) {\n    /* ① 拿 crypto 服务（软依赖：拿不到就降级，不阻塞加载） */\n    svc = await api.service.consume('crypto')\n    adoptRing()\n    api.subscriptions.push(\n      api.event.on('service:available', (payload) => {\n        const name = payload && typeof payload === 'object' ? payload.name : null\n        if (name !== 'crypto' || svc) return\n        void api.service.consume('crypto').then(async (got) => {\n          if (!got) return\n          svc = got\n          adoptRing()\n          await checkRingReady(api)\n          await refreshBiometric()\n          api.view.refresh(PANEL_ID)\n        })\n      }),\n    )\n    await checkRingReady(api)\n    await refreshBiometric()\n\n    /* ② 面板 */\n    api.subscriptions.push(\n      api.view.registerPanel({\n        id: PANEL_ID,\n        title: '密码库',\n        location: 'main',\n        /**\n         * rev173.410：从 ＋ / 更多菜单点「打开 · 密码库」时先执行 `secrets.open`\n         * （它会弹解锁框、成功才进面板）；否则菜单入口会直接进面板、绕过解锁弹窗。\n         */\n        openCommand: 'secrets.open',\n        render: (ctx) => {\n          ui = { ...(ctx?.state ?? {}) }\n          adoptRing() // 打开面板时跟上最新分配（幂等）\n          return panelNode()\n        },\n      }),\n    )\n\n    /* ③ 空闲锁定：3 秒检查一次（时间戳判定，时间戳在后台也走） */\n    const idleTimer = setInterval(() => checkIdle(api), 3000)\n\n    /* 外部写入后的自动重查（rev173.393）：同步插件写 `.zn/security/vault.*.json`\n       不经过本插件，30 秒一次、只在前台（见 refreshRingIfChanged） */\n    const ringTimer = setInterval(() => {\n      try {\n        if (document.visibilityState !== 'visible') return\n      } catch {\n        /* 无 DOM（单测）：照常检查 */\n      }\n      void refreshRingIfChanged(api, 'timer')\n    }, RING_RECHECK_MS)\n    api.subscriptions.push({\n      dispose: () => {\n        clearInterval(idleTimer)\n        clearInterval(ringTimer)\n        if (clipTimer) clearTimeout(clipTimer)\n        for (const t of revealTimers.values()) clearTimeout(t)\n        revealTimers.clear()\n      },\n    })\n\n    /* ④ 切回前台时补判两件事：空闲锁 / 剪贴板到点没清（后台定时器被冻结） */\n    const onVisible = () => {\n      if (document.visibilityState !== 'visible') return\n      checkIdle(api)\n      void refreshRingIfChanged(api, 'focus')\n      if (clip.value && nowMs() >= clip.deadline) void settleClipboard()\n    }\n    document.addEventListener('visibilitychange', onVisible)\n    api.subscriptions.push({\n      dispose: () => document.removeEventListener('visibilitychange', onVisible),\n    })\n\n    /* ⑤ 命令 */\n    const commands = [\n      {\n        id: 'secrets.open',\n        title: '密码库：打开',\n        run: async () => {\n          // 打开前先看一眼磁盘（rev173.393）：同步可能刚把 vault 拉下来\n          await refreshRingIfChanged(api, 'open')\n          /**\n           * rev173.408：未解锁 ⇒ 先弹**输入对话框**（与私密笔记同一套 `host.prompt` 样式），\n           * **解锁成功直接进密码库**（用户：「密码库解锁也用这个样式」「解锁后直接进密码库」）。\n           * · 已绑定指纹 ⇒ 先弹系统指纹；取消 / 失败回落到密码框。\n           * · 老应用没有 `host.prompt` ⇒ 直接开面板（面板里的锁定视图仍是兜底，不崩）。\n           */\n          if (!db && typeof api.host.prompt === 'function') {\n            await checkRingReady(api)\n            if (!ringReady) {\n              api.host.notify('「账号密码」密钥环还没建立 —— 先去安全插件建一个', 'warn')\n            } else {\n              await refreshBiometric()\n              if (biometric.available && biometric.bound && svc?.biometric) {\n                try {\n                  await svc.biometric.unlock(RING)\n                  await afterUnlocked(api)\n                  api.host.notify('密码库已解锁', 'info')\n                  await openCorePanel(api, PANEL_ID, '密码库面板')\n                  return\n                } catch (e) {\n                  const msg = String(e?.message ?? e)\n                  // 取消是正常操作；其它失败给一句提示再回落密码框\n                  if (!/cancel|取消/i.test(msg)) {\n                    api.host.notify(`指纹解锁失败：${msg}，请输主密码`, 'warn')\n                  }\n                }\n              }\n              const pw = await api.host.prompt({\n                title: '解锁密码库',\n                message:\n                  biometric.available && biometric.bound\n                    ? '指纹已取消 —— 也可以输入主密码'\n                    : '输入「账号密码」密钥环的主密码',\n                placeholder: '主密码',\n                secret: true,\n                okText: '解锁',\n              })\n              if (pw !== null) {\n                try {\n                  await unlockAndLoad(api, pw)\n                  api.host.notify('密码库已解锁', 'info')\n                } catch (e) {\n                  const msg = String(e?.message ?? e)\n                  api.host.notify(\n                    msg.includes('还没建立')\n                      ? '「账号密码」密钥环还没建立 —— 先去安全插件建一个'\n                      : /invalid tag|tag mismatch|bad tag/i.test(msg)\n                        ? '主密码不对'\n                        : `解锁失败：${msg}`,\n                    'error',\n                  )\n                }\n              }\n            }\n          }\n          await openCorePanel(api, PANEL_ID, '密码库面板')\n        },\n      },\n      {\n        id: 'secrets.open-plugins',\n        title: '密码库：打开插件管理',\n        run: () => api.command.execute('core.plugins').catch(() => api.host.notify('打不开插件管理', 'warn')),\n      },\n      {\n        id: 'secrets.open-security',\n        title: '密码库：打开安全插件',\n        run: () => api.command.execute('security.open').catch(() => api.host.notify('安全插件没装或没启用', 'warn')),\n      },\n      {\n        id: 'secrets.recheck',\n        title: '密码库：重新检查密钥环',\n        run: async () => {\n          await checkRingReady(api)\n          setMessage(ringReady ? '找到「账号密码」密钥环，可以输入主密码了' : '仍然没有找到「账号密码」密钥环', ringReady ? 'success' : 'warn')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.unlock',\n        title: '密码库：解锁',\n        run: async (payload) => {\n          if (busy) return\n          const pw = val(BINDS.pw) || String(payload?.value ?? '')\n          busy = RING\n          setMessage('', 'muted')\n          api.view.refresh(PANEL_ID)\n          await sleep(40) // 先让\"正在派生密钥…\"渲染出来，再跑 Argon2\n          try {\n            await unlockAndLoad(api, pw)\n            api.view.setState(BINDS.pw, '')\n            setMessage('已解锁', 'success')\n            await refreshBiometric()\n          } catch (e) {\n            const msg = String(e?.message ?? e)\n            if (msg.includes('还没建立')) {\n              ringReady = false\n              setMessage('「账号密码」密钥环还没建立 —— 先去安全插件建一个', 'warn')\n            } else if (/invalid tag|tag mismatch|bad tag/i.test(msg)) {\n              // AEAD 认证失败 = 主密码不对（不存 password verifier，见方案 §4）\n              setMessage('主密码不对', 'danger')\n            } else {\n              setMessage(`解锁失败：${msg}`, 'danger')\n            }\n          } finally {\n            busy = ''\n            api.view.refresh(PANEL_ID)\n          }\n        },\n      },\n      {\n        id: 'secrets.lock',\n        title: '密码库：立即锁定',\n        run: () => lockNow(api, 'manual'),\n      },\n      /**\n       * 指纹解锁（rev173.336 · 真人测试10 #1「密码库解锁界面无法调用指纹」）。\n       *\n       * 密码库自己不碰 DEK —— 由安全插件的 crypto 服务完成「指纹 → DEK → 解锁该环」，\n       * 成功之后本插件照旧走 `unlockAndLoad` 的解密链（服务侧已经 live，不用再输密码）。\n       */\n      {\n        id: 'secrets.biometric-unlock',\n        title: '密码库：用指纹解锁',\n        run: async () => {\n          if (busy) return\n          if (!svc?.biometric) return setMessage('当前安全插件版本不支持指纹解锁', 'warn')\n          busy = RING\n          setMessage('正在请求指纹…', 'muted')\n          api.view.refresh(PANEL_ID)\n          try {\n            await svc.biometric.unlock(RING)\n            await afterUnlocked(api)\n            setMessage('已用指纹解锁', 'success')\n          } catch (e) {\n            setMessage(`指纹解锁失败：${fingerprintErrorText(e)}`, 'danger')\n          } finally {\n            busy = ''\n            await refreshBiometric()\n            api.view.refresh(PANEL_ID)\n          }\n        },\n      },\n      {\n        id: 'secrets.biometric-bind',\n        title: '密码库：绑定本机指纹',\n        run: async () => {\n          if (!db) return setMessage('先解锁，再绑定指纹', 'warn')\n          if (!svc?.biometric) return setMessage('当前安全插件版本不支持指纹绑定', 'warn')\n          try {\n            await svc.biometric.bind(RING)\n            await refreshBiometric()\n            setMessage(biometric.bound ? '已绑定这台设备 —— 之后解锁可直接用指纹' : '绑定失败：没有写进密钥环', biometric.bound ? 'success' : 'danger')\n          } catch (e) {\n            setMessage(`绑定指纹失败：${fingerprintErrorText(e)}`, 'danger')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.biometric-unbind',\n        title: '密码库：解除本机指纹',\n        run: async () => {\n          if (!svc?.biometric) return setMessage('当前安全插件版本不支持指纹绑定', 'warn')\n          try {\n            await svc.biometric.unbind(RING)\n            await refreshBiometric()\n            setMessage('已解除这台设备的指纹绑定（主密码不受影响）', 'success')\n          } catch (e) {\n            setMessage(`解除指纹失败：${fingerprintErrorText(e)}`, 'danger')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.new-platform',\n        title: '密码库：新建平台',\n        run: () => enterEdit(api, { kind: 'platform', platformId: null, accountId: null }),\n      },\n      {\n        id: 'secrets.edit-platform',\n        title: '密码库：改平台信息',\n        run: (payload) => enterEdit(api, { kind: 'platform', platformId: String(payload?.platformId ?? ''), accountId: null }),\n      },\n      {\n        id: 'secrets.new-account',\n        title: '密码库：新建账号',\n        run: (payload) => {\n          const platformId = String(payload?.platformId ?? '')\n          if (!findPlatform(db, platformId)) return\n          enterEdit(api, { kind: 'account', platformId, accountId: null })\n        },\n      },\n      {\n        id: 'secrets.edit-account',\n        title: '密码库：编辑账号',\n        run: (payload) => {\n          const platformId = String(payload?.platformId ?? '')\n          const accountId = String(payload?.accountId ?? '')\n          if (!findAccount(db, platformId, accountId)) return\n          enterEdit(api, { kind: 'account', platformId, accountId })\n        },\n      },\n      {\n        id: 'secrets.gen',\n        title: '密码库：生成密码',\n        run: () => {\n          const pw = generatePassword(PASSWORD_LEN)\n          api.view.setState(BINDS.password, pw)\n          setMessage('已生成 16 位密码（大小写 + 数字，排除 0/O/1/l/I）', 'success')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.save',\n        title: '密码库：保存',\n        run: async () => {\n          if (!db || !editing) return\n          touch()\n          try {\n            if (editing.kind === 'platform') {\n              const name = val(BINDS.name).trim()\n              if (!name) {\n                setMessage('平台名不能为空', 'danger')\n                api.view.refresh(PANEL_ID)\n                return\n              }\n              const site = val(BINDS.site).trim()\n              if (editing.platformId) {\n                renamePlatform(db, editing.platformId, { name, site })\n              } else {\n                const p = addPlatform(db, { name, site })\n                expanded.add(p.id)\n              }\n            } else {\n              const account = val(BINDS.account).trim()\n              const password = val(BINDS.password)\n              const note = val(BINDS.note)\n              if (!account) {\n                setMessage('账号不能为空', 'danger')\n                api.view.refresh(PANEL_ID)\n                return\n              }\n              if (!password) {\n                setMessage('密码不能为空（点「生成」可自动填一个）', 'danger')\n                api.view.refresh(PANEL_ID)\n                return\n              }\n              if (editing.accountId) {\n                updateAccount(db, editing.platformId, editing.accountId, { account, password, note })\n              } else {\n                addAccount(db, editing.platformId, { account, password, note })\n              }\n              expanded.add(editing.platformId)\n            }\n            await saveDb(api)\n            mode = 'list'\n            editing = null\n            setMessage('已保存', 'success')\n          } catch (e) {\n            setMessage(`保存失败：${String(e?.message ?? e)}`, 'danger')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.cancel',\n        title: '密码库：取消编辑',\n        run: () => {\n          editing = null\n          mode = 'list'\n          setMessage('', 'muted')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.toggle',\n        title: '密码库：展开/收起平台',\n        run: (payload) => {\n          const id = String(payload?.platformId ?? '')\n          if (!id) return\n          if (expanded.has(id)) expanded.delete(id)\n          else expanded.add(id)\n          touch()\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.toggle-account',\n        title: '密码库：展开/收起账号',\n        run: (payload) => {\n          const id = String(payload?.accountId ?? '')\n          if (!id) return\n          if (expandedAccounts.has(id)) expandedAccounts.delete(id)\n          else expandedAccounts.add(id)\n          touch()\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      /**\n       * 「按住 👁 显示密码」（真人测试12 #3）。\n       *\n       * 按下：加进 revealed；松开：移除。**不设 15 秒定时器** —— 松手就该立刻不可见，\n       * 定时器反而会让密码在松手后继续留在屏幕上（旧「显示/隐藏」按钮的行为）。\n       * 旧的 15 秒路径 `secrets.reveal` 保留，给还没升级的调用方兜底。\n       */\n      {\n        id: 'secrets.reveal-hold',\n        title: '密码库：按住显示密码（按下）',\n        run: (payload) => {\n          const accountId = String(payload?.accountId ?? '')\n          if (!accountId) return\n          revealed.add(accountId)\n          touch()\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.reveal-release',\n        title: '密码库：按住显示密码（松开）',\n        run: (payload) => {\n          const accountId = String(payload?.accountId ?? '')\n          if (!accountId) return\n          revealed.delete(accountId)\n          touch()\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        /* 按住按钮的 onClick 占位：按下/松开已经把动作做完了，点一下不该再触发别的 */\n        id: 'secrets.noop',\n        title: '密码库：空操作',\n        run: () => {},\n      },\n      {\n        id: 'secrets.copy-note',\n        title: '密码库：复制备注',\n        run: async (payload) => {\n          const acc = findAccount(db, String(payload?.platformId ?? ''), String(payload?.accountId ?? ''))\n          if (!acc) return\n          touch()\n          const ok = await clipboardWrite(acc.note)\n          setMessage(ok ? '已复制备注' : '写剪贴板失败（内容没有复制）', ok ? 'success' : 'danger')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.reveal',\n        title: '密码库：显示/隐藏密码',\n        run: (payload) => {\n          touch()\n          reveal(api, String(payload?.platformId ?? ''), String(payload?.accountId ?? ''))\n        },\n      },\n      {\n        id: 'secrets.copy',\n        title: '密码库：复制密码',\n        run: async (payload) => {\n          const acc = findAccount(db, String(payload?.platformId ?? ''), String(payload?.accountId ?? ''))\n          if (!acc) return\n          touch()\n          const ok = await clipboardWrite(acc.password)\n          if (!ok) {\n            setMessage('写剪贴板失败（内容没有复制）', 'danger')\n          } else {\n            copySecret(acc.password)\n            setMessage('已复制 —— 60 秒后自动清空剪贴板', 'success')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.del-account',\n        title: '密码库：删除账号',\n        run: async (payload) => {\n          const platformId = String(payload?.platformId ?? '')\n          const accountId = String(payload?.accountId ?? '')\n          if (!findAccount(db, platformId, accountId)) return\n          if (trashAccount(db, platformId, accountId)) {\n            await saveDb(api)\n            setMessage('已移入回收站（保留 7 天）', 'success')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      /* ── 平台整体删除（真人测试12 #2）：点「删除」→ 卡片转确认态 → 确认后才进回收站 ── */\n      {\n        id: 'secrets.ask-del-platform',\n        title: '密码库：删除平台（等二次确认）',\n        run: (payload) => {\n          const platformId = String(payload?.platformId ?? '')\n          if (!findPlatform(db, platformId)) return\n          confirmDelete = { kind: 'platform', platformId }\n          setMessage('', 'muted')\n          touch()\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.cancel-del-platform',\n        title: '密码库：取消删除平台',\n        run: () => {\n          confirmDelete = null\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.del-platform',\n        title: '密码库：确认删除平台',\n        run: async (payload) => {\n          const platformId = String(payload?.platformId ?? '')\n          confirmDelete = null\n          if (trashPlatform(db, platformId)) {\n            await saveDb(api)\n            setMessage('平台已移入回收站（连同账号，保留 7 天）', 'success')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.goto-recycle',\n        title: '密码库：回收站',\n        run: () => {\n          if (purgeExpired(db)) void saveDb(api)\n          mode = 'recycle'\n          setMessage('', 'muted')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.goto-list',\n        title: '密码库：返回列表',\n        run: () => {\n          mode = 'list'\n          setMessage('', 'muted')\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.restore',\n        title: '密码库：恢复账号',\n        run: async (payload) => {\n          const ok = restoreAccount(db, String(payload?.platformId ?? ''), String(payload?.accountId ?? ''))\n          if (ok) {\n            await saveDb(api)\n            setMessage('已恢复', 'success')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.purge',\n        title: '密码库：彻底删除',\n        run: async (payload) => {\n          const ok = purgeAccount(db, String(payload?.platformId ?? ''), String(payload?.accountId ?? ''))\n          if (ok) {\n            await saveDb(api)\n            setMessage('已彻底删除（不可撤销）', 'warn')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.restore-platform',\n        title: '密码库：恢复平台',\n        run: async (payload) => {\n          if (restorePlatform(db, String(payload?.platformId ?? ''))) {\n            await saveDb(api)\n            setMessage('平台已恢复', 'success')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n      {\n        id: 'secrets.purge-platform',\n        title: '密码库：彻底删除平台',\n        run: async (payload) => {\n          if (purgePlatform(db, String(payload?.platformId ?? ''))) {\n            await saveDb(api)\n            setMessage('平台已彻底删除（不可撤销）', 'warn')\n          }\n          api.view.refresh(PANEL_ID)\n        },\n      },\n    ]\n    for (const cmd of commands) api.subscriptions.push(api.command.register(cmd))\n\n    api.host.log(\n      'info',\n      `[secrets] 已加载：crypto 服务${svc ? '可用' : '不可用'} · 密钥环${ringReady ? '已建立' : '未建立'} · ${\n        db ? '已解锁' : '锁定'\n      }`,\n    )\n  },\n}\n",
    "styles.css": "/*\n * 密码库（secrets）卡片布局 —— 真人测试12 #3\n *\n * 只做**结构视觉**（边框 / 圆角 / 间距）；颜色一律走宿主主题令牌，\n * 暗色主题与换肤自动跟随，不写死颜色。\n * 类名统一 `sx-` 前缀，避免和别的插件的 `.zn-ui-*` 撞车。\n */\n\n.sx-card {\n  border: 1px solid var(--zn-border);\n  border-radius: var(--zn-radius-lg);\n  padding: var(--zn-space-3);\n}\n\n/* 展开 / 收起箭头（▾ / ▸）：几何符号在 12px 下显得很小，\n   单独放大到与「复制 / 修改 / 删除」视觉等高（真人测试12 复看）。 */\n.zn-btn.sx-caret {\n  font-size: var(--zn-text-lg);\n  line-height: 1;\n  padding: 3px 7px;\n}\n\n/* 删除按钮：去掉红色描边，只留红字（真人测试12 复看：「删除的红色外边框去掉」）。\n   特异性压过宿主的 .zn-ui-btn-danger，且只影响本插件。 */\n.zn-btn.sx-danger-ghost {\n  border-color: transparent;\n  background: transparent;\n  color: var(--zn-danger);\n}\n\n.zn-btn.sx-danger-ghost:hover {\n  border-color: transparent;\n  background: var(--zn-bg-hover);\n  color: var(--zn-danger);\n}\n\n/* 卡片标题行：文字靠左、操作按钮靠右 */\n.sx-row-between {\n  width: 100%;\n  justify-content: space-between;\n}\n\n/*\n * 平台卡标题行（2026-11-05 用户要求「手机：按钮跟平台名称放一行」）：\n * 外层不换行 —— 左侧信息块可内部折行并吃掉剩余宽度，右侧按钮组保持单行。\n * `min-width: 0` 是让过长的平台名 / 站点能收缩，而不是把按钮挤出容器。\n */\n.sx-platform-head-row {\n  flex-wrap: nowrap;\n}\n\n.sx-platform-head {\n  flex: 1 1 auto;\n  min-width: 0;\n}\n\n.sx-platform-actions {\n  flex: 0 0 auto;\n  flex-wrap: nowrap;\n}\n\n/* 窄屏（手机）：四个按钮与标题同行，收紧内边距 + 字号，避免把标题压成一条缝 */\n@media (max-width: 480px) {\n  .sx-platform-actions {\n    gap: var(--zn-space-1);\n  }\n  .sx-platform-actions .zn-btn {\n    padding-left: var(--zn-space-2);\n    padding-right: var(--zn-space-2);\n    font-size: var(--zn-text-sm);\n  }\n  .sx-platform-head {\n    row-gap: var(--zn-space-1);\n  }\n}\n\n/* 平台 = 大卡片 */\n.sx-platform-card {\n  background: var(--zn-bg-subtle);\n  margin-bottom: var(--zn-space-2);\n}\n\n/* 账号 = 大卡片里的小卡片 */\n.sx-account-card {\n  background: var(--zn-bg);\n  border-radius: var(--zn-radius);\n  margin-top: var(--zn-space-2);\n  padding: var(--zn-space-2) var(--zn-space-3);\n}\n\n/* 账号展开后的密码 / 备注区 */\n.sx-account-detail {\n  border-top: 1px dashed var(--zn-border);\n  padding-top: var(--zn-space-2);\n}\n\n/*\n * 「按住 👁 显示密码」按钮。\n * touch-action: none —— 手指按住时不要被列表滚动抢走手势；\n * user-select/touch-callout —— 不要顺带选中文字或弹系统长按菜单。\n */\n.sx-hold {\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  -webkit-touch-callout: none;\n}\n\n/* 平台删除的二次确认条 */\n.sx-confirm {\n  border: 1px solid var(--zn-warn);\n  border-radius: var(--zn-radius);\n  background: var(--zn-bg);\n  padding: var(--zn-space-2);\n}\n",
    "signature.json": "{\n  \"alg\": \"ed25519\",\n  \"keyId\": \"aqua-2026\",\n  \"sig\": \"/5i9XddD81lF89wy/eWnyOV6vj6wZkpBl4n6xjboKghBbEi1GqUL1fRKERusJpSM/FpIlmx8i9xp4WX8xlo1Bw==\"\n}\n"
  }
}
