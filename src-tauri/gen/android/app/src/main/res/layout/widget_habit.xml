<?xml version="1.0" encoding="utf-8"?>
<!--
  「今日打卡」桌面组件（rev173.242 · 需求 §15.2）

  固定 5 行（一行一个计划）：需求只要求「今日需要打卡的计划列表」，
  没有给条数档位。计划多于 5 个时组件显示前 5 个（面板里能看到全部）。

  每行的「✓ / 数字」由内核算好的快照给（`plans[].done/target`），
  组件不自己判「今天该不该打」—— 那套 isDueDay 逻辑只在 JS 里有一份。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_habit_title"
        android:textColor="@color/widget_text_faint"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_habit_row_1"
        style="@style/Widget.Rn.Row" />

    <TextView
        android:id="@+id/widget_habit_row_2"
        style="@style/Widget.Rn.Row" />

    <TextView
        android:id="@+id/widget_habit_row_3"
        style="@style/Widget.Rn.Row" />

    <TextView
        android:id="@+id/widget_habit_row_4"
        style="@style/Widget.Rn.Row" />

    <TextView
        android:id="@+id/widget_habit_row_5"
        style="@style/Widget.Rn.Row" />

    <TextView
        android:id="@+id/widget_habit_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_habit_empty"
        android:textColor="@color/widget_text_faint"
        android:textSize="12sp" />

</LinearLayout>
