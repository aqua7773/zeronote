<?xml version="1.0" encoding="utf-8"?>
<!--
  「今日打卡」组件元数据（rev173.242 · 需求 §15.2）

  `minHeight=180dp` ⇒ 5 行（标题 24 + 5×28 = 164）。比这矮时行会被截掉一半 ——
  所以 `minHeight` 不往下缩：要更小就少加计划，而不是把组件拉成一条缝。
  `updatePeriodMillis=0`：计划列表只在「应打卡日」变化时需要重算，而那是
  内核写快照时的事（拉一次桌面 / 打开一次 App 就会刷新）。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_habit"
    android:label="@string/widget_habit_title"
    android:minHeight="180dp"
    android:minWidth="150dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_habit"
    android:resizeMode="horizontal"
    android:targetCellHeight="3"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
