{
  "znp": 1,
  "manifest": {
    "manifestVersion": 1,
    "id": "sync",
    "name": "同步",
    "version": "0.1.0",
    "apiVersion": "^0.2.0",
    "entry": "index.cjs",
    "files": [
      "lib/core.cjs",
      "lib/backends/webdav.cjs",
      "lib/backends/folder.cjs",
      "lib/backends/s3.cjs",
      "lib/backends/git.cjs"
    ],
    "platforms": [
      "desktop",
      "android"
    ],
    "description": "多后端同步：一个引擎，后端可换（WebDAV 已落地，S3 / Git / 本地文件夹陆续并入）；冲突在面板里直接处理",
    "category": "tool",
    "capabilities": [
      "fs:read",
      "fs:write",
      "doc:read",
      "store",
      "event",
      "command",
      "view:main",
      "host",
      "net"
    ],
    "activationEvents": [
      "onStartup"
    ],
    "contributes": {
      "commands": [
        {
          "id": "sync.open",
          "title": "同步：打开设置与状态"
        },
        {
          "id": "sync.test",
          "title": "同步：测试连接"
        },
        {
          "id": "sync.run",
          "title": "同步：立即同步一次"
        },
        {
          "id": "sync.toggle-auto",
          "title": "同步：开关自动同步（前台每 5 秒）"
        },
        {
          "id": "sync.set-attachments",
          "title": "同步：设置附件同步方式（不同步 / 中转 / 永久）"
        },
        {
          "id": "sync.save",
          "title": "同步：保存设置"
        },
        {
          "id": "sync.open-conflict",
          "title": "同步：打开冲突副本"
        },
        {
          "id": "sync.resolve-conflict",
          "title": "同步：处理一条冲突（保留本机版 / 远端版）"
        },
        {
          "id": "sync.disconnect",
          "title": "同步：断开并清除凭据"
        }
      ],
      "panels": [
        {
          "id": "sync.status",
          "title": "同步",
          "location": "main"
        }
      ]
    },
    "sha256": "4db02d9e04dfa54af67f859ab5b4bb5929194c90dd50332bba60d508f9822dd9"
  },
  "files": {
    "index.cjs": "/**\r\n * 同步（`sync`）—— 入口：引擎 + 面板 + 命令。\r\n *\r\n * 一个引擎，多个后端。纯函数与常量在 `lib/core.cjs`，具体协议在 `lib/backends/*.cjs`。\r\n * 多文件插件用 CommonJS（契约 §3.2）：宿主把 `manifest.files` 里的文件一起读进\r\n * 一个极简运行时，`require('./lib/core.cjs')` 因此可用 —— 这也是为什么本插件\r\n * 能有一份引擎而不是像旧四个插件那样各抄一份。\r\n */\r\nconst core = require('./lib/core.cjs')\r\nconst { createDavClient } = require('./lib/backends/webdav.cjs')\r\nconst {\r\n  createS3Client,\r\n  createS3Storage,\r\n  amzDate,\r\n  amzDay,\r\n  canonicalHeaders,\r\n  canonicalQuery,\r\n  encodeRfc3986,\r\n  encodeS3Path,\r\n  hmacSha256,\r\n  parseListObjects,\r\n  sha256Hex,\r\n  signRequest,\r\n  toHex,\r\n} = require('./lib/backends/s3.cjs')\r\nconst {\r\n  createGitClient,\r\n  createGitStorage,\r\n  PROVIDERS,\r\n  b64decode,\r\n  b64decodeBytes,\r\n  b64encode,\r\n  b64encodeBytes,\r\n  encodeGitPath,\r\n  parseContents,\r\n} = require('./lib/backends/git.cjs')\r\nconst { createFolderBackend } = require('./lib/backends/folder.cjs')\r\n/** 本地文件夹后端的基线（与 webdav/s3/git 的 `baseline.v1` 分开存：两种语义不能混用） */\r\nconst KEY_FOLDER_BASELINE = 'folder.baseline.v1'\r\n/** S3 Secret（Access Key ID 存设置，Secret 存系统凭据库） */\r\nconst SECRET_S3_KEY = 'sync.s3.secret'\r\n/** Git 令牌（同样只进系统凭据库） */\r\nconst SECRET_GIT_KEY = 'sync.git.token'\r\nconst {\r\n  PANEL_ID,\r\n  KEY_SETTINGS,\r\n  KEY_BASELINE,\r\n  KEY_CONFLICTS,\r\n  KEY_DEVICE,\r\n  KEY_TIMING,\r\n  SECRET_KEY,\r\n  CONFLICT_ROOT,\r\n  MAX_FILES_PER_RUN,\r\n  AUTO_MS,\r\n  BACKOFF_MS,\r\n  MAX_CONFLICTS,\r\n  MAX_TIMING,\r\n  SPARK,\r\n  PRIVATE_FILES,\r\n  PRIVATE_ROOT_FILES,\r\n  PRIVATE_DIRS,\r\n  decideTreeAction,\r\n  fingerprint,\r\n  decideSync,\r\n  tryAutoMerge,\r\n  conflictFileName,\r\n  normalizeManifest,\r\n  fingerprintBytes,\r\n  extOf,\r\n  dirOf,\r\n  isAttachment,\r\n  needsAttachmentPull,\r\n  fmtMs,\r\n  pushTiming,\r\n  timingSummary,\r\n  sparkline,\r\n  relayName,\r\n} = core\r\n/* ───────────────────────── 插件本体 ───────────────────────── */\r\n\r\nconst plugin = {\r\n  apply(api) {\r\n    const platform = api.host.platform === 'android' ? 'android' : 'windows'\r\n\r\n    /**\r\n     * 插件设置。\r\n     *\r\n     * `backend` 决定用哪个后端（同一时间只有一个生效 —— 两种后端会抢同一批文件）：\r\n     * · `webdav` —— 插件自己搬（WebDAV / S3 / Git 都是这一类）\r\n     * · `folder` —— 不搬文件，库放同步目录，外部工具搬\r\n     */\r\n    let settings = {\r\n      backend: 'webdav',\r\n      baseUrl: '',\r\n      username: '',\r\n      root: '',\r\n      enabled: false,\r\n      auto: true,\r\n      attachments: 'off',\r\n      /* ── S3（rev173.287 并入）：Secret 不在这里，走系统凭据库 ── */\r\n      endpoint: '',\r\n      region: 'us-east-1',\r\n      bucket: '',\r\n      accessKey: '',\r\n      prefix: '',\r\n      /* ── Git（rev173.288 并入）：令牌也不在这里 ── */\r\n      provider: 'github',\r\n      apiBase: '',\r\n      owner: '',\r\n      repo: '',\r\n      branch: 'main',\r\n      /** Git 的对象前缀（与 S3 的 `prefix` 分开：两个后端可以各自配不同的子目录） */\r\n      repoPrefix: '',\r\n    }\r\n    let baseline = {}\r\n    /**\r\n     * 上一轮远端 manifest 的缓存（rev173.111 · 304 短路径）。\r\n     * `{ files, attachments, etag }`；etag 为空 = 远端没给 ETag ⇒ 下一轮照旧全量拉。\r\n     */\r\n    let manifestCache = null\r\n    /**\r\n     * 本地附件指纹缓存（rev173.117）：`path → { mtime, size, fp }`。\r\n     * 5 秒一轮的自动同步靠它跳过没变过的附件（见 `syncAttachments.localFpOf`）。\r\n     */\r\n    const attFpCache = new Map()\r\n    /**\r\n     * 远端附件的 ETag 缓存（rev173.117）：`远端路径 → etag`。\r\n     * 下载时带 `If-None-Match`，远端没变就 304（省一次完整传输）。\r\n     */\r\n    const attEtag = new Map()\r\n    /**\r\n     * relay ack 检查的轮转游标（rev173.284）：每轮只查一个条目。\r\n     * 每个条目一次 PROPFIND，条目多时（11 张图）全查会把坚果云 600 次/30 分钟打满。\r\n     */\r\n    let ackCursor = 0\r\n    /**\r\n     * 最近若干次同步的耗时（rev173.119）：`{ at, total, manifest, notes, attachments }[]`。\r\n     * 落 store，重启后趋势还在（面板画 sparkline + 平均 / 最慢）。\r\n     */\r\n    let timingHistory = []\r\n    let conflicts = []\r\n    /**\r\n     * 进程内已确认存在「同步点」的路径（rev173.115）。\r\n     * 只放内存：丢了只是下一轮多写一次 base，不影响正确性。\r\n     */\r\n    const baseMarked = new Set()\r\n    let ready = false\r\n    let busy = false\r\n    /** 上一次同步的摘要（面板展示） */\r\n    let lastResult = null\r\n    let formError = null\r\n    /**\r\n     * 表单的镜像值。\r\n     *\r\n     * 宿主的 `input.bind` 只把用户输入写进 **`ViewCtx.state`**，而 `command.run` **拿不到 ctx**\r\n     * ⇒ render 时把 state 抄一份到这里，命令读这份（与 habit 的 `draftView` 同一个做法）。\r\n     */\r\n    let form = {\r\n      baseUrl: '',\r\n      username: '',\r\n      password: '',\r\n      root: '',\r\n      /* ── S3（rev173.287）：与 WebDAV 的表单字段并存，按后端读写 ── */\r\n      endpoint: '',\r\n      region: '',\r\n      bucket: '',\r\n      accessKey: '',\r\n      secret: '',\r\n      prefix: '',\r\n      /* ── Git（rev173.288）── */\r\n      provider: '',\r\n      apiBase: '',\r\n      owner: '',\r\n      repo: '',\r\n      branch: '',\r\n      gitPrefix: '',\r\n      token: '',\r\n    }\r\n\r\n    const markDirty = () => {\r\n      void api.store\r\n        .set(KEY_SETTINGS, settings)\r\n        .catch((e) => api.host.log('warn', `同步设置写入失败：${String(e)}`))\r\n    }\r\n\r\n    const savedPasswords = new Map()\r\n    /** S3 Secret（Access Key ID 存设置，Secret 存系统凭据库 —— 与 WebDAV 密码同一套规矩） */\r\n    let savedS3Secret = null\r\n    /** Git 令牌（同上） */\r\n    let savedGitToken = null\r\n\r\n    async function password() {\r\n      if (savedPasswords.has('p')) return savedPasswords.get('p')\r\n      let p = ''\r\n      try {\r\n        p = (await api.host.secrets.get(SECRET_KEY)) ?? ''\r\n      } catch (e) {\r\n        api.host.log('warn', `读取凭据失败：${String(e)}`)\r\n      }\r\n      savedPasswords.set('p', p)\r\n      return p\r\n    }\r\n\r\n    /** 读 S3 Secret（只读一次，之后走缓存；写的时候同步更新缓存） */\r\n    async function s3Secret() {\r\n      if (savedS3Secret !== null) return savedS3Secret\r\n      try {\r\n        savedS3Secret = (await api.host.secrets.get(SECRET_S3_KEY)) ?? ''\r\n      } catch (e) {\r\n        api.host.log('warn', `读取 S3 密钥失败：${String(e)}`)\r\n        savedS3Secret = ''\r\n      }\r\n      return savedS3Secret\r\n    }\r\n\r\n    /** 读 Git 令牌（同上） */\r\n    async function gitToken() {\r\n      if (savedGitToken !== null) return savedGitToken\r\n      try {\r\n        savedGitToken = (await api.host.secrets.get(SECRET_GIT_KEY)) ?? ''\r\n      } catch (e) {\r\n        api.host.log('warn', `读取 Git 令牌失败：${String(e)}`)\r\n        savedGitToken = ''\r\n      }\r\n      return savedGitToken\r\n    }\r\n\r\n    /**\r\n     * 按当前后端造一个**存储客户端**（rev173.287）。\r\n     *\r\n     * 两个客户端的**方法名与返回形状完全一致**（`get` 返回文本、`readManifest` 返回\r\n     * `{files, attachments, private, privateTree, etag, notModified}` …），所以下面\r\n     * 那份几万字的同步引擎一行都不用改 —— 换后端只换这一处。\r\n     */\r\n    async function makeClient() {\r\n      if (settings.backend === 's3') {\r\n        return createS3Storage({ ...settings, secretKey: await s3Secret(), net: api.net })\r\n      }\r\n      if (settings.backend === 'git') {\r\n        return createGitStorage({\r\n          provider: settings.provider,\r\n          apiBase: settings.apiBase,\r\n          owner: settings.owner,\r\n          repo: settings.repo,\r\n          branch: settings.branch,\r\n          prefix: settings.repoPrefix,\r\n          token: await gitToken(),\r\n          net: api.net,\r\n        })\r\n      }\r\n      return createDavClient({ ...settings, password: await password(), net: api.net })\r\n    }\r\n\r\n    /** 当前后端配好了没有（folder 不需要任何远端配置） */\r\n    function hasConfig() {\r\n      if (settings.backend === 'folder') return true\r\n      if (settings.backend === 's3') return !!(settings.endpoint && settings.bucket)\r\n      if (settings.backend === 'git') return !!(settings.owner && settings.repo)\r\n      return !!settings.baseUrl\r\n    }\r\n\r\n    const conflictDir = `${CONFLICT_ROOT}/${platform}`\r\n    const takenNames = new Set()\r\n\r\n    /**\r\n     * 把本机那一版留成冲突副本（`.zn/conflicts/<平台>/<YYYY-MM-DD HHmm>-<名>.md`）。\r\n     *\r\n     * `localText` 由调用方给 —— **本地文件夹后端必须给**：那边磁盘已经被外部版覆盖，\r\n     * 本机版只剩 `.zn/sync/last/` 里的影子副本。不给时才读盘：WebDAV 后端正是在\r\n     * 「下载覆盖之前」调用，磁盘上那份就是本机版。\r\n     */\r\n    async function keepConflict(path, reason, { localText } = {}) {\r\n      let text = typeof localText === 'string' ? localText : null\r\n      if (text == null) {\r\n        try {\r\n          text = await api.fs.readText(path)\r\n        } catch {\r\n          text = null\r\n        }\r\n      }\r\n      let fileName = null\r\n      if (text != null) {\r\n        fileName = conflictFileName(path, Date.now(), (n) => takenNames.has(n))\r\n        /**\r\n         * 重启 / 另一进程同分钟再冲突（rev173.283）：`takenNames` 只活在本进程，\r\n         * 文件名精确到分钟 ⇒ 第二次会**覆盖**同一分钟内上一次的副本，现场就没了。\r\n         * 落盘前问一次磁盘，已存在就顺延 `-2` / `-3`。\r\n         */\r\n        if (typeof api.fs.exists === 'function') {\r\n          for (let guard = 0; guard < 50; guard += 1) {\r\n            const exists = await api.fs.exists(`${conflictDir}/${fileName}`).catch(() => false)\r\n            if (!exists) break\r\n            takenNames.add(fileName)\r\n            fileName = conflictFileName(path, Date.now(), (n) => takenNames.has(n))\r\n          }\r\n        }\r\n        takenNames.add(fileName)\r\n        try {\r\n          await api.fs.mkdir(conflictDir)\r\n          await api.fs.writeText(`${conflictDir}/${fileName}`, text)\r\n        } catch (e) {\r\n          api.host.log('warn', `冲突副本写入失败：${String(e)}`)\r\n          fileName = null\r\n        }\r\n      }\r\n      /**\r\n       * 同一篇只留**最新一条**（rev173.283 · 真人测试二 #2）。\r\n       *\r\n       * 真机现场：一个文件反复冲突时面板被同一篇刷满（截图里 8 条全是\r\n       * `新笔记-17-50-26.md`），用户根本不知道该处理哪一条。旧副本文件**不删**\r\n       * （还在 `.zn/conflicts/<平台>/` 下，手动能看），只是记录不再重复占位。\r\n       */\r\n      const dupIdx = conflicts.findIndex((c) => c.path === path && c.platform === platform)\r\n      if (dupIdx >= 0) conflicts.splice(dupIdx, 1)\r\n      conflicts.unshift({\r\n        path,\r\n        file: fileName,\r\n        platform,\r\n        at: Date.now(),\r\n        reason,\r\n        lost: text == null,\r\n      })\r\n      if (conflicts.length > MAX_CONFLICTS) conflicts.length = MAX_CONFLICTS\r\n      void api.store.set(KEY_CONFLICTS, conflicts).catch(() => {})\r\n      api.host.notify(\r\n        text == null ? `同步冲突：${path}（本机版未留存）` : `同步冲突：${path} → ${fileName}`,\r\n        'warn',\r\n      )\r\n      api.view.refresh()\r\n    }\r\n\r\n    /**\r\n     * 让 history 打一个**同步点**（rev173.115 三方合并的 base）。\r\n     *\r\n     * 时机：每次成功推 / 拉之后，两端内容一致 —— 这就是下次冲突时要用的「共同祖先」。\r\n     * 软依赖：history 被禁用 / 没装 ⇒ 静默跳过（合并退化成「留两份」，不丢数据）。\r\n     *\r\n     * `tag` 按后端分开：两个后端的基线语义不同，同步点不能混用（否则会拿 webdav 时代的\r\n     * 远端版本去当文件夹后端的共同祖先，合出来的东西没人认领）。\r\n     */\r\n    async function markBase(path, text, tag = 'sync:webdav') {\r\n      try {\r\n        const hist = await api.service.consume('history')\r\n        if (hist?.snapshot) await hist.snapshot(path, text, { tag })\r\n      } catch (e) {\r\n        api.host.log('debug', `同步点跳过 ${path}：${String(e)}`)\r\n      }\r\n    }\r\n\r\n    /** 基线当前该落在哪个 store 键上（两个后端各一份，互不覆盖） */\r\n    const baselineKey = () => (settings.backend === 'folder' ? KEY_FOLDER_BASELINE : KEY_BASELINE)\r\n\r\n    /** 把内存里的基线写盘（失败只记日志：下一轮同步会再对齐一次） */\r\n    async function persistBaseline() {\r\n      try {\r\n        await api.store.set(baselineKey(), baseline)\r\n      } catch (e) {\r\n        api.host.log('warn', `基线写入失败：${String(e)}`)\r\n      }\r\n    }\r\n\r\n    /**\r\n     * 本地文件夹后端（rev173.286 从 `examples/sync-folder` 并入）。\r\n     *\r\n     * 状态直通引擎：`baseline` / `conflicts` / `settings` 是同一份内存对象，面板和\r\n     * 冲突处理因此对两个后端天然一致；`pending` 只有这个后端有，它自己存。\r\n     */\r\n    const folder = createFolderBackend({\r\n      api,\r\n      platform,\r\n      state: {\r\n        get baseline() {\r\n          return baseline\r\n        },\r\n        set baseline(v) {\r\n          baseline = v\r\n        },\r\n        get conflicts() {\r\n          return conflicts\r\n        },\r\n        get settings() {\r\n          return settings\r\n        },\r\n      },\r\n      hooks: {\r\n        keepConflict,\r\n        markBase: (path, text) => markBase(path, text, 'sync:folder'),\r\n        refresh: () => api.view.refresh(),\r\n        persistBaseline,\r\n        persistSettings: () => markDirty(),\r\n      },\r\n    })\r\n\r\n    /**\r\n     * 冲突时的三方合并：base 取自 history 同步点，mine = 本机，theirs = 远端。\r\n     * 任何一环拿不到都返回 `null`（调用方走原「留两份」）。\r\n     */\r\n    async function autoMerge(client, path, localText) {\r\n      try {\r\n        const [hist, merger] = await Promise.all([\r\n          api.service.consume('history'),\r\n          api.service.consume('kernel.merge'),\r\n        ])\r\n        if (!hist?.findBase || !merger?.mergeLines) return null\r\n        const base = await hist.findBase(path, { tag: 'sync:webdav' })\r\n        if (typeof base !== 'string') return null\r\n        const theirs = await client.get(path)\r\n        if (theirs == null) return null\r\n        return tryAutoMerge({ base, mine: localText, theirs, mergeLines: merger.mergeLines })\r\n      } catch (e) {\r\n        api.host.log('warn', `自动合并失败（${path}）：${String(e)}`)\r\n        return null\r\n      }\r\n    }\r\n\r\n    /**\r\n     * 一次完整同步。返回摘要，不抛（错误转成 hint）。\r\n     *\r\n     * `silent`（自动轮询用）：不弹错误 toast、无变化时不刷面板 —— 否则每 5 秒一次重渲染，\r\n     * 用户正在面板里填东西时输入框会被刷掉。\r\n     */\r\n    async function runSync(reason = '手动', { silent = false } = {}) {\r\n      if (busy) return { skipped: true }\r\n      /**\r\n       * 本地文件夹后端的「立即同步一次」= **全库检查一次 + 结算 pending**。\r\n       *\r\n       * 它没有远端可往返 —— 搬运交给 Syncthing / OneDrive 之类，这里只做判定与留副本。\r\n       * 面板上按「检查」口径展示（更新 / 移除 / 冲突），不套 WebDAV 的下载 / 上传计数。\r\n       */\r\n      if (settings.backend === 'folder') {\r\n        const r = await folder.scan(reason)\r\n        folder.settle()\r\n        lastResult = {\r\n          pulled: 0,\r\n          pushed: 0,\r\n          merged: r.merged ?? 0,\r\n          conflicts: r.conflicts ?? 0,\r\n          updated: r.updated ?? 0,\r\n          removed: r.removed ?? 0,\r\n          backend: 'folder',\r\n          hint: r.skipped ? '正在检查中…' : '本地文件夹 · 已检查',\r\n          at: Date.now(),\r\n        }\r\n        return lastResult\r\n      }\r\n      if (!hasConfig()) {\r\n        return { error: settings.backend === 's3' ? '还没配置 S3 端点 / 桶名' : '还没配置 WebDAV 地址' }\r\n      }\r\n      busy = true\r\n      if (!silent) api.view.refresh()\r\n      const t0 = Date.now()\r\n      let tMark = t0\r\n      /**\r\n       * 各阶段耗时（rev173.117）：`{ manifest, notes, attachments, total }`。\r\n       *\r\n       * 为什么要这个：自动同步每 5 秒一轮，用户能感觉到\"卡\"的时候第一句一定是\r\n       * 「是不是同步拖的」—— 面板上直接给出哪个阶段慢，比猜快。\r\n       */\r\n      const timing = { manifest: 0, notes: 0, attachments: 0, private: 0, privateTree: 0 }\r\n      const lap = () => {\r\n        const now = Date.now()\r\n        const d = now - tMark\r\n        tMark = now\r\n        return d\r\n      }\r\n      const summary = {\r\n        pulled: 0,\r\n        pushed: 0,\r\n        merged: 0,\r\n        conflicts: 0,\r\n        removed: 0,\r\n        hint: '',\r\n        manifest304: false,\r\n      }\r\n      try {\r\n        const client = await makeClient()\r\n        /**\r\n         * manifest：有 etag 就带 `If-None-Match` 走 304 短路径（rev173.111）。\r\n         * 304 ⇒ 用上轮缓存的 files / attachments；200 ⇒ 刷新缓存。\r\n         */\r\n        let remote\r\n        if (manifestCache?.etag) {\r\n          const got = await client.readManifest(manifestCache.etag)\r\n          if (got.notModified) {\r\n            remote = {\r\n              files: manifestCache.files,\r\n              attachments: manifestCache.attachments,\r\n              private: manifestCache.private,\r\n              privateTree: manifestCache.privateTree,\r\n            }\r\n            summary.manifest304 = true\r\n          } else {\r\n            remote = {\r\n              files: got.files,\r\n              attachments: got.attachments,\r\n              private: got.private,\r\n              privateTree: got.privateTree,\r\n            }\r\n            manifestCache = {\r\n              files: got.files,\r\n              attachments: got.attachments,\r\n              private: got.private,\r\n              privateTree: got.privateTree,\r\n              etag: got.etag,\r\n            }\r\n          }\r\n        } else {\r\n          const got = await client.readManifest()\r\n          remote = { files: got.files, attachments: got.attachments, private: got.private }\r\n          manifestCache = {\r\n            files: got.files,\r\n            attachments: got.attachments,\r\n            private: got.private,\r\n            etag: got.etag,\r\n          }\r\n        }\r\n        timing.manifest = lap()\r\n        const notes = await api.fs.listNotes()\r\n        const localPaths = new Set()\r\n        const nextFiles = { ...remote.files }\r\n        /**\r\n         * manifest 需要回写（rev173.287）：`summary.pushed` 只统计「我们推上去的」，\r\n         * 但 412 分支会把**远端**最新版对齐进 `nextFiles` —— 那种情况也必须写回，\r\n         * 否则远端 manifest 一直指着旧指纹，下一轮还会撞 412。\r\n         */\r\n        let manifestDirty = false\r\n\r\n        let processed = 0\r\n        for (const n of notes) {\r\n          if (!/\\.md$/i.test(n.path)) continue\r\n          if (processed >= MAX_FILES_PER_RUN) break\r\n          processed += 1\r\n          localPaths.add(n.path)\r\n          let localText\r\n          try {\r\n            localText = await api.fs.readText(n.path)\r\n          } catch {\r\n            continue\r\n          }\r\n          const localFp = fingerprint(localText)\r\n          const base = baseline[n.path] ?? null\r\n          const remoteEntry = remote.files[n.path] ?? null\r\n          const verdict = decideSync({ base, localFp, remoteFp: remoteEntry?.fp ?? null })\r\n\r\n          if (verdict === 'noop') {\r\n            baseline[n.path] = { fp: localFp, etag: remoteEntry?.etag }\r\n            /**\r\n             * 首轮见到这篇时补一个同步点（rev173.115）：老用户升级后 base 是空的，\r\n             * 第一次真冲突会退化成「留两份」；这里顺手种一个，下一次就能三方合并。\r\n             * `baseMarked` 挡住\"每 5 秒一轮重写\"。\r\n             */\r\n            if (!baseMarked.has(n.path)) {\r\n              baseMarked.add(n.path)\r\n              await markBase(n.path, localText)\r\n            }\r\n            continue\r\n          }\r\n          if (verdict === 'pull' || verdict === 'pull-new') {\r\n            const text = await client.get(n.path)\r\n            if (text == null) continue\r\n            await api.fs.writeText(n.path, text)\r\n            const fp = fingerprint(text)\r\n            baseline[n.path] = { fp, etag: remoteEntry?.etag }\r\n            baseMarked.add(n.path)\r\n            await markBase(n.path, text)\r\n            summary.pulled += 1\r\n            continue\r\n          }\r\n          if (verdict === 'push' || verdict === 'push-new') {\r\n            const parent = n.path.includes('/') ? n.path.slice(0, n.path.lastIndexOf('/')) : ''\r\n            await client.mkdir(parent)\r\n            /**\r\n             * **S3 / Git 带乐观锁**（rev173.129 / rev173.123 并进统一引擎后保留）：\r\n             * manifest 里记了版本号就带上 —— 远端被「绕过 manifest」改过时服务端回\r\n             * 412（S3）或 409/422（Git），而不是让我们静默覆盖。WebDAV 不带（它的\r\n             * manifest 刷新本来就每轮做，加锁反而会在 5 秒节拍里制造假冲突）。\r\n             */\r\n            const ifMatch =\r\n              settings.backend === 's3' || settings.backend === 'git' ? baseline[n.path]?.etag : undefined\r\n            let res = await client.put(n.path, localText, ifMatch)\r\n            /**\r\n             * `404` = 父集合不存在。除了\"目录没建\"，**坚果云的根 `/dav/` 本身不可写**\r\n             * （只列得出 `我的坚果云/` 这类子目录）—— 同步目录留空就会撞上。\r\n             * 再建一次再试一次，仍失败就把话说清楚（不是笼统的\"上传失败\"）。\r\n             */\r\n            if (res.status === 404) {\r\n              await client.mkdir(settings.root || parent).catch(() => {})\r\n              res = await client.put(n.path, localText, undefined)\r\n            }\r\n            if (res.status === 412 || res.precondition) {\r\n              /**\r\n               * **乐观锁失败**：远端在我们读 manifest 之后变了（S3 412 / Git 409-422）。\r\n               *\r\n               * 三步，顺序不能变：\r\n               *   ① 先试三方合并（与 conflict 分支同一套判据）—— 合得上就用**远端最新 etag**\r\n               *      再推一次，两边改动都保住；\r\n               *   ② 合不上才留副本（本机版）+ 取远端最新版对齐；\r\n               *   ③ 无论哪条路，manifest 必须回写 —— 否则远端索引指着旧版本号，下一轮又撞。\r\n               *\r\n               * 旧行为只 `continue` 不取远端、不刷 manifest：本机停在旧版、基线指向旧 fp，\r\n               * 两轮之后两边都「以为自己是新的」—— 真人测试二 #1「两边都显示已同步、\r\n               * 内容却不一样」的成因之一。\r\n               */\r\n              let got = null\r\n              try {\r\n                got =\r\n                  typeof client.getWithEtag === 'function'\r\n                    ? await client.getWithEtag(n.path)\r\n                    : { text: await client.get(n.path), etag: undefined }\r\n              } catch (e) {\r\n                api.host.log('warn', `412 后读远端失败 ${n.path}：${String(e)}`)\r\n              }\r\n              const theirs = got?.text ?? null\r\n\r\n              if (theirs != null) {\r\n                const merged = await autoMerge(client, n.path, localText)\r\n                if (merged) {\r\n                  let wrote = false\r\n                  try {\r\n                    await api.fs.writeText(n.path, merged.text)\r\n                    wrote = true\r\n                  } catch (e) {\r\n                    api.host.log('warn', `合并结果落盘失败（${n.path}）：${String(e)}`)\r\n                  }\r\n                  if (wrote) {\r\n                    const res2 = await client.put(n.path, merged.text, got?.etag)\r\n                    if (res2.ok) {\r\n                      const fp = fingerprint(merged.text)\r\n                      baseline[n.path] = { fp, etag: res2.etag ?? undefined }\r\n                      nextFiles[n.path] = { fp, etag: res2.etag ?? undefined, at: Date.now() }\r\n                      manifestDirty = true\r\n                      baseMarked.add(n.path)\r\n                      await markBase(n.path, merged.text)\r\n                      summary.merged += 1\r\n                      continue\r\n                    }\r\n                  }\r\n                }\r\n                // 合不上 ⇒ 本机版留副本，磁盘对齐远端\r\n                await keepConflict(n.path, '远端在同步期间又变了')\r\n                summary.conflicts += 1\r\n                try {\r\n                  await api.fs.writeText(n.path, theirs)\r\n                  const fp = fingerprint(theirs)\r\n                  baseline[n.path] = { fp, etag: got?.etag }\r\n                  nextFiles[n.path] = { fp, etag: got?.etag, at: Date.now() }\r\n                  manifestDirty = true\r\n                  await markBase(n.path, theirs)\r\n                } catch (e) {\r\n                  api.host.log('warn', `412 后对齐远端失败 ${n.path}：${String(e)}`)\r\n                }\r\n              } else {\r\n                // 远端被删了：清基线，下一轮按 push-new 重新上传\r\n                delete baseline[n.path]\r\n                delete nextFiles[n.path]\r\n                manifestDirty = true\r\n              }\r\n              continue\r\n            }\r\n            if (!res.ok) {\r\n              throw new Error(\r\n                res.status === 404\r\n                  ? `上传失败（404）：${n.path} —— 远端父目录不存在；坚果云的 WebDAV 根不可直接写，请在「同步目录」里填一个子目录（如 ZeroNote）`\r\n                  : `上传失败（${res.status}）：${n.path}`,\r\n              )\r\n            }\r\n            baseline[n.path] = { fp: localFp, etag: res.etag ?? undefined }\r\n            nextFiles[n.path] = { fp: localFp, etag: res.etag ?? undefined, at: Date.now() }\r\n            baseMarked.add(n.path)\r\n            await markBase(n.path, localText)\r\n            summary.pushed += 1\r\n            continue\r\n          }\r\n          if (verdict === 'conflict') {\r\n            /**\r\n             * 先试**三方合并**（rev173.115）—— base 来自 history 的同步点。\r\n             * 合上了 ⇒ 本机写合并结果 + 推回远端 ⇒ 两端都是合并结果，这一轮不算冲突。\r\n             * 合不上（有真冲突段 / 没 base / 没 history）⇒ 原流程：本机版留副本、取远端版。\r\n             */\r\n            const merged = await autoMerge(client, n.path, localText)\r\n            if (merged) {\r\n              let wrote = false\r\n              try {\r\n                await api.fs.writeText(n.path, merged.text)\r\n                wrote = true\r\n              } catch (e) {\r\n                api.host.log('warn', `合并结果落盘失败（${n.path}）：${String(e)}`)\r\n              }\r\n              if (wrote) {\r\n                const res2 = await client.put(n.path, merged.text, remoteEntry?.etag)\r\n                if (res2.ok) {\r\n                  const fp = fingerprint(merged.text)\r\n                  baseline[n.path] = { fp, etag: res2.etag ?? undefined }\r\n                  nextFiles[n.path] = { fp, etag: res2.etag ?? undefined, at: Date.now() }\r\n                  baseMarked.add(n.path)\r\n                  await markBase(n.path, merged.text)\r\n                  summary.merged += 1\r\n                  api.host.notify(`已自动合并：${n.path}`, 'info')\r\n                  continue\r\n                }\r\n                /**\r\n                 * 推送失败（412 = 远端又变了 / 网络）：**本机保留合并结果**，别再用远端版\r\n                 * 盖掉它；base 不动，下一轮拿同一份 base 再合一次。\r\n                 */\r\n                summary.hint = `合并结果未能上传（${res2.status}）：${n.path}`\r\n              }\r\n              summary.conflicts += 1\r\n              continue\r\n            }\r\n            await keepConflict(n.path, '双端修改')\r\n            summary.conflicts += 1\r\n            // 取远端版（本机版已经进冲突目录）\r\n            const text = await client.get(n.path)\r\n            if (text != null) {\r\n              await api.fs.writeText(n.path, text)\r\n              const fp = fingerprint(text)\r\n              baseline[n.path] = { fp, etag: remoteEntry?.etag }\r\n              baseMarked.add(n.path)\r\n              await markBase(n.path, text)\r\n              summary.pulled += 1\r\n            }\r\n            continue\r\n          }\r\n          if (verdict === 'remote-deleted') {\r\n            delete baseline[n.path]\r\n            summary.removed += 1\r\n          }\r\n        }\r\n\r\n        // 本地没有、远端有的笔记 ⇒ 拉下来\r\n        for (const [path, entry] of Object.entries(remote.files)) {\r\n          if (localPaths.has(path)) continue\r\n          if (!/\\.md$/i.test(path)) continue\r\n          const text = await client.get(path)\r\n          if (text == null) continue\r\n          try {\r\n            await api.fs.writeText(path, text)\r\n          } catch (e) {\r\n            summary.hint = `写入失败 ${path}：${String(e)}`\r\n            continue\r\n          }\r\n          baseline[path] = { fp: fingerprint(text), etag: entry.etag }\r\n          baseMarked.add(path)\r\n          await markBase(path, text)\r\n          summary.pulled += 1\r\n        }\r\n\r\n        timing.notes = lap()\r\n\r\n        // 附件（在 .md 循环之后：`summary.pushed` 里也含附件计数）\r\n        const att = await syncAttachments(client, remote, summary)\r\n        timing.attachments = lap()\r\n\r\n        // 私有文件（密码库密文 + 密钥元数据，rev173.164 · 期 1c）\r\n        const priv = await syncPrivate(client, remote, summary)\r\n        timing.private = lap()\r\n\r\n        // 私密文件夹目录树（rev173.182 · 期 3）—— 数量可变，逐文件比对\r\n        const privTree = await syncPrivateTree(client, remote, summary)\r\n        timing.privateTree = lap()\r\n\r\n        // manifest 回写（本轮有 .md / 附件 / 私有文件变动才写 —— 5 秒一轮，没变化不该反复 PUT）\r\n        if (summary.pushed > 0 || manifestDirty || att.changed || priv.changed || privTree.changed) {\r\n          const w = await client.writeManifest({\r\n            files: nextFiles,\r\n            attachments: att.attachments,\r\n            private: priv.private,\r\n            privateTree: privTree.privateTree,\r\n          })\r\n          // 写盘后远端 etag 变了 ⇒ 缓存跟着换，下一轮照样能走 304\r\n          manifestCache = {\r\n            files: nextFiles,\r\n            attachments: att.attachments,\r\n            private: priv.private,\r\n            privateTree: privTree.privateTree,\r\n            etag: w?.etag ?? null,\r\n          }\r\n        }\r\n        await api.store.set(KEY_BASELINE, baseline)\r\n        summary.hint = summary.hint || `${reason}同步完成${summary.manifest304 ? '（manifest 304）' : ''}`\r\n        // 成功一轮 ⇒ 退避清零（限流是临时的，恢复后立刻回到 5 秒节拍）\r\n        backoffLevel = 0\r\n        backoffUntil = 0\r\n      } catch (e) {\r\n        summary.hint = `同步失败：${String(e)}`\r\n        const msg = String(e)\r\n        /**\r\n         * 两类失败分开处理（rev173.279 · 真人使用测试 #12）：\r\n         *\r\n         * · **认证错**（401 / 403）⇒ 立刻停自动同步。重试只会让封禁更久\r\n         *   （2026-10-24 实测：401 重试十几分钟后桌面 + 手机全被 503 挡了半小时）。\r\n         *   开关显示必须与**实际**一致：`stopAuto()` 只清定时器、不动 `settings.auto`，\r\n         *   不置 false 面板会一直显示「自动 · 前台每 5 秒」—— 用户以为还在同步（真机踩过）。\r\n         *\r\n         * · **限流 / 临时封禁**（429 / 503 / `BlockedTemporarily`）⇒ **指数退避，不永久停**。\r\n         *   旧行为是撞上就停、要用户手动重开；重开后又 5 秒一轮，很快再撞。\r\n         *   现在 15 s → 60 s → 300 s，任何一轮成功立刻复位回 5 s。\r\n         */\r\n        if (/401|403|unauthorized|forbidden/i.test(msg)) {\r\n          backoffLevel = 0\r\n          backoffUntil = 0\r\n          stopAuto()\r\n          if (settings.auto !== false) {\r\n            settings.auto = false\r\n            markDirty()\r\n          }\r\n          summary.hint += '（认证失败，已暂停自动同步；改好账号或密码后在面板上重新开启）'\r\n        } else if (/429|503|blocked|rate.?limit|too many/i.test(msg)) {\r\n          const wait = BACKOFF_MS[Math.min(backoffLevel, BACKOFF_MS.length - 1)]\r\n          backoffLevel = Math.min(backoffLevel + 1, BACKOFF_MS.length)\r\n          backoffUntil = Date.now() + wait\r\n          summary.backoffMs = wait\r\n          summary.hint += `（远端限流，已退避 ${Math.round(wait / 1000)} 秒 —— 成功一轮后自动恢复，不用手动开）`\r\n        }\r\n        if (!silent) api.host.notify(summary.hint, 'error')\r\n        else api.host.log('warn', summary.hint)\r\n      } finally {\r\n        busy = false\r\n        // 失败也记耗时（面板要能看出\"卡在哪个阶段\"）\r\n        summary.ms = { ...timing, total: Date.now() - t0 }\r\n        const changed = summary.pulled + summary.pushed + summary.merged + summary.conflicts + summary.removed > 0\r\n        /**\r\n         * 耗时历史（rev173.119）：只记**有变化**的轮次与手动同步。\r\n         * 静默的空转轮每 5 秒一条，50 条只够覆盖 4 分钟，而且全是\"没活干\"的噪声 ——\r\n         * 那样的趋势图看不出任何东西。\r\n         */\r\n        if (changed || !silent) {\r\n          timingHistory = pushTiming(timingHistory, { at: Date.now(), ...summary.ms })\r\n          void api.store.set(KEY_TIMING, timingHistory).catch((e) => api.host.log('warn', `耗时历史写入失败：${String(e)}`))\r\n        }\r\n        lastResult = { ...summary, at: Date.now() }\r\n        /**\r\n         * 自动轮询下「什么都没变」不刷面板（每 5 秒重渲染会把用户正在填的表单刷掉）；\r\n         * **退避那一轮例外** —— 用户必须看见「已退避到 N 秒」，否则面板还写着「自动 · 前台每 5 秒」。\r\n         */\r\n        if (!silent || changed || summary.backoffMs) api.view.refresh()\r\n      }\r\n      return summary\r\n    }\r\n\r\n    /* ── 附件同步（rev173.109 · 用户 2026-10-24 要的两种模式） ── */\r\n\r\n    /** 设备 id（中转 ack 用；每台设备一个，存 store） */\r\n    async function deviceId() {\r\n      let id = ''\r\n      try {\r\n        id = String((await api.store.get(KEY_DEVICE, '')) || '')\r\n      } catch {\r\n        /* 读不到就当没有 */\r\n      }\r\n      if (!id) {\r\n        id = Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4)\r\n        void api.store.set(KEY_DEVICE, id).catch(() => {})\r\n      }\r\n      return id\r\n    }\r\n\r\n    /**\r\n     * 附件同步。两种模式（用户 2026-10-24 拍板：「添加一个选项」）：\r\n     *\r\n     * · `full`  —— 附件与文档一样**永久**存在云端（占空间，但任何设备随时能取）\r\n     * · `relay` —— **同步中转**：只在上传方与下载方之间过一道，对端 ack 之后云端副本就删掉\r\n     *              （云端省空间；代价是第三台设备事后取不到这份）\r\n     *\r\n     * `relay` 的协议：\r\n     *   上传：`PUT _zn/relay/<fp><ext>`，`manifest.attachments[path] = { fp, ext, at }`\r\n     *   下载：`GET _zn/relay/<fp><ext>` 写本地 ⇒ `PUT _zn/relay-ack/<fp>`（内容 = 设备 id）\r\n     *   清理：任何一端看到 ack 就删 relay 文件，并在 manifest 里标 `cleaned: true`\r\n     *          —— **条目保留**：别的设备看到 cleaned 就知道「曾经有、别等了」，不会反复重试。\r\n     *\r\n     * @returns {{ attachments: Record<string, object>, changed: boolean }}\r\n     */\r\n    /**\r\n     * **私有文件同步**（rev173.164 · 期 1c）：密码库密文 + 密钥元数据。\r\n     *\r\n     * 为什么单独一段：这两个文件不是 `.md`、又在 `.zn/` 下，`listNotes` 永远看不到它们\r\n     * （附件段也刻意跳 `.zn/`）⇒ 以前密码库**同步不出去**，换设备就是空库。\r\n     *\r\n     * 两者都是**文本**（`secrets.zn` 是 `zn1.<nonce>.<ct>` 的 base64url；`vault.json` 是 JSON），\r\n     * 所以走文本接口，并且能直接复用 `keepConflict`（冲突时把本机版落 `.zn/conflicts/<平台>/`）。\r\n     *\r\n     * 方向判断与笔记同一套 `decideSync` 语义，但**没有三方合并**：\r\n     * 密文合并毫无意义（二进制/密文拼不起来），冲突就是「留两份 + 取远端」。\r\n     *\r\n     * 任何一步失败只写 hint，不抛 —— 密码库传不上去不该让整轮同步（含笔记）停摆。\r\n     *\r\n     * @returns {{ private: Record<string, object>, changed: boolean }}\r\n     */\r\n    async function syncPrivate(client, manifest, summary) {\r\n      const remotePriv = manifest.private || {}\r\n      const nextPriv = { ...remotePriv }\r\n      let changed = false\r\n\r\n      for (const rel of PRIVATE_FILES) {\r\n        /**\r\n         * 读本地：**不用 `fs.exists`**，直接读 + 把空串当\"没有\"。\r\n         * 两个理由：① 少一次 IPC（每 5 秒一轮）② 测试台的 memoryFs 没有 `exists`，\r\n         * 而\"文件不存在 ⇒ readText 抛\"与\"存在但空 ⇒ 返回 ''\"两种表现要收敛成同一个 null。\r\n         */\r\n        let localText = null\r\n        try {\r\n          const raw = await api.fs.readText(rel)\r\n          if (raw && raw.trim()) localText = raw\r\n        } catch {\r\n          localText = null\r\n        }\r\n        const localFp = localText == null ? null : fingerprint(localText)\r\n        const entry = remotePriv[rel] ?? null\r\n        const remoteFp = typeof entry?.fp === 'string' ? entry.fp : null\r\n        const base = baseline[rel]?.fp ?? null\r\n        const parent = rel.includes('/') ? rel.slice(0, rel.lastIndexOf('/')) : ''\r\n\r\n        // ① 两边一致 ⇒ 只刷新 baseline（`at` 用远端的，别每轮改 manifest）\r\n        if (localFp && remoteFp && localFp === remoteFp) {\r\n          baseline[rel] = { fp: localFp, at: entry?.at ?? 0 }\r\n          continue\r\n        }\r\n\r\n        const localChanged = localFp !== base\r\n        const remoteChanged = remoteFp !== base\r\n\r\n        /**\r\n         * ② 该拉：本地没有（新设备）· 或者**只有远端变了**。\r\n         *\r\n         * 第二条不能漏 —— 第一版只写了「本地没有」的拉，于是\"B 改了、A 同步\"\r\n         * 既不拉也不推（localChanged=false 让推送分支也不成立），A 永远停在旧版\r\n         * （单测 `B 改了密码库 ⇒ A 拉回新版` 抓到）。\r\n         */\r\n        if (remoteFp && (!localFp || (remoteChanged && !localChanged))) {\r\n          try {\r\n            const text = await client.get(rel)\r\n            if (text == null) continue\r\n            await client.mkdir(parent).catch(() => {})\r\n            await api.fs.mkdir(parent).catch(() => {})\r\n            await api.fs.writeText(rel, text)\r\n            baseline[rel] = { fp: fingerprint(text), at: entry?.at ?? 0 }\r\n            summary.pulled += 1\r\n          } catch (e) {\r\n            summary.hint = `私有文件下载失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        // ③ 只有本地变（或远端还没有）⇒ 推\r\n        if (localFp && (!remoteFp || (localChanged && !remoteChanged))) {\r\n          try {\r\n            await client.mkdir(parent).catch(() => {})\r\n            const res = await client.put(rel, localText)\r\n            if (![200, 201, 204, 207].includes(res.status)) {\r\n              summary.hint = `私有文件上传失败 ${rel}（${res.status}）`\r\n              continue\r\n            }\r\n            nextPriv[rel] = { fp: localFp, at: Date.now() }\r\n            baseline[rel] = { fp: localFp, at: nextPriv[rel].at }\r\n            summary.pushed += 1\r\n            changed = true\r\n          } catch (e) {\r\n            summary.hint = `私有文件上传失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        // ④ 两边都变 ⇒ 冲突：本机版留副本（keepConflict 自己读文本），再取远端版\r\n        if (localFp && remoteFp && localChanged && remoteChanged) {\r\n          try {\r\n            const text = await client.get(rel)\r\n            if (text == null) continue\r\n            await keepConflict(rel, '密码库双端修改')\r\n            await api.fs.writeText(rel, text)\r\n            baseline[rel] = { fp: fingerprint(text), at: entry?.at ?? 0 }\r\n            summary.conflicts += 1\r\n          } catch (e) {\r\n            summary.hint = `私有文件冲突处理失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        // ⑤ 只剩「本地没有 + 远端也没有」—— 正常态（用户还没建密码库），什么都不做\r\n      }\r\n      return { private: nextPriv, changed }\r\n    }\r\n\r\n    /**\r\n     * **私密文件夹目录树同步**（rev173.182 · 私密文件夹期 3）。\r\n     *\r\n     * 与 `syncPrivate` 的区别：那个是**固定清单**（密码库那几个文件），这里是**数量可变**的\r\n     * 目录树（每篇私密笔记一个 `.zn` 密文）。方向判定抽成纯函数 `decideTreeAction`\r\n     * （单测覆盖全部分支），这里只负责按判定执行。\r\n     *\r\n     * 与笔记同步唯一不同的语义：**删除两边都传播**。私密笔记在面板里删除是真删除，\r\n     * 不传播的话同步一轮就会\"复活\"。\r\n     */\r\n    async function syncPrivateTree(client, manifest, summary) {\r\n      const remoteTree = manifest.privateTree || {}\r\n      const nextTree = { ...remoteTree }\r\n      let changed = false\r\n\r\n      /**\r\n       * 本地有哪些（`listFiles` 返回**库内相对路径**，rev173.177 的教训）。\r\n       * `typeof` 兜底：单测里的 memory fs 是逐个方法手写的，没提供 `listFiles` 时按\"没有树\"\r\n       * 处理（等价于旧行为），而不是整轮同步崩掉。\r\n       */\r\n      const localPaths = new Set()\r\n      if (typeof api.fs.listFiles === 'function') {\r\n        for (const dir of PRIVATE_DIRS) {\r\n          const files = await api.fs.listFiles(dir).catch(() => [])\r\n          for (const rel of files) localPaths.add(rel)\r\n        }\r\n      }\r\n      // 根下的固定文件（`.zn/private/index.zn`）不在那两个目录里，单独补\r\n      for (const rel of PRIVATE_ROOT_FILES) {\r\n        // 空串按\"没有\"处理（与 `syncPrivate` 同一口径）\r\n        const raw = await api.fs.readText(rel).catch(() => null)\r\n        if (raw && raw.trim()) localPaths.add(rel)\r\n      }\r\n\r\n      // 要处理的路径 = 本地 ∪ 远端（任一存在）\r\n      const all = new Set([...localPaths, ...Object.keys(remoteTree)])\r\n\r\n      for (const rel of all) {\r\n        let localText = null\r\n        if (localPaths.has(rel)) {\r\n          try {\r\n            const raw = await api.fs.readText(rel)\r\n            if (raw != null) localText = raw\r\n          } catch {\r\n            localText = null\r\n          }\r\n        }\r\n        const localFp = localText == null ? null : fingerprint(localText)\r\n        const entry = remoteTree[rel] ?? null\r\n        const remoteFp = typeof entry?.fp === 'string' ? entry.fp : null\r\n        const base = baseline[rel]?.fp ?? null\r\n        const action = decideTreeAction(localFp, remoteFp, base)\r\n        const parent = rel.includes('/') ? rel.slice(0, rel.lastIndexOf('/')) : ''\r\n\r\n        if (action === 'noop') {\r\n          if (localFp && remoteFp) baseline[rel] = { fp: localFp, at: entry?.at ?? 0 }\r\n          continue\r\n        }\r\n\r\n        if (action === 'pull') {\r\n          try {\r\n            const text = await client.get(rel)\r\n            if (text == null) continue\r\n            await api.fs.mkdir(parent).catch(() => {})\r\n            await api.fs.writeText(rel, text)\r\n            baseline[rel] = { fp: fingerprint(text), at: entry?.at ?? 0 }\r\n            summary.pulled += 1\r\n          } catch (e) {\r\n            summary.hint = `私密笔记下载失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        if (action === 'push') {\r\n          try {\r\n            await client.mkdir(parent).catch(() => {})\r\n            const res = await client.put(rel, localText)\r\n            if (![200, 201, 204, 207].includes(res?.status ?? 201)) {\r\n              summary.hint = `私密笔记上传失败 ${rel}（${res?.status}）`\r\n              continue\r\n            }\r\n            nextTree[rel] = { fp: localFp, at: Date.now() }\r\n            baseline[rel] = { fp: localFp, at: nextTree[rel].at }\r\n            summary.pushed += 1\r\n            changed = true\r\n          } catch (e) {\r\n            summary.hint = `私密笔记上传失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        if (action === 'delete-remote') {\r\n          try {\r\n            await client.remove(rel)\r\n            delete nextTree[rel]\r\n            delete baseline[rel]\r\n            summary.pushed += 1\r\n            changed = true\r\n          } catch (e) {\r\n            summary.hint = `删除远端私密笔记失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        if (action === 'delete-local') {\r\n          try {\r\n            await api.fs.purgePrivate(rel).catch(() => {})\r\n            delete baseline[rel]\r\n            summary.removed = (summary.removed ?? 0) + 1\r\n          } catch (e) {\r\n            summary.hint = `删除本地私密笔记失败 ${rel}：${String(e)}`\r\n          }\r\n          continue\r\n        }\r\n\r\n        // conflict：密文无法合并 ⇒ 留本机副本 + 取远端\r\n        try {\r\n          const text = await client.get(rel)\r\n          if (text == null) continue\r\n          await keepConflict(rel, '私密笔记双端修改')\r\n          await api.fs.writeText(rel, text)\r\n          baseline[rel] = { fp: fingerprint(text), at: entry?.at ?? 0 }\r\n          summary.conflicts += 1\r\n        } catch (e) {\r\n          summary.hint = `私密笔记冲突处理失败 ${rel}：${String(e)}`\r\n        }\r\n      }\r\n\r\n      return { privateTree: nextTree, changed }\r\n    }\r\n\r\n    async function syncAttachments(client, manifest, summary) {\r\n      const mode = settings.attachments || 'off'\r\n      const remoteAtt = manifest.attachments || {}\r\n      if (mode === 'off') return { attachments: remoteAtt, changed: false }\r\n\r\n      const nextAtt = { ...remoteAtt }\r\n      const notes = await api.fs.listNotes()\r\n      const locals = notes.filter((n) => isAttachment(n.path))\r\n      const localByPath = new Map(locals.map((n) => [n.path, n]))\r\n      const me = await deviceId()\r\n      let changed = false\r\n\r\n      /**\r\n       * 本地附件的指纹：**`mtime` + `size` 没变就复用上次的结果**（rev173.117）。\r\n       *\r\n       * 自动同步每 5 秒一轮，附件多的时候每轮把所有图片重新读一遍 + 重算散列是纯浪费\r\n       * （100 张图 ≈ 每轮几百 MB 读盘）。`listNotes` 本来就带 `mtime` / `size`，\r\n       * 这两个都没变就没有理由再读内容。缓存只放内存，进程重启多读一次而已。\r\n       *\r\n       * 返回 `{ fp, bytes }`：`bytes` 只在**这次真读了盘**时才有值 —— 调用方直接拿它上传，\r\n       * 免得同一轮为了算指纹和为了上传各读一遍（字节不留在缓存里，图片可能很大）。\r\n       */\r\n      async function localFpOf(meta) {\r\n        const hit = attFpCache.get(meta.path)\r\n        if (hit && hit.mtime === meta.mtime && hit.size === meta.size) return { fp: hit.fp, bytes: null }\r\n        const bytes = await api.fs.readBytes(meta.path)\r\n        const fp = fingerprintBytes(bytes)\r\n        attFpCache.set(meta.path, { mtime: meta.mtime, size: meta.size, fp })\r\n        return { fp, bytes }\r\n      }\r\n\r\n      /**\r\n       * 本轮「算指纹时顺带读到的字节」。\r\n       *\r\n       * 先拉后推之后，同一份附件在一轮里要**看两次**（下载循环判方向 + 上传循环取内容）——\r\n       * 不复用的话，本地改过的那张图会被读两遍（100 张图就是两倍 IO）。\r\n       * 只在**这次真读了盘**时才有条目；下载覆盖本地后会删掉，避免拿旧字节又推回去。\r\n       */\r\n      const preloaded = new Map()\r\n\r\n      /**\r\n       * 本地 → 远端。**在拉取之后调用**（rev173.126）：顺序反了会先拿本机旧版盖掉远端新版，\r\n       * 两台设备互相覆盖、谁后同步谁赢，另一台永远拿不到新版。\r\n       */\r\n      async function pushLocal() {\r\n      // ① 本地 → 远端\r\n      for (const n of locals) {\r\n        const entry = nextAtt[n.path]\r\n        let fp = ''\r\n        let bytes = null\r\n        try {\r\n          const got = await localFpOf(n)\r\n          fp = got.fp\r\n          bytes = got.bytes ?? preloaded.get(n.path) ?? null\r\n        } catch {\r\n          continue // 读不到就下一轮\r\n        }\r\n        /**\r\n         * 远端已有**同一份内容**就跳过（rev173.284 修「relay 每轮重传」）。\r\n         *\r\n         * 旧写法把 `cleaned` 排除在跳过条件外 —— 本意是「从 relay 切到 full 要补传一份」，\r\n         * 但中转模式清理完的条目**本来就是 cleaned** ⇒ 每轮都重新上传同一批图：\r\n         * 上传 → 下一轮 ack 到了就清理 → 再下一轮又上传 …… 11 张图 ≈ 3.5 MB/轮，\r\n         * 5 秒节拍被拖成 26 秒一轮，请求数直接打满坚果云 600 次/30 分钟（真人测试二 503）。\r\n         *\r\n         * 现在的判据：\r\n         * · fp 相同 ⇒ 这份内容已经同步过了，跳过（relay 副本在不在由下面「ack 清理」那段管）；\r\n         * · **唯一例外**：当前是 `full`、而条目还停在 relay（云端只有中转区那份、而且可能已清理）\r\n         *   ⇒ 补传一次到正式路径（这就是 rev173.109 要修的那个场景，换成更精确的条件）。\r\n         */\r\n        if (entry && entry.fp === fp && !(mode === 'full' && entry.mode !== 'full')) continue\r\n        // 内容不同、且本地不比远端新 ⇒ 远端那份更新，等下载，不要拿旧版覆盖\r\n        if (entry && entry.fp !== fp && Number(n.mtime ?? 0) <= Number(entry.at ?? 0)) continue\r\n        // 指纹缓存命中时上一行没读过字节 ⇒ 上传前补读一次\r\n        if (!bytes) {\r\n          try {\r\n            bytes = await api.fs.readBytes(n.path)\r\n          } catch {\r\n            continue\r\n          }\r\n        }\r\n        const ext = extOf(n.path)\r\n        if (mode === 'full') {\r\n          await client.mkdir(dirOf(n.path))\r\n          const r = await client.putBytes(n.path, bytes)\r\n          if (!r.ok) throw new Error(`上传附件失败（${r.status}）：${n.path}`)\r\n        } else {\r\n          await client.mkdir('_zn/relay')\r\n          const r = await client.putBytes(`_zn/relay/${relayName(fp, ext)}`, bytes)\r\n          if (!r.ok) throw new Error(`上传附件失败（${r.status}）：${n.path}`)\r\n        }\r\n        nextAtt[n.path] = { fp, ext, at: Date.now(), mode }\r\n        changed = true\r\n        summary.pushed += 1\r\n      }\r\n      }\r\n\r\n      // ② 远端 → 本地（本地没有这份，**或者远端换过内容**）\r\n      for (const [path, entry] of Object.entries(remoteAtt)) {\r\n        if (!entry || entry.cleaned) continue\r\n        if (!isAttachment(path)) continue\r\n        const local = localByPath.get(path) ?? null\r\n        /**\r\n         * 内容级判定（rev173.117）：以前是 `localPaths.has(path)` —— 只要本地有这个文件名\r\n         * 就永远不再看，远端把同一路径的图换掉时两端会长期不一致。现在比指纹。\r\n         */\r\n        let localFp = null\r\n        if (local) {\r\n          try {\r\n            // `localFpOf` 返回 `{ fp, bytes }`；以前把**对象**当指纹用，与字符串永远不等 ⇒\r\n            // 本地同版也会每轮拉一次（rev173.126 修）\r\n            const got = await localFpOf(local)\r\n            localFp = got.fp\r\n            // 这一轮真要上传的话，直接复用刚读到的字节，别再读一遍盘\r\n            if (got.bytes) preloaded.set(path, got.bytes)\r\n          } catch {\r\n            localFp = null\r\n          }\r\n        }\r\n        if (!needsAttachmentPull(localFp, entry)) continue\r\n        // 版本不同且本地更新 ⇒ 本机改过、留给 pushLocal；否则远端更新 ⇒ 拉\r\n        if (local && Number(local.mtime ?? 0) > Number(entry.at ?? 0)) continue\r\n        // 云端那份放在哪由**上传方的模式**决定（条目里的 `mode`），不是本机设置\r\n        const remoteMode = entry.mode === 'full' || entry.mode === 'relay' ? entry.mode : mode\r\n        const src = remoteMode === 'full' ? path : `_zn/relay/${relayName(entry.fp, entry.ext || extOf(path))}`\r\n        let got = null\r\n        try {\r\n          // 带上次的 ETag：远端没变 ⇒ 304，不用再传一遍字节（rev173.117）\r\n          got = await client.getBytes(src, attEtag.get(src) ?? null)\r\n        } catch (e) {\r\n          api.host.log('warn', `下载附件失败 ${path}：${String(e)}`)\r\n          continue\r\n        }\r\n        if (got?.notModified) {\r\n          /**\r\n           * 304 = 远端这份与我们**上次取到**的一样。本地文件如果就是那份（指纹对得上），\r\n           * 说明是本地被改动过、而远端没动 —— 不覆盖用户的本地文件；否则我们手上没有\r\n           * 可用的字节，只能补一次完整下载。\r\n           */\r\n          if (localFp && localFp === entry.fp) continue\r\n          try {\r\n            got = await client.getBytes(src)\r\n          } catch (e) {\r\n            api.host.log('warn', `下载附件失败 ${path}：${String(e)}`)\r\n            continue\r\n          }\r\n        }\r\n        if (!got?.data) continue\r\n        try {\r\n          await api.fs.writeBytes(path, got.data)\r\n        } catch (e) {\r\n          api.host.log('warn', `写入附件失败 ${path}：${String(e)}`)\r\n          continue\r\n        }\r\n        if (got.etag) attEtag.set(src, got.etag)\r\n        // 刚写完，`listNotes` 的 mtime / size 变了 ⇒ 丢掉旧指纹，下一轮重新算一次\r\n        attFpCache.delete(path)\r\n        // 本地已被远端版覆盖 ⇒ 丢弃「算指纹时读到的旧字节」，否则下一句上传会拿旧内容推回去\r\n        preloaded.delete(path)\r\n        summary.pulled += 1\r\n        if (remoteMode === 'relay') {\r\n          await client.mkdir('_zn/relay-ack')\r\n          await client.putBytes(`_zn/relay-ack/${relayName(entry.fp, '')}`, new TextEncoder().encode(me))\r\n        }\r\n      }\r\n\r\n      await pushLocal()\r\n\r\n      // ③ relay 清理：有 ack 就删云端副本（任何端都能做，幂等）\r\n      /**\r\n       * **每轮最多查一个条目**（rev173.284 · 真人测试二「又限流 503」）。\r\n       *\r\n       * 每个 relay 条目一次 PROPFIND：11 张图 × 12 轮/分 = 132 次/分 —— 光这一项就能\r\n       * 打满坚果云 600 次/30 分钟的限额（对端没上线时条目会一直停在「未 ack」）。\r\n       * ack 是「对端取走附件」这种低频事件，轮转查的延迟（11 个条目 ≈ 55 秒）没有体感；\r\n       * 但请求量从 132 次/分降到 12 次/分。\r\n       */\r\n      const relayEntries = Object.entries(nextAtt).filter(([, e]) => {\r\n        if (!e || e.cleaned) return false\r\n        // 只有「云端那份确实在 relay 路径上」的条目才有 ack 可等（full 条目永不清理）\r\n        const m = e.mode === 'full' || e.mode === 'relay' ? e.mode : mode\r\n        return m === 'relay'\r\n      })\r\n      if (relayEntries.length > 0) {\r\n        const [ackPath, ackEntry] = relayEntries[ackCursor % relayEntries.length]\r\n        ackCursor += 1\r\n        const acked = await client.exists(`_zn/relay-ack/${relayName(ackEntry.fp, '')}`)\r\n        if (acked) {\r\n          await client.remove(`_zn/relay/${relayName(ackEntry.fp, ackEntry.ext || extOf(ackPath))}`)\r\n          nextAtt[ackPath] = { ...ackEntry, mode: 'relay', cleaned: true }\r\n          changed = true\r\n        }\r\n      }\r\n\r\n      return { attachments: nextAtt, changed }\r\n    }\r\n\r\n    /* ── 自动同步（「无感」就是这一段） ── */\r\n\r\n    let autoTimer = null\r\n    /**\r\n     * 限流退避状态（rev173.279 · #12）：\r\n     * `backoffLevel` = 已连撞几次限额（0 = 正常），`backoffUntil` = 退避到哪个时间点。\r\n     * 退避期间 5 秒的节拍照跑，但**跳过不发请求** —— 保留节拍是为了成功后能自动恢复，\r\n     * 不用用户手动重开。\r\n     */\r\n    let backoffLevel = 0\r\n    let backoffUntil = 0\r\n\r\n    /**\r\n     * 开自动同步：前台每 `AUTO_MS` 跑一次。\r\n     *\r\n     * 三条约束（都对应一个真实坑）：\r\n     * · **只在前台跑**：Android 切后台会挂起定时器（方案 §8 第 5 条，用户已接受这个边界），\r\n     *   这里再判一道，免得在桌面端空转打远端；\r\n     * · `busy` 时跳过：手动同步正在跑时不能再起一轮；\r\n     * · 静默模式：没变化不刷面板（每 5 秒重渲染会把用户正在填的表单刷掉）。\r\n     */\r\n    function startAuto() {\r\n      // 本地文件夹后端没有远端可轮询：它的「自动检查」由 folder 后端自己的事件 + 节拍负责\r\n      if (settings.backend === 'folder') return\r\n      if (autoTimer || !hasConfig()) return\r\n      const timer = window.setInterval(() => {\r\n        if (busy || !hasConfig()) return\r\n        // 限流退避期：节拍照走、请求不发（成功后自动恢复，见 runSync 的 catch）\r\n        if (Date.now() < backoffUntil) return\r\n        if (typeof document !== 'undefined' && document.visibilityState !== 'visible') return\r\n        void runSync('自动', { silent: true })\r\n      }, AUTO_MS)\r\n      autoTimer = timer\r\n      api.subscriptions.push({\r\n        __syncAuto: true,\r\n        dispose: () => {\r\n          window.clearInterval(timer)\r\n          if (autoTimer === timer) autoTimer = null\r\n        },\r\n      })\r\n    }\r\n\r\n    function stopAuto() {\r\n      const i = api.subscriptions.findIndex((s) => s && s.__syncAuto)\r\n      if (i >= 0) {\r\n        const [sub] = api.subscriptions.splice(i, 1)\r\n        sub.dispose()\r\n      }\r\n      if (autoTimer) {\r\n        window.clearInterval(autoTimer)\r\n        autoTimer = null\r\n      }\r\n    }\r\n\r\n    /* ── 面板 ── */\r\n\r\n    /**\r\n     * 冲突记录区块（**两个后端共用**）。\r\n     *\r\n     * 冲突副本的位置、结构、处理入口对两个后端完全一样（都在 `.zn/conflicts/<平台>/`），\r\n     * 只有文案不同：文件夹后端没有「云端」可推，它的「另一边」是外部同步工具。\r\n     */\r\n    function conflictSection() {\r\n      if (conflicts.length === 0) return []\r\n      const isFolder = settings.backend === 'folder'\r\n      return [\r\n        { type: 'divider' },\r\n        { type: 'text', value: `冲突记录 · ${conflicts.length} 条`, variant: 'title' },\r\n        {\r\n          type: 'text',\r\n          value: isFolder\r\n            ? '两边都改过的文件：选一边保留即可。选「本机版」会立刻写回，选「外部版」只清掉副本。'\r\n            : '两边都改过的文件：选一边保留即可。选「本机版」会立刻写回并推上云端；选「远端版」只清掉副本。',\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        },\r\n        {\r\n          type: 'list',\r\n          items: conflicts.slice(0, 8).map((c) => {\r\n            const where = c.file ? `${CONFLICT_ROOT}/${c.platform}/${c.file}` : null\r\n            const base = { file: c.file, platform: c.platform, path: c.path }\r\n            return {\r\n              type: 'stack',\r\n              gap: 'sm',\r\n              children: [\r\n                {\r\n                  type: 'text',\r\n                  value: `${new Date(c.at).toLocaleString()} · ${c.path}`,\r\n                },\r\n                ...(where\r\n                  ? [\r\n                      {\r\n                        type: 'text',\r\n                        value: `${where} · ${c.reason || '双端修改'}`,\r\n                        variant: 'caption',\r\n                        tone: 'muted',\r\n                      },\r\n                      /**\r\n                       * **处理入口**（rev173.283 · 真人测试二 #2）。\r\n                       *\r\n                       * 以前这里只有「打开冲突副本」—— 打开之后没有任何动作能把结果落定，\r\n                       * 用户只能自己去文件管理器里复制粘贴。现在两个方向都能一键收尾：\r\n                       *   · 用本机版：把副本内容写回笔记 → 立刻推一轮（webdav）/ 对齐基线（folder）\r\n                       *   · 保留另一边：当前笔记已经是那一边的版本 → 删副本 + 清记录\r\n                       */\r\n                      {\r\n                        type: 'row',\r\n                        gap: 'sm',\r\n                        wrap: true,\r\n                        children: [\r\n                          {\r\n                            type: 'button',\r\n                            label: '用本机版',\r\n                            onClick: 'sync.resolve-conflict',\r\n                            payload: { ...base, choice: 'local' },\r\n                          },\r\n                          {\r\n                            type: 'button',\r\n                            label: isFolder ? '保留外部版' : '保留远端版',\r\n                            onClick: 'sync.resolve-conflict',\r\n                            payload: { ...base, choice: 'remote' },\r\n                            variant: 'ghost',\r\n                          },\r\n                          {\r\n                            type: 'button',\r\n                            label: '看副本',\r\n                            onClick: 'sync.open-conflict',\r\n                            payload: { file: c.file, platform: c.platform },\r\n                            variant: 'ghost',\r\n                          },\r\n                        ],\r\n                      },\r\n                    ]\r\n                  : [\r\n                      {\r\n                        type: 'text',\r\n                        value: '（本机版没留下来，只能保留另一边）',\r\n                        variant: 'caption',\r\n                        tone: 'muted',\r\n                      },\r\n                    ]),\r\n              ],\r\n            }\r\n          }),\r\n        },\r\n      ]\r\n    }\r\n\r\n    /**\r\n     * 后端选择器（面板最上面一块：一个插件，后端可换）。\r\n     *\r\n     * 用**按钮**而不是 select：契约里的 `select` 只认 `state[bind]`，render 拿不到写 state\r\n     * 的权限 ⇒ 初始选中项会永远停在第一项（用户上次选的 folder 显示成 webdav）。\r\n     * 按钮 +「当前」徽章没有这个问题。\r\n     */\r\n    function backendPicker() {\r\n      const isFolder = settings.backend === 'folder'\r\n      const isS3 = settings.backend === 's3'\r\n      const isGit = settings.backend === 'git'\r\n      const label = isFolder ? '本地文件夹' : isS3 ? 'S3' : isGit ? 'Git' : 'WebDAV'\r\n      return {\r\n        type: 'row',\r\n        gap: 'sm',\r\n        wrap: true,\r\n        children: [\r\n          { type: 'badge', text: `当前：${label}`, tone: 'success' },\r\n          {\r\n            type: 'button',\r\n            label: 'WebDAV',\r\n            onClick: 'sync.set-backend',\r\n            payload: { value: 'webdav' },\r\n            variant: !isFolder && !isS3 && !isGit ? 'solid' : 'ghost',\r\n          },\r\n          {\r\n            type: 'button',\r\n            label: 'S3',\r\n            onClick: 'sync.set-backend',\r\n            payload: { value: 's3' },\r\n            variant: isS3 ? 'solid' : 'ghost',\r\n          },\r\n          {\r\n            type: 'button',\r\n            label: 'Git',\r\n            onClick: 'sync.set-backend',\r\n            payload: { value: 'git' },\r\n            variant: isGit ? 'solid' : 'ghost',\r\n          },\r\n          {\r\n            type: 'button',\r\n            label: '本地文件夹',\r\n            onClick: 'sync.set-backend',\r\n            payload: { value: 'folder' },\r\n            variant: isFolder ? 'solid' : 'ghost',\r\n          },\r\n        ],\r\n      }\r\n    }\r\n\r\n    /**\r\n     * 本地文件夹后端的面板。\r\n     *\r\n     * 结构 = 一句话说明 + 后端选择 +（`folder.renderSection()` 的统计 / 按钮 / `.zn` 提醒）\r\n     * + 共用冲突区段。刻意**不显示** WebDAV 的地址 / 密码 / 附件表单 —— 那些在这个后端下\r\n     * 一个都不生效，摆着只会让人以为配了就同步。\r\n     */\r\n    function folderPanel() {\r\n      const children = [\r\n        {\r\n          type: 'text',\r\n          value: '同步方式：**本地文件夹**（本插件不搬文件）。库放在同步目录里，搬运交给 Syncthing / OneDrive / 坚果云客户端；插件只负责判定冲突、留副本。',\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        },\r\n        { type: 'spacer', size: 'sm' },\r\n        backendPicker(),\r\n        { type: 'divider' },\r\n        ...folder.renderSection(),\r\n        ...conflictSection(),\r\n      ]\r\n      return { type: 'stack', gap: 'md', children }\r\n    }\r\n\r\n    /**\r\n     * S3 后端的面板。\r\n     *\r\n     * 字段与 WebDAV 不同（没有\"目录\"，有的是桶 / 区域 / 前缀），所以单开一份；\r\n     * 附件模式、自动开关、冲突区段**与 WebDAV 完全同义** —— 它们属于引擎，不属于协议。\r\n     */\r\n    function s3Panel(ctx) {\r\n      const state = (ctx && ctx.state) || {}\r\n      // 宿主把用户输入写进 state；已保存的值当兜底（与 WebDAV 表单同一个做法，见 render）\r\n      form = {\r\n        endpoint: String(state['sync.s3.endpoint'] || settings.endpoint || ''),\r\n        region: String(state['sync.s3.region'] || settings.region || ''),\r\n        bucket: String(state['sync.s3.bucket'] || settings.bucket || ''),\r\n        accessKey: String(state['sync.s3.accessKey'] || settings.accessKey || ''),\r\n        secret: String(state['sync.s3.secret'] || ''),\r\n        prefix: String(state['sync.s3.prefix'] || settings.prefix || ''),\r\n      }\r\n      const configured = hasConfig()\r\n      const children = [\r\n        {\r\n          type: 'text',\r\n          value: '同步方式：**S3 兼容存储**（插件自己搬）。Secret 存系统凭据库，其余存插件设置。',\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        },\r\n        { type: 'spacer', size: 'sm' },\r\n        backendPicker(),\r\n        { type: 'divider' },\r\n        { type: 'text', value: configured ? '已配置' : '还没配置', variant: 'title' },\r\n        ...(configured\r\n          ? [\r\n              {\r\n                type: 'text',\r\n                value: `当前：${settings.endpoint} · 桶 ${settings.bucket} · 区域 ${settings.region || 'us-east-1'} · 前缀 ${settings.prefix || '（根）'}`,\r\n                variant: 'caption',\r\n              },\r\n            ]\r\n          : []),\r\n        {\r\n          type: 'field',\r\n          label: 'Endpoint',\r\n          hint: '例：https://s3.ap-east-1.amazonaws.com · http://127.0.0.1:9000（MinIO）',\r\n          children: { type: 'input', bind: 'sync.s3.endpoint', placeholder: 'https://…' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '区域',\r\n          hint: 'AWS 填地域（如 ap-east-1）；MinIO / R2 一般留 us-east-1',\r\n          children: { type: 'input', bind: 'sync.s3.region', placeholder: 'us-east-1' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '桶名',\r\n          children: { type: 'input', bind: 'sync.s3.bucket', placeholder: 'zeronote' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: 'Access Key ID',\r\n          children: { type: 'input', bind: 'sync.s3.accessKey', placeholder: 'AKIA…' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: 'Secret Access Key',\r\n          hint: '只写在这里；保存后存进系统凭据库',\r\n          children: { type: 'input', bind: 'sync.s3.secret', secret: true, placeholder: '不改就留空' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '对象前缀',\r\n          hint: '可选：把笔记放在桶里某个子目录下',\r\n          children: { type: 'input', bind: 'sync.s3.prefix', placeholder: 'ZeroNote' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '附件（图片 / PDF）',\r\n          hint: '不同步 = 只同步 .md；中转 = 对端收到后云端副本删掉（省空间）；永久 = 与文档一样',\r\n          children: {\r\n            type: 'select',\r\n            bind: 'sync.attachmentsMode',\r\n            options: [\r\n              { value: 'off', label: '不同步（默认）' },\r\n              { value: 'relay', label: '同步中转（云端不常留）' },\r\n              { value: 'full', label: '与文档一样永久同步' },\r\n            ],\r\n            onSubmit: 'sync.set-attachments',\r\n          },\r\n        },\r\n        {\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            { type: 'button', label: '保存设置', onClick: 'sync.save' },\r\n            { type: 'button', label: '测试连接', onClick: 'sync.test', variant: 'ghost' },\r\n            { type: 'button', label: '立即同步', onClick: 'sync.run', disabled: !configured || busy },\r\n            {\r\n              type: 'button',\r\n              label: settings.auto === false ? '开启自动同步' : '关闭自动同步',\r\n              onClick: 'sync.toggle-auto',\r\n              variant: 'ghost',\r\n            },\r\n            { type: 'button', label: '断开连接', onClick: 'sync.disconnect', variant: 'danger' },\r\n          ],\r\n        },\r\n        {\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            {\r\n              type: 'badge',\r\n              text:\r\n                settings.auto === false\r\n                  ? '手动同步'\r\n                  : backoffUntil > Date.now()\r\n                    ? `自动 · 限流退避中（${Math.ceil((backoffUntil - Date.now()) / 1000)} 秒后重试）`\r\n                    : '自动 · 前台每 5 秒',\r\n              tone: settings.auto === false ? 'muted' : backoffUntil > Date.now() ? 'warn' : 'success',\r\n            },\r\n            ...(busy ? [{ type: 'badge', text: '正在同步…', tone: 'warn' }] : []),\r\n          ],\r\n        },\r\n      ]\r\n\r\n      if (formError) children.push({ type: 'text', value: formError, tone: 'danger', variant: 'caption' })\r\n\r\n      if (lastResult) {\r\n        children.push({ type: 'divider' })\r\n        children.push({\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            { type: 'badge', text: `下载 ${lastResult.pulled}`, tone: 'default' },\r\n            { type: 'badge', text: `上传 ${lastResult.pushed}`, tone: 'default' },\r\n            ...(lastResult.merged > 0 ? [{ type: 'badge', text: `合并 ${lastResult.merged}`, tone: 'success' }] : []),\r\n            {\r\n              type: 'badge',\r\n              text: `冲突 ${lastResult.conflicts}`,\r\n              tone: lastResult.conflicts > 0 ? 'danger' : 'success',\r\n            },\r\n          ],\r\n        })\r\n        children.push({\r\n          type: 'text',\r\n          value: `${new Date(lastResult.at).toLocaleString()} · ${lastResult.hint || ''}`,\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        })\r\n      }\r\n\r\n      children.push(...conflictSection())\r\n      return { type: 'stack', gap: 'md', children }\r\n    }\r\n\r\n    /**\r\n     * Git 后端的面板。\r\n     *\r\n     * 走仓库 Contents API（GitHub / Gitea / Gitee）：字段是平台 + 所有者 + 仓库 + 分支，\r\n     * 没有「目录」的概念（前缀只是把笔记放进子目录）。\r\n     */\r\n    function gitPanel(ctx) {\r\n      const state = (ctx && ctx.state) || {}\r\n      form = {\r\n        provider: String(state['sync.git.provider'] || settings.provider || 'github'),\r\n        apiBase: String(state['sync.git.apiBase'] || settings.apiBase || ''),\r\n        owner: String(state['sync.git.owner'] || settings.owner || ''),\r\n        repo: String(state['sync.git.repo'] || settings.repo || ''),\r\n        branch: String(state['sync.git.branch'] || settings.branch || ''),\r\n        gitPrefix: String(state['sync.git.prefix'] || settings.repoPrefix || ''),\r\n        token: String(state['sync.git.token'] || ''),\r\n      }\r\n      const configured = hasConfig()\r\n      const preset = PROVIDERS[settings.provider] ?? PROVIDERS.github\r\n      return {\r\n        type: 'stack',\r\n        gap: 'md',\r\n        children: [\r\n          {\r\n            type: 'text',\r\n            value: '同步方式：**Git 仓库**（插件自己搬）。令牌存系统凭据库，仓库信息存插件设置。',\r\n            variant: 'caption',\r\n            tone: 'muted',\r\n          },\r\n          { type: 'spacer', size: 'sm' },\r\n          backendPicker(),\r\n          { type: 'divider' },\r\n          { type: 'text', value: configured ? '已配置' : '还没配置', variant: 'title' },\r\n          ...(configured\r\n            ? [\r\n                {\r\n                  type: 'text',\r\n                  value: `当前：${preset.label} · ${settings.owner}/${settings.repo} · 分支 ${settings.branch || 'main'} · 前缀 ${settings.repoPrefix || '（根）'}`,\r\n                  variant: 'caption',\r\n                },\r\n              ]\r\n            : []),\r\n          {\r\n            type: 'field',\r\n            label: '平台',\r\n            hint: 'GitHub / Gitea / Gitee —— 三家 API 形状不同，写方法与认证方式由插件按平台选',\r\n            children: {\r\n              type: 'row',\r\n              gap: 'sm',\r\n              wrap: true,\r\n              children: ['github', 'gitea', 'gitee'].map((key) => ({\r\n                type: 'button',\r\n                label: PROVIDERS[key].label,\r\n                onClick: 'sync.set-provider',\r\n                payload: { value: key },\r\n                variant: settings.provider === key ? 'solid' : 'ghost',\r\n              })),\r\n            },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: 'API 根',\r\n            hint: '留空用平台预设（自建 Gitea / 代理时再填）',\r\n            children: {\r\n              type: 'input',\r\n              bind: 'sync.git.apiBase',\r\n              placeholder: preset.api,\r\n            },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '所有者',\r\n            hint: 'GitHub 用户名或组织名',\r\n            children: { type: 'input', bind: 'sync.git.owner', placeholder: 'aqua' },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '仓库',\r\n            children: { type: 'input', bind: 'sync.git.repo', placeholder: 'zeronote-vault' },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '分支',\r\n            hint: '留空默认 main',\r\n            children: { type: 'input', bind: 'sync.git.branch', placeholder: 'main' },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '对象前缀',\r\n            hint: '可选：把笔记放进仓库的子目录',\r\n            children: { type: 'input', bind: 'sync.git.prefix', placeholder: 'notes' },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '访问令牌',\r\n            hint: '只写在这里；保存后存进系统凭据库（GitHub 需要 repo 权限）',\r\n            children: { type: 'input', bind: 'sync.git.token', secret: true, placeholder: '不改就留空' },\r\n          },\r\n          {\r\n            type: 'field',\r\n            label: '附件（图片 / PDF）',\r\n            hint: '不同步 = 只同步 .md；中转 = 对端收到后云端副本删掉；永久 = 与文档一样',\r\n            children: {\r\n              type: 'select',\r\n              bind: 'sync.attachmentsMode',\r\n              options: [\r\n                { value: 'off', label: '不同步（默认）' },\r\n                { value: 'relay', label: '同步中转（云端不常留）' },\r\n                { value: 'full', label: '与文档一样永久同步' },\r\n              ],\r\n              onSubmit: 'sync.set-attachments',\r\n            },\r\n          },\r\n          {\r\n            type: 'row',\r\n            gap: 'sm',\r\n            wrap: true,\r\n            children: [\r\n              { type: 'button', label: '保存设置', onClick: 'sync.save' },\r\n              { type: 'button', label: '测试连接', onClick: 'sync.test', variant: 'ghost' },\r\n              { type: 'button', label: '立即同步', onClick: 'sync.run', disabled: !configured || busy },\r\n              {\r\n                type: 'button',\r\n                label: settings.auto === false ? '开启自动同步' : '关闭自动同步',\r\n                onClick: 'sync.toggle-auto',\r\n                variant: 'ghost',\r\n              },\r\n              { type: 'button', label: '断开连接', onClick: 'sync.disconnect', variant: 'danger' },\r\n            ],\r\n          },\r\n          {\r\n            type: 'row',\r\n            gap: 'sm',\r\n            wrap: true,\r\n            children: [\r\n              {\r\n                type: 'badge',\r\n                text:\r\n                  settings.auto === false\r\n                    ? '手动同步'\r\n                    : backoffUntil > Date.now()\r\n                      ? `自动 · 限流退避中（${Math.ceil((backoffUntil - Date.now()) / 1000)} 秒后重试）`\r\n                      : '自动 · 前台每 5 秒',\r\n                tone: settings.auto === false ? 'muted' : backoffUntil > Date.now() ? 'warn' : 'success',\r\n              },\r\n              ...(busy ? [{ type: 'badge', text: '正在同步…', tone: 'warn' }] : []),\r\n            ],\r\n          },\r\n          ...(formError\r\n            ? [{ type: 'text', value: formError, tone: 'danger', variant: 'caption' }]\r\n            : []),\r\n          ...(lastResult\r\n            ? [\r\n                { type: 'divider' },\r\n                {\r\n                  type: 'row',\r\n                  gap: 'sm',\r\n                  wrap: true,\r\n                  children: [\r\n                    { type: 'badge', text: `下载 ${lastResult.pulled}`, tone: 'default' },\r\n                    { type: 'badge', text: `上传 ${lastResult.pushed}`, tone: 'default' },\r\n                    ...(lastResult.merged > 0\r\n                      ? [{ type: 'badge', text: `合并 ${lastResult.merged}`, tone: 'success' }]\r\n                      : []),\r\n                    {\r\n                      type: 'badge',\r\n                      text: `冲突 ${lastResult.conflicts}`,\r\n                      tone: lastResult.conflicts > 0 ? 'danger' : 'success',\r\n                    },\r\n                  ],\r\n                },\r\n                {\r\n                  type: 'text',\r\n                  value: `${new Date(lastResult.at).toLocaleString()} · ${lastResult.hint || ''}`,\r\n                  variant: 'caption',\r\n                  tone: 'muted',\r\n                },\r\n              ]\r\n            : []),\r\n          ...conflictSection(),\r\n        ],\r\n      }\r\n    }\r\n\r\n    function render(ctx) {\r\n      // 本地文件夹后端：面板整体换一套（没有地址 / 密码 / 附件表单）\r\n      if (settings.backend === 'folder') return folderPanel()\r\n      if (settings.backend === 's3') return s3Panel(ctx)\r\n      if (settings.backend === 'git') return gitPanel(ctx)\r\n      const state = (ctx && ctx.state) || {}\r\n      // 宿主把用户输入写进 state；已保存的值当兜底（这样重开面板能看到上次配的地址）\r\n      // ⚠️ 用 `||` 不是 `??`：宿主会把 bind 初始化成**空字符串**，`??` 认空串为有值 ⇒ 预填失效\r\n      form = {\r\n        baseUrl: String(state['sync.baseUrl'] || settings.baseUrl || ''),\r\n        username: String(state['sync.username'] || settings.username || ''),\r\n        password: String(state['sync.password'] || ''),\r\n        root: String(state['sync.root'] || settings.root || ''),\r\n      }\r\n      const configured = !!settings.baseUrl\r\n      const children = [\r\n        {\r\n          type: 'text',\r\n          value: '同步方式：**WebDAV**（插件自己搬）。密码存系统凭据库，地址与账号存插件设置。',\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        },\r\n        { type: 'spacer', size: 'sm' },\r\n        backendPicker(),\r\n        { type: 'divider' },\r\n        { type: 'text', value: configured ? '已配置' : '还没配置', variant: 'title' },\r\n        ...(configured\r\n          ? [\r\n              {\r\n                type: 'text',\r\n                value: `当前：${settings.baseUrl}${settings.root ? ` · 目录 ${settings.root}` : ' · **目录为空**（坚果云等不可写根目录）'} · 账号 ${settings.username || '（空）'}`,\r\n                variant: 'caption',\r\n              },\r\n            ]\r\n          : []),\r\n        {\r\n          type: 'field',\r\n          label: 'WebDAV 地址',\r\n          hint: '例：https://dav.jianguoyun.com/dav/',\r\n          children: {\r\n            type: 'input',\r\n            bind: 'sync.baseUrl',\r\n            placeholder: 'https://…/dav/',\r\n          },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '账号',\r\n          children: { type: 'input', bind: 'sync.username', placeholder: '邮箱 / 用户名' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '密码 / 应用密码',\r\n          hint: '只写在这里；保存后存进系统凭据库',\r\n          /* rev173.275 · 真人使用测试 #14：以前是明文 input，保存后密码就摊在屏幕上。\r\n             契约里的 `secret: true` 渲染成密码框（圆点），是对齐 `secrets` 密码库的做法。 */\r\n          children: { type: 'input', bind: 'sync.password', secret: true, placeholder: '不改就留空' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '同步目录',\r\n          hint: '远端放笔记的子目录。**坚果云的 WebDAV 根不可写，必须填**（如 ZeroNote）',\r\n          children: { type: 'input', bind: 'sync.root', placeholder: settings.root || 'ZeroNote' },\r\n        },\r\n        {\r\n          type: 'field',\r\n          label: '附件（图片 / PDF）',\r\n          hint: '不同步 = 只同步 .md；中转 = 对端收到后云端副本删掉（省空间）；永久 = 与文档一样',\r\n          children: {\r\n            type: 'select',\r\n            bind: 'sync.attachmentsMode',\r\n            options: [\r\n              { value: 'off', label: '不同步（默认）' },\r\n              { value: 'relay', label: '同步中转（云端不常留）' },\r\n              { value: 'full', label: '与文档一样永久同步' },\r\n            ],\r\n            onSubmit: 'sync.set-attachments',\r\n          },\r\n        },\r\n        {\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            { type: 'button', label: '保存设置', onClick: 'sync.save' },\r\n            { type: 'button', label: '测试连接', onClick: 'sync.test', variant: 'ghost' },\r\n            { type: 'button', label: '立即同步', onClick: 'sync.run', disabled: !configured || busy },\r\n            {\r\n              type: 'button',\r\n              label: settings.auto === false ? '开启自动同步' : '关闭自动同步',\r\n              onClick: 'sync.toggle-auto',\r\n              variant: 'ghost',\r\n            },\r\n            { type: 'button', label: '断开连接', onClick: 'sync.disconnect', variant: 'danger' },\r\n          ],\r\n        },\r\n        {\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            {\r\n              type: 'badge',\r\n              /**\r\n               * 限流退避中要**说出来**（rev173.279 · #12）：否则面板一直写「自动 · 前台每 5 秒」，\r\n               * 而实际已经拉到 60 秒一轮 —— 用户会以为同步还在高频打远端。\r\n               */\r\n              text:\r\n                settings.auto === false\r\n                  ? '手动同步'\r\n                  : backoffUntil > Date.now()\r\n                    ? `自动 · 限流退避中（${Math.ceil((backoffUntil - Date.now()) / 1000)} 秒后重试）`\r\n                    : '自动 · 前台每 5 秒',\r\n              tone: settings.auto === false ? 'muted' : backoffUntil > Date.now() ? 'warn' : 'success',\r\n            },\r\n            ...(busy ? [{ type: 'badge', text: '正在同步…', tone: 'warn' }] : []),\r\n          ],\r\n        },\r\n      ]\r\n\r\n      if (formError) children.push({ type: 'text', value: formError, tone: 'danger', variant: 'caption' })\r\n\r\n      if (lastResult) {\r\n        children.push({ type: 'divider' })\r\n        children.push({ type: 'text', value: '上次同步', variant: 'title' })\r\n        children.push({\r\n          type: 'row',\r\n          gap: 'sm',\r\n          wrap: true,\r\n          children: [\r\n            { type: 'badge', text: `下载 ${lastResult.pulled}`, tone: 'default' },\r\n            { type: 'badge', text: `上传 ${lastResult.pushed}`, tone: 'default' },\r\n            // rev173.115：三方合并成功数（有真冲突段时仍进「冲突」）\r\n            ...(lastResult.merged > 0\r\n              ? [{ type: 'badge', text: `合并 ${lastResult.merged}`, tone: 'success' }]\r\n              : []),\r\n            {\r\n              type: 'badge',\r\n              text: `冲突 ${lastResult.conflicts}`,\r\n              tone: lastResult.conflicts > 0 ? 'danger' : 'success',\r\n            },\r\n          ],\r\n        })\r\n        children.push({\r\n          type: 'text',\r\n          value: `${new Date(lastResult.at).toLocaleString()} · ${lastResult.hint || ''}`,\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        })\r\n        /**\r\n         * 耗时（rev173.117）：总时长 + 三个阶段的拆分。\r\n         * 附件阶段为 0（模式 = 不同步 / 没有附件）时不显示，免得平白多两个 0。\r\n         */\r\n        if (lastResult.ms) {\r\n          const ms = lastResult.ms\r\n          children.push({\r\n            type: 'row',\r\n            gap: 'sm',\r\n            wrap: true,\r\n            children: [\r\n              { type: 'badge', text: `用时 ${fmtMs(ms.total)}`, tone: 'muted' },\r\n              { type: 'badge', text: `manifest ${fmtMs(ms.manifest)}`, tone: 'muted' },\r\n              { type: 'badge', text: `笔记 ${fmtMs(ms.notes)}`, tone: 'muted' },\r\n              ...(ms.attachments > 0\r\n                ? [{ type: 'badge', text: `附件 ${fmtMs(ms.attachments)}`, tone: 'muted' }]\r\n                : []),\r\n            ],\r\n          })\r\n        }\r\n      }\r\n\r\n      /**\r\n       * 耗时趋势（rev173.119）：最近若干次的平均 / 最慢 + 一条 sparkline。\r\n       *\r\n       * **刻意放在 `lastResult` 之外**：历史是落 store 的，重启 / 重开面板后\r\n       * `lastResult`（本进程的内存值）是空的 —— 挂在里面就等于\"每次开 App 都看不到趋势\"。\r\n       * 只有 1 条记录时不画（单点没有\"趋势\"可言）。\r\n       */\r\n      const trend = timingSummary(timingHistory)\r\n      if (trend && trend.count > 1) {\r\n        if (!lastResult) children.push({ type: 'divider' })\r\n        children.push({\r\n          type: 'text',\r\n          value: `最近 ${trend.count} 次：平均 ${fmtMs(trend.avg)} · 最慢 ${fmtMs(trend.max)}`,\r\n          variant: 'caption',\r\n          tone: 'muted',\r\n        })\r\n        const line = sparkline(timingHistory.map((e) => e.total))\r\n        if (line) children.push({ type: 'code', value: line })\r\n      }\r\n\r\n      children.push(...conflictSection())\r\n\r\n      return { type: 'stack', gap: 'md', children }\r\n    }\r\n\r\n    const register = (id, title, run) => api.command.register({ id, title, run })\r\n\r\n    async function openPanel() {\r\n      for (let i = 0; i < 5; i += 1) {\r\n        try {\r\n          await api.command.execute(`core.panel.${PANEL_ID}`)\r\n          return\r\n        } catch {\r\n          if (i === 4) return\r\n          await new Promise((r) => setTimeout(r, 120))\r\n        }\r\n      }\r\n    }\r\n\r\n    /** 从表单读值保存（密码空 = 不改） */\r\n    async function saveSettings() {\r\n      if (settings.backend === 's3') return saveS3Settings()\r\n      if (settings.backend === 'git') return saveGitSettings()\r\n      formError = null\r\n      const baseUrl = String(form.baseUrl ?? '').trim()\r\n      if (!baseUrl) {\r\n        formError = '地址不能为空'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (!/^https?:\\/\\//i.test(baseUrl)) {\r\n        formError = '地址要以 http:// 或 https:// 开头'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      settings = {\r\n        // 保留既有字段：以前整体覆盖会把 `auto` / `attachments` 冲掉 ——\r\n        // 保存一次设置，附件模式回到「不同步」、自动同步开关也跟着错位（2026-10-24 修）。\r\n        ...settings,\r\n        baseUrl,\r\n        username: String(form.username ?? '').trim(),\r\n        root: String(form.root ?? '').trim().replace(/^\\/+|\\/+$/g, ''),\r\n        enabled: true,\r\n      }\r\n      const pwd = String(form.password ?? '')\r\n      if (pwd) {\r\n        try {\r\n          await api.host.secrets.set(SECRET_KEY, pwd)\r\n          savedPasswords.set('p', pwd)\r\n        } catch (e) {\r\n          formError = `密码写入系统凭据库失败：${String(e)}`\r\n          api.view.refresh()\r\n          return\r\n        }\r\n      }\r\n      markDirty()\r\n      // 配好了就开自动同步（用户选「无感」；关闭的开关在面板上）\r\n      if (settings.auto !== false) startAuto()\r\n      api.host.notify('同步设置已保存')\r\n      api.view.refresh()\r\n    }\r\n\r\n    /**\r\n     * 保存 S3 设置（rev173.287）。\r\n     *\r\n     * Secret 与 WebDAV 密码同一套规矩：**只写在这里**，保存后进系统凭据库，\r\n     * 面板上不再回显（`savedS3Secret` 缓存只用于本进程后续请求）。\r\n     */\r\n    async function saveS3Settings() {\r\n      formError = null\r\n      const endpoint = String(form.endpoint ?? '').trim()\r\n      const bucket = String(form.bucket ?? '').trim()\r\n      const accessKey = String(form.accessKey ?? '').trim()\r\n      if (!endpoint) {\r\n        formError = 'Endpoint 不能为空'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (!/^https?:\\/\\//i.test(endpoint)) {\r\n        formError = 'Endpoint 要以 http:// 或 https:// 开头'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (!bucket) {\r\n        formError = '桶名不能为空'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (!accessKey) {\r\n        formError = 'Access Key ID 不能为空'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      settings = {\r\n        ...settings,\r\n        endpoint: endpoint.replace(/\\/+$/, ''),\r\n        region: String(form.region ?? '').trim() || 'us-east-1',\r\n        bucket,\r\n        accessKey,\r\n        prefix: String(form.prefix ?? '')\r\n          .trim()\r\n          .replace(/^\\/+|\\/+$/g, ''),\r\n        enabled: true,\r\n      }\r\n      const sec = String(form.secret ?? '')\r\n      if (sec) {\r\n        try {\r\n          await api.host.secrets.set(SECRET_S3_KEY, sec)\r\n          savedS3Secret = sec\r\n        } catch (e) {\r\n          formError = `Secret 写入系统凭据库失败：${String(e)}`\r\n          api.view.refresh()\r\n          return\r\n        }\r\n      }\r\n      markDirty()\r\n      if (settings.auto !== false) startAuto()\r\n      api.host.notify('S3 设置已保存')\r\n      api.view.refresh()\r\n    }\r\n\r\n    /**\r\n     * 保存 Git 设置（rev173.288）。\r\n     *\r\n     * 令牌与 WebDAV 密码 / S3 Secret 同一套规矩：只写在这里，保存后进系统凭据库。\r\n     */\r\n    async function saveGitSettings() {\r\n      formError = null\r\n      const owner = String(form.owner ?? '').trim()\r\n      const repo = String(form.repo ?? '').trim()\r\n      if (!owner || !repo) {\r\n        formError = '所有者与仓库名都不能为空'\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      const provider = PROVIDERS[settings.provider] ? settings.provider : 'github'\r\n      settings = {\r\n        ...settings,\r\n        provider,\r\n        apiBase: String(form.apiBase ?? '').trim().replace(/\\/+$/, ''),\r\n        owner,\r\n        repo,\r\n        branch: String(form.branch ?? '').trim() || 'main',\r\n        repoPrefix: String(form.gitPrefix ?? '')\r\n          .trim()\r\n          .replace(/^\\/+|\\/+$/g, ''),\r\n        enabled: true,\r\n      }\r\n      const token = String(form.token ?? '')\r\n      if (token) {\r\n        try {\r\n          await api.host.secrets.set(SECRET_GIT_KEY, token)\r\n          savedGitToken = token\r\n        } catch (e) {\r\n          formError = `令牌写入系统凭据库失败：${String(e)}`\r\n          api.view.refresh()\r\n          return\r\n        }\r\n      }\r\n      markDirty()\r\n      if (settings.auto !== false) startAuto()\r\n      api.host.notify('Git 设置已保存')\r\n      api.view.refresh()\r\n    }\r\n\r\n    api.view.registerPanel({ id: PANEL_ID, title: '同步', location: 'main', render })\r\n    register('sync.open', '同步：打开设置与状态', () => openPanel())\r\n    register('sync.save', '同步：保存 WebDAV 设置', () => {\r\n      if (settings.backend === 'folder') {\r\n        api.host.notify('当前是「本地文件夹」后端：它不需要地址与密码，文件由外部同步工具搬', 'warn')\r\n        return\r\n      }\r\n      return saveSettings()\r\n    })\r\n    register('sync.test', '同步：测试连接', async () => {\r\n      if (settings.backend === 'folder') {\r\n        /**\r\n         * 没有远端可测：能测的只有「外部同步工具有没有碰 `.zn/`」这件真实存在的事。\r\n         *\r\n         * 三种结论分开说（rev173.164 · 期 1c）：\r\n         *  · 密码库有冲突副本 —— 两端都改过密码库，**必须人挑一份**\r\n         *  · `.zn/` 有冲突痕迹 —— 同步工具没排除 `.zn/`，要把它加回排除\r\n         *  · 都没有 —— 顺带把「想同步密码库该怎么放行」讲清楚\r\n         */\r\n        const hits = await folder.refreshZnTrace()\r\n        const s = folder.stats()\r\n        if (s.secretHits.length) {\r\n          api.host.notify(\r\n            `⚠ 密码库有 ${s.secretHits.length} 份同步冲突副本（例如 ${s.secretHits[0]}）—— 两端都改过密码库，请手动挑一份用`,\r\n            'warn',\r\n          )\r\n          return\r\n        }\r\n        api.host.notify(\r\n          hits.length\r\n            ? `⚠ .zn/ 里有 ${hits.length} 个同步冲突副本（例如 ${hits[0]}）—— 同步工具没有排除它`\r\n            : '.zn/ 没发现同步冲突痕迹（仍请确认同步工具的排除列表里有 .zn/）· 要同步密码库：放行 .zn/secrets/ 与 .zn/security/',\r\n          hits.length ? 'warn' : 'info',\r\n        )\r\n        return\r\n      }\r\n      // 先停自动同步：否则 5 秒内那一轮会把「测试结果」从面板上覆盖掉（实测踩到）\r\n      stopAuto()\r\n      let ok = false\r\n      try {\r\n        const client = await makeClient()\r\n        const r = await client.test()\r\n        ok = r.ok\r\n        api.host.notify(r.ok ? `连接正常（${r.status}）` : r.hint, r.ok ? 'info' : 'error')\r\n        lastResult = { pulled: 0, pushed: 0, merged: 0, conflicts: 0, hint: r.hint, at: Date.now() }\r\n      } catch (e) {\r\n        api.host.notify(`连接测试失败：${String(e)}`, 'error')\r\n        lastResult = { pulled: 0, pushed: 0, merged: 0, conflicts: 0, hint: `连接测试失败：${String(e)}`, at: Date.now() }\r\n      } finally {\r\n        // 测试通过才恢复自动同步（失败时保持停着，避免打远端锁号）\r\n        if (ok && settings.baseUrl && settings.auto !== false) startAuto()\r\n        // 失败 = 自动同步已被上面的 stopAuto() 停掉 ⇒ settings.auto 同步置 false，\r\n        // 否则面板仍显示「关闭自动同步」（实际停了），用户不会知道要去手动重开。\r\n        else if (!ok && settings.auto !== false) {\r\n          settings.auto = false\r\n          markDirty()\r\n        }\r\n      }\r\n      api.view.refresh()\r\n    })\r\n    register('sync.run', '同步：立即同步一次', async () => {\r\n      const r = await runSync('手动')\r\n      if (settings.backend === 'folder') {\r\n        api.host.notify(\r\n          r?.skipped\r\n            ? '正在检查中…'\r\n            : `检查完成：更新 ${r?.updated ?? 0} · 移除 ${r?.removed ?? 0} · 冲突 ${r?.conflicts ?? 0}`,\r\n        )\r\n      }\r\n      // 返回摘要：测试与调用方靠它判断「推了几篇 / 有没有冲突」\r\n      return r\r\n    })\r\n    register('sync.set-attachments', '同步：设置附件同步方式', (payload) => {\r\n      if (settings.backend === 'folder') {\r\n        api.host.notify('「本地文件夹」后端不同步附件：图片由外部同步工具搬', 'warn')\r\n        return\r\n      }\r\n      const v = String(payload?.value ?? 'off')\r\n      settings.attachments = ['off', 'relay', 'full'].includes(v) ? v : 'off'\r\n      markDirty()\r\n      const label =\r\n        settings.attachments === 'off'\r\n          ? '不同步（只同步 .md）'\r\n          : settings.attachments === 'relay'\r\n            ? '同步中转（对端收到后云端删掉）'\r\n            : '与文档一样永久同步'\r\n      api.host.notify(`附件同步：${label}`)\r\n      api.view.refresh()\r\n    })\r\n    register('sync.toggle-auto', '同步：开关自动同步', async () => {\r\n      // 后端各有各的「自动」：folder 是事件 + 5 秒结算，webdav 是 5 秒轮询远端\r\n      if (settings.backend === 'folder') return folder.toggleAuto()\r\n      settings.auto = settings.auto === false\r\n      if (settings.auto) startAuto()\r\n      else stopAuto()\r\n      markDirty()\r\n      api.host.notify(\r\n        settings.auto ? '自动同步已开启（前台每 5 秒检查一次）' : '自动同步已关闭（仍可手动同步）',\r\n      )\r\n      api.view.refresh()\r\n    })\r\n    /**\r\n     * 切换后端（rev173.286）。\r\n     *\r\n     * 两件事必须按顺序做，否则状态会串：\r\n     *   ① **先把当前后端的基线落盘**（`persistBaseline` 读的是旧的 `settings.backend`）\r\n     *   ② 再换后端 + 读新后端自己的基线键（两个后端的 fp 语义不同，不能共用一份）\r\n     *\r\n     * 切换不动用户数据：文件、冲突副本、外部工具的配置都保持原样，只是「谁负责搬」变了。\r\n     */\r\n    register('sync.set-backend', '同步：切换同步方式（WebDAV / 本地文件夹）', async (payload) => {\r\n      const next = String(payload?.value ?? '')\r\n      if (next !== 'webdav' && next !== 's3' && next !== 'git' && next !== 'folder') return\r\n      if (settings.backend === next) return\r\n      await persistBaseline()\r\n      folder.detach()\r\n      stopAuto()\r\n      settings.backend = next\r\n      markDirty()\r\n      try {\r\n        const raw = (await api.store.get(baselineKey(), {})) ?? {}\r\n        /**\r\n         * 基线里的 `etag` 是**上一个协议**的（WebDAV 与 S3 的 ETag 不通用）——\r\n         * 换后端时只留内容指纹，条件写会在下一轮重新取 etag，不会误判成冲突。\r\n         */\r\n        baseline = Object.fromEntries(\r\n          Object.entries(raw instanceof Object ? raw : {}).map(([k, v]) => [\r\n            k,\r\n            v && typeof v === 'object' ? { fp: v.fp, at: v.at } : v,\r\n          ]),\r\n        )\r\n        if (next === 'folder') await folder.load()\r\n      } catch (e) {\r\n        api.host.log('warn', `切换后端时读状态失败：${String(e)}`)\r\n      }\r\n      if (next === 'folder') {\r\n        folder.attach()\r\n        api.host.notify(\r\n          '已切到「本地文件夹」：库放在同步目录里，搬运交给 Syncthing / OneDrive / 坚果云；记得在外部工具里排除 .zn/',\r\n        )\r\n      } else if (next === 's3') {\r\n        if (hasConfig() && settings.auto !== false) startAuto()\r\n        api.host.notify('已切到 S3：由插件自己搬文件（Endpoint / 桶 / 密钥在下面配）')\r\n      } else if (next === 'git') {\r\n        if (hasConfig() && settings.auto !== false) startAuto()\r\n        api.host.notify('已切到 Git：由插件自己搬文件（平台 / 所有者 / 仓库 / 令牌在下面配）')\r\n      } else {\r\n        if (settings.baseUrl && settings.auto !== false) startAuto()\r\n        api.host.notify('已切到 WebDAV：由插件自己搬文件（地址与密码在下面配）')\r\n      }\r\n      api.view.refresh()\r\n    })\r\n    register('sync.mark-baseline', '同步：把当前状态设为基线（本地文件夹）', async () => {\r\n      if (settings.backend !== 'folder') {\r\n        api.host.notify('「设为基线」只在本地文件夹后端可用', 'warn')\r\n        return\r\n      }\r\n      await folder.markSynced()\r\n    })\r\n    register('sync.set-provider', '同步：选择 Git 平台（GitHub / Gitea / Gitee）', (payload) => {\r\n      const v = String(payload?.value ?? '')\r\n      if (!PROVIDERS[v]) return\r\n      settings.provider = v\r\n      markDirty()\r\n      api.host.notify(`Git 平台：${PROVIDERS[v].label}（保存后生效）`)\r\n      api.view.refresh()\r\n    })\r\n    register('sync.open-conflict', '同步：打开冲突副本', async (payload) => {\r\n      const file = String(payload?.file ?? '')\r\n      const plat = String(payload?.platform || platform)\r\n      if (!file) {\r\n        api.host.notify('没有可打开的冲突副本', 'warn')\r\n        return\r\n      }\r\n      try {\r\n        await api.command.execute('core.openNote', { path: `${CONFLICT_ROOT}/${plat}/${file}` })\r\n      } catch (e) {\r\n        api.host.notify(`打不开冲突副本：${String(e)}`, 'error')\r\n      }\r\n    })\r\n    /**\r\n     * **收尾一条冲突**（rev173.283 · 真人测试二 #2「只有冲突记录却没有办法处理冲突」）。\r\n     *\r\n     * `choice: 'local'` —— 用本机版：把 `.zn/conflicts/<平台>/<文件>` 的内容写回笔记，\r\n     *   收尾后**立刻推一轮**。推送之所以成立：写回前先把基线对齐到「远端当前内容」，\r\n     *   于是 `decideSync` 看到「本地变了、远端没变」⇒ push（而不是又判一次冲突）。\r\n     *   远端这篇已经不在了 ⇒ 删基线 ⇒ 走 push-new（重新上传）。\r\n     *\r\n     * `choice: 'remote'` —— 保留远端版：冲突发生时本地已经被远端版覆盖过，当前笔记就是\r\n     *   远端版，所以只需要删副本 + 清记录。\r\n     *\r\n     * 两种都幂等：记录已经不在 ⇒ 明确说一句，不重复动文件。\r\n     */\r\n    register('sync.resolve-conflict', '同步：处理一条冲突（保留本机版 / 远端版）', async (payload) => {\r\n      // 文件夹后端没有「推上云端」这一步：写回 = 覆盖磁盘，外部工具下一轮会把新版搬走\r\n      if (settings.backend === 'folder') return folder.resolveConflict(payload)\r\n      const file = String(payload?.file ?? '')\r\n      const plat = String(payload?.platform || platform)\r\n      const path = String(payload?.path ?? '')\r\n      const choice = payload?.choice === 'remote' ? 'remote' : 'local'\r\n      const idx = conflicts.findIndex((c) => c.path === path && c.platform === plat)\r\n      if (idx < 0) {\r\n        api.host.notify('这条冲突已经不在了（可能刚刚处理过）', 'warn')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      const conflictPath = file ? `${CONFLICT_ROOT}/${plat}/${file}` : null\r\n      const dropRecord = async () => {\r\n        // 按 path 重新定位：这段是异步的，中途可能有新冲突 unshift 进来\r\n        const at = conflicts.findIndex((c) => c.path === path && c.platform === plat)\r\n        if (at >= 0) conflicts.splice(at, 1)\r\n        await api.store.set(KEY_CONFLICTS, conflicts).catch(() => {})\r\n      }\r\n      const dropCopy = async () => {\r\n        if (!conflictPath) return\r\n        try {\r\n          await api.fs.purgePrivate(conflictPath)\r\n        } catch (e) {\r\n          // 删不掉不算失败（下次还能再删）；不能因此把记录留着让用户以为没处理\r\n          api.host.log('warn', `冲突副本删除失败：${String(e)}`)\r\n        }\r\n      }\r\n\r\n      if (choice === 'remote') {\r\n        await dropCopy()\r\n        await dropRecord()\r\n        api.host.notify(`已保留远端版：${path}`)\r\n        api.view.refresh()\r\n        return\r\n      }\r\n\r\n      if (!conflictPath) {\r\n        api.host.notify('这条冲突没有留下本机副本，无法用本机版覆盖', 'warn')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      let localText = null\r\n      try {\r\n        localText = await api.fs.readText(conflictPath)\r\n      } catch {\r\n        localText = null\r\n      }\r\n      if (localText == null) {\r\n        api.host.notify('冲突副本读不到（可能已被清理）', 'error')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (!settings.baseUrl) {\r\n        api.host.notify('还没配置 WebDAV，先写回本机，配好后手动同步一次', 'warn')\r\n      }\r\n      // ① 先写回本机（这一步失败就什么都别做，副本还在）\r\n      try {\r\n        await api.fs.writeText(path, localText)\r\n      } catch (e) {\r\n        api.host.notify(`写回本机版失败：${String(e)}`, 'error')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      let pushed = false\r\n      try {\r\n        const client = await makeClient()\r\n        /**\r\n         * **不走 `runSync` 的方向判定，直接推**。\r\n         *\r\n         * 冲突收尾是\"人已经做了决定\"的动作，不该再让 `decideSync` 猜一遍：远端 manifest\r\n         * 里这一条可能已经过期（远端删过 / 412 场景），按普通判定会再判成一次冲突，\r\n         * 用户点了两次还是没结果。所以这里强制 PUT + 同步改 manifest 这一条 ——\r\n         * 结果确定：远端 = 本机版，基线与 manifest 一起对齐。\r\n         */\r\n        const res = await client.put(path, localText, undefined)\r\n        if (res.ok) {\r\n          const fp = fingerprint(localText)\r\n          baseline[path] = { fp, etag: res.etag ?? undefined }\r\n          try {\r\n            const remote = (await client.readManifest()) || {}\r\n            const files = { ...(remote.files || {}) }\r\n            files[path] = { fp, etag: res.etag ?? undefined, at: Date.now() }\r\n            await client.writeManifest({\r\n              files,\r\n              attachments: remote.attachments || {},\r\n              private: remote.private || {},\r\n              privateTree: remote.privateTree || {},\r\n            })\r\n          } catch (e) {\r\n            // manifest 没写进去不算失败（下一轮同步会按「本地变、远端没变」补齐）\r\n            api.host.log('warn', `冲突收尾后更新 manifest 失败：${String(e)}`)\r\n          }\r\n          pushed = true\r\n        } else {\r\n          api.host.notify(`写回了本机版，但上传失败（${res.status}），下一轮同步会重试`, 'warn')\r\n        }\r\n      } catch (e) {\r\n        api.host.notify(`写回了本机版，但上传失败：${String(e)}`, 'warn')\r\n      }\r\n      await dropCopy()\r\n      await dropRecord()\r\n      await api.store.set(KEY_BASELINE, baseline).catch(() => {})\r\n      api.host.notify(pushed ? `已用本机版覆盖并推送：${path}` : `已写回本机版：${path}`)\r\n      api.view.refresh()\r\n    })\r\n    register('sync.disconnect', '同步：断开并清除凭据', async () => {\r\n      if (settings.backend === 'folder') {\r\n        /**\r\n         * 文件夹后端「断开」= 清掉基线（下次启用重新建立）。\r\n         * **不动任何文件** —— 笔记、冲突副本、外部工具的配置都不归它管。\r\n         */\r\n        folder.detach()\r\n        baseline = {}\r\n        await persistBaseline()\r\n        api.host.notify('已清除本地文件夹后端的基线（文件本身没动；重新启用会重新建立）')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (settings.backend === 's3') {\r\n        try {\r\n          await api.host.secrets.delete(SECRET_S3_KEY)\r\n        } catch (e) {\r\n          api.host.log('warn', `删除 S3 密钥失败：${String(e)}`)\r\n        }\r\n        savedS3Secret = null\r\n        settings = { ...settings, endpoint: '', bucket: '', accessKey: '', prefix: '', enabled: false }\r\n        baseline = {}\r\n        manifestCache = null\r\n        stopAuto()\r\n        markDirty()\r\n        void api.store.set(KEY_BASELINE, {}).catch(() => {})\r\n        api.host.notify('已断开 S3 并清除密钥')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      if (settings.backend === 'git') {\r\n        try {\r\n          await api.host.secrets.delete(SECRET_GIT_KEY)\r\n        } catch (e) {\r\n          api.host.log('warn', `删除 Git 令牌失败：${String(e)}`)\r\n        }\r\n        savedGitToken = null\r\n        settings = { ...settings, owner: '', repo: '', enabled: false }\r\n        baseline = {}\r\n        manifestCache = null\r\n        stopAuto()\r\n        markDirty()\r\n        void api.store.set(KEY_BASELINE, {}).catch(() => {})\r\n        api.host.notify('已断开 Git 并清除令牌')\r\n        api.view.refresh()\r\n        return\r\n      }\r\n      try {\r\n        await api.host.secrets.delete(SECRET_KEY)\r\n      } catch (e) {\r\n        api.host.log('warn', `删除凭据失败：${String(e)}`)\r\n      }\r\n      savedPasswords.clear()\r\n      // 保留 backend / auto / attachments：以前整体覆盖会把「当前是哪个后端」冲掉\r\n      settings = { ...settings, baseUrl: '', username: '', root: '', enabled: false }\r\n      baseline = {}\r\n      manifestCache = null\r\n      markDirty()\r\n      void api.store.set(KEY_BASELINE, {}).catch(() => {})\r\n      api.host.notify('已断开 WebDAV 并清除密码')\r\n      api.view.refresh()\r\n    })\r\n\r\n    void (async () => {\r\n      try {\r\n        settings = { ...settings, ...((await api.store.get(KEY_SETTINGS, {})) ?? {}) }\r\n        /**\r\n         * 基线**按当前后端取**（rev173.286）：webdav 的 fp 是远端内容、folder 的是磁盘内容，\r\n         * 混用会让第一次判定把「自家刚同步过的文件」当成外部改动 —— 各存一份互不干扰。\r\n         */\r\n        baseline = (await api.store.get(baselineKey(), {})) ?? {}\r\n        conflicts = (await api.store.get(KEY_CONFLICTS, [])) ?? []\r\n        timingHistory = (await api.store.get(KEY_TIMING, [])) ?? []\r\n        if (settings.backend === 'folder') await folder.load()\r\n      } catch (e) {\r\n        api.host.log('warn', `同步设置读取失败：${String(e)}`)\r\n      }\r\n      ready = true\r\n      api.view.refresh()\r\n\r\n      if (settings.backend === 'folder') {\r\n        // 文件夹后端：事件 + 5 秒结算。**不判 baseUrl** —— 它根本不需要远端地址\r\n        folder.attach()\r\n      } else if (hasConfig() && settings.auto !== false) {\r\n        // 已配置且没关自动 ⇒ 起来就开始近实时\r\n        startAuto()\r\n      }\r\n\r\n      // 切回前台立刻补一次（后台期间定时器被挂起，不能只靠 5 秒节拍）\r\n      const onVisible = () => {\r\n        if (typeof document === 'undefined' || document.visibilityState !== 'visible') return\r\n        // 文件夹后端的补扫由它自己的 visibilitychange 监听负责（见 folder.attach）\r\n        if (settings.backend === 'folder') return\r\n        if (!hasConfig()) return\r\n        void runSync('回到前台', { silent: true })\r\n      }\r\n      if (typeof document !== 'undefined') document.addEventListener('visibilitychange', onVisible)\r\n      api.subscriptions.push({\r\n        dispose: () => {\r\n          if (typeof document !== 'undefined') document.removeEventListener('visibilitychange', onVisible)\r\n        },\r\n      })\r\n\r\n      const backendLabel =\r\n        settings.backend === 'folder'\r\n          ? '本地文件夹'\r\n          : settings.backend === 's3'\r\n            ? `S3 ${hasConfig() ? '已配置' : '未配置'}`\r\n            : `WebDAV ${settings.baseUrl ? '已配置' : '未配置'}`\r\n      api.host.log(\r\n        'info',\r\n        `同步插件就绪（${platform} · ${backendLabel}，自动=${settings.auto !== false}，ready=${ready}）`,\r\n      )\r\n    })()\r\n  },\r\n}\r\n\r\nmodule.exports = plugin\r\n/** 纯函数转发（单测里 `const { fingerprint } = plugin` 那样取；引擎内部直接用 core） */\r\nObject.assign(module.exports, core, {\r\n  createDavClient,\r\n  createFolderBackend,\r\n  createS3Client,\r\n  createS3Storage,\r\n  createGitClient,\r\n  createGitStorage,\r\n  PROVIDERS,\r\n  b64encode,\r\n  b64decode,\r\n  b64encodeBytes,\r\n  b64decodeBytes,\r\n  encodeGitPath,\r\n  parseContents,\r\n})\r\n/** S3 的纯函数（单测里按名取：SigV4 用 AWS 官方向量验证，不是自签自验） */\r\nObject.assign(module.exports, {\r\n  amzDate,\r\n  amzDay,\r\n  canonicalHeaders,\r\n  canonicalQuery,\r\n  encodeRfc3986,\r\n  encodeS3Path,\r\n  hmacSha256,\r\n  parseListObjects,\r\n  sha256Hex,\r\n  signRequest,\r\n  toHex,\r\n})\r\n",
    "lib/backends/folder.cjs": "/**\n * 同步后端 · 本地文件夹（folder）—— rev173.286（从 `examples/sync-folder` 并入）\n *\n * ## 它做什么、不做什么\n *\n * **不搬文件**。库本身放在用户自己的同步目录里（Syncthing / OneDrive / 坚果云客户端 /\n * 局域网 SMB），搬运交给那个工具。这个后端只做那三件同步工具**不做**的事：\n *   ① 发现「别人改了我的笔记」（内核的 `note:changed` 已过滤自写回响，直接可用）\n *   ② 判定「双端都改了」（本机在某次外部改动之前也保存过 ⇒ 冲突）\n *   ③ 冲突留副本到 `.zn/conflicts/<平台>/`，绝不静默丢弃任何一边\n *\n * ## 与 WebDAV 后端的差别\n *\n * | | webdav / s3 / git | folder |\n * |---|---|---|\n * | 谁搬文件 | 插件自己发请求 | 外部同步工具 |\n * | 触发 | 每 5 秒轮询远端 | 内核事件 + 启动 / 回前台补扫 |\n * | 「同步成功」怎么算 | 远端 manifest 里有这份新指纹 | 本机保存后过了静默期没被外部动过 |\n * | 本机版在哪 | 拉取前磁盘上那份 | 影子副本 `.zn/sync/last/<hash>.md` |\n *\n * ## 判定模型（这是整个后端的心脏）\n *\n * 三种状态：\n *   · `state.baseline[path] = { fp, at }` —— **双方一致**的版本（最后一次确认同步的内容指纹）\n *   · `pending[path]        = { fp, at }` —— 本机改过、**还没确认被同步工具搬走**的版本\n *   · `state.conflicts[]`                  —— 冲突记录（面板展示、可处理）\n *\n * 为什么不能在本机保存时直接更新 baseline：那样「本机改完、同步还没传出去、对端又改了」\n * 就会变成「只有外部变了」⇒ 本地改动被静默覆盖。所以保存只写 pending，\n * **等 `SETTLE_MS` 静默期**（默认 20 秒，够 Syncthing 传一轮）才升为 baseline。\n *\n * 判定函数是 `lib/core.cjs` 的 `classifyChange`（纯函数，单测覆盖）。\n *\n * ## 冲突副本\n *\n * 本机修改的正文在 `note:saved` 时**另存一份**到 `<库>/.zn/sync/last/<hash32(path)>.md`\n * （库外的影子副本，不进文件树）—— 因为磁盘被外部覆盖之后，本地版就只活在这里。\n * 冲突时把它复制成 `<库>/.zn/conflicts/<平台>/<YYYY-MM-DD HHmm>-<文件名>`。\n *\n * ⚠️ `.zn/` **必须**在同步工具的排除列表里，否则私有快照也会被同步（面板会提醒）。\n */\nconst {\n  CONFLICT_ROOT,\n  KEY_PENDING: _UNUSED_KEY_PENDING,\n  MAX_CONFLICTS,\n  SECRET_DIRS,\n  SETTLE_MS,\n  SNAPSHOT_DIR,\n  TICK_MS,\n  classifyChange,\n  fingerprint,\n  fmtMs,\n  isSyncable,\n  looksLikeSyncConflict,\n  snapshotPath,\n  tryAutoMerge,\n} = require('../core.cjs')\n\n/** 待同步记录（本后端专属，与 webdav 的 `baseline.v1` 分开存） */\nconst KEY_PENDING = 'folder.pending.v1'\n\n/**\n * 建一个本地文件夹后端。\n *\n * @param {object} args\n * @param {any} args.api            插件 api（`fs` / `event` / `store` / `host` / `view` / `service` / `subscriptions`）\n * @param {'windows'|'android'} args.platform\n * @param {object} args.state       引擎的可变状态（getter/setter 直通）：`{ baseline, conflicts, settings }`\n * @param {object} args.hooks       `{ keepConflict, markBase, refresh, persistBaseline, persistSettings }`\n */\nfunction createFolderBackend({ api, platform, state, hooks }) {\n  const conflictDir = `${CONFLICT_ROOT}/${platform}`\n\n  /** 本机改过、还没确认被同步工具搬走的版本（落盘 `KEY_PENDING`） */\n  let pending = {}\n  /** `.zn/` 被外部同步工具碰过的痕迹（rev173.114）：命中的文件路径 */\n  let znHits = []\n  /** 密码库私有目录里的冲突副本（rev173.164）：说明两端都改过密码库 */\n  let secretHits = []\n  /** 最近一次 `.zn/` 检查时间（0 = 还没查过） */\n  let znCheckedAt = 0\n  let lastScanAt = 0\n  /** 上一次全库扫描花了多久（rev173.117：本地没有网络往返，但库大时一样会卡） */\n  let lastScanMs = 0\n  /** 扫描中（防重入） */\n  let scanning = false\n  /** 本进程自动合并成功的次数（面板显示） */\n  let mergedCount = 0\n  let ready = false\n  /** 脏标记：pending 有变化才写 store（5 秒节拍里大多数轮次什么都不干） */\n  let dirty = false\n  let attached = false\n\n  /**\n   * **内存里的本机版**（rev173.133）。\n   *\n   * `note:saved` 的判定段是同步的，但影子副本落盘要 `await`。这段窗口里若真来冲突，\n   * 磁盘上还没有影子副本 ⇒ `keepConflict` 会标「本机版未留存」（假 `lost`）。\n   * 正文先留在内存，`readShadow` 优先读它；落盘成功再清掉。\n   */\n  const shadowMem = new Map()\n  /** 事件与定时器的 dispose 句柄（`detach` 时全部释放） */\n  const cleanups = []\n\n  /* ── 落盘 ── */\n\n  async function persistPending() {\n    dirty = false\n    try {\n      await api.store.set(KEY_PENDING, pending)\n    } catch (e) {\n      api.host.log('warn', `待同步记录写入失败：${String(e)}`)\n    }\n  }\n\n  const markDirty = () => {\n    dirty = true\n  }\n\n  /* ── 影子副本 ── */\n\n  /** 影子副本落盘（失败只记日志：`readShadow` 还有内存兜底，不会丢内容） */\n  async function writeShadow(path, text) {\n    try {\n      await api.fs.mkdir(SNAPSHOT_DIR)\n      await api.fs.writeText(snapshotPath(path), text)\n      shadowMem.delete(path)\n    } catch (e) {\n      api.host.log('warn', `影子副本写入失败 ${path}：${String(e)}`)\n    }\n  }\n\n  /** 读本机版（影子副本）—— 冲突时 `mine` 的来源：内存优先，其次磁盘 */\n  async function readShadow(path) {\n    const cached = shadowMem.get(path)\n    if (typeof cached === 'string') return cached\n    try {\n      return await api.fs.readText(snapshotPath(path))\n    } catch {\n      return null\n    }\n  }\n\n  /**\n   * 冲突时试着合：base = history 同步点，mine = 影子副本，theirs = 磁盘外部版。\n   * 任何一环缺失都返回 `null`（退回「留副本」流程，不丢字）。\n   */\n  async function autoMerge(path, theirs) {\n    try {\n      const [hist, merger] = await Promise.all([\n        api.service.consume('history'),\n        api.service.consume('kernel.merge'),\n      ])\n      if (!hist?.findBase || !merger?.mergeLines) return null\n      const [mine, base] = await Promise.all([\n        readShadow(path),\n        hist.findBase(path, { tag: 'sync:folder' }),\n      ])\n      if (typeof mine !== 'string' || typeof base !== 'string') return null\n      return tryAutoMerge({ base, mine, theirs, mergeLines: merger.mergeLines })\n    } catch (e) {\n      api.host.log('warn', `自动合并失败（${path}）：${String(e)}`)\n      return null\n    }\n  }\n\n  /**\n   * 把合并结果写回磁盘并把基线对齐它（调用方已确认 0 处真冲突）。\n   *\n   * 不需要「自写抑制表」：内核能区分「用户保存」与「插件写盘」（`fs.writeText` 的\n   * `origin`），插件写盘不发 `note:saved`；随后 Rust watcher 那条 `note:changed` 不带\n   * origin，会照常走判定 —— 此时基线已对齐 ⇒ 走 `noop` 分支静默返回。\n   *\n   * @returns {Promise<boolean>} 是否成功（失败 ⇒ 调用方退回留副本）\n   */\n  async function applyMerged(path, text) {\n    const fp = fingerprint(text)\n    try {\n      await api.fs.writeText(path, text)\n    } catch (e) {\n      api.host.log('warn', `合并结果落盘失败（${path}）：${String(e)}`)\n      return false\n    }\n    state.baseline[path] = { fp, at: Date.now() }\n    delete pending[path]\n    shadowMem.delete(path)\n    void api.fs.purgePrivate(snapshotPath(path)).catch(() => {})\n    markDirty()\n    void hooks.persistBaseline()\n    void hooks.markBase(path, text)\n    mergedCount += 1\n    api.host.notify(`已自动合并：${path}`, 'info')\n    hooks.refresh()\n    return true\n  }\n\n  /* ── 事件处理 ── */\n\n  /**\n   * 本机保存（用户编辑）：记 pending + 存影子副本，**不动 baseline**。\n   *\n   * 判定段**不放 `await`**。内核随事件带 `text`，于是「算指纹 → 记 pending」全在同步段完成；\n   * watcher 回响（`note:changed`）的处理体不可能插到中间去把基线对齐掉\n   * （`note:saved` 总是先于回响派发）。\n   *\n   * 为什么非要同步：以前这里是 `await readText` 开头。回响若在这段 `await` 中间跑完判定，\n   * pending 还没建 ⇒ 磁盘新、基线旧 ⇒ 判 `remote`（当成「别处更新」）、基线对齐新内容；\n   * 随后本函数醒来看到 `baseline.fp === 当前 fp` 直接早退 ⇒ 这次改动既没有 pending\n   * 也没有影子副本，**永远同步不出去**（rev173.116 实测记下，rev173.133 修）。\n   */\n  function onSaved(payload) {\n    const path = String(payload?.path ?? '')\n    if (!isSyncable(path)) return\n\n    const remember = (text) => {\n      const fp = fingerprint(text)\n      if (state.baseline[path]?.fp === fp) return // 保存了但内容没变\n      pending[path] = { fp, at: Date.now() }\n      shadowMem.set(path, text)\n      markDirty()\n      hooks.refresh()\n      void writeShadow(path, text)\n    }\n\n    const given = typeof payload?.text === 'string' ? payload.text : null\n    if (given !== null) {\n      remember(given)\n      return\n    }\n\n    void (async () => {\n      let text\n      try {\n        text = await api.fs.readText(path)\n      } catch {\n        return\n      }\n      remember(text)\n    })()\n  }\n\n  /**\n   * 本机新建：直接进基线（新文件没有「双方」可言）。\n   *\n   * 新内核下「种基线 + 打同步点」在**同步段**里完成，watcher 的 `note:changed`\n   * 回响插不进来；旧内核（事件不带 `text`）退回读盘版本，不因版本差异静默失效。\n   */\n  function onCreated(payload) {\n    const path = String(payload?.path ?? '')\n    if (!isSyncable(path)) return\n\n    const adopt = (text) => {\n      if (state.baseline[path]) return\n      state.baseline[path] = { fp: fingerprint(text), at: Date.now() }\n      markDirty()\n      // 新建即「两端一致」（外部还没有这篇），同步点可以马上种下\n      void hooks.markBase(path, text)\n      void hooks.persistBaseline()\n      hooks.refresh()\n    }\n\n    const given = typeof payload?.text === 'string' ? payload.text : null\n    if (given !== null) {\n      adopt(given)\n      return\n    }\n\n    void (async () => {\n      try {\n        adopt(await api.fs.readText(path))\n      } catch {\n        /* 读不到就等下一次扫描 */\n      }\n    })()\n  }\n\n  /** 本机删除：只记「待同步的删除」，等外部确认 */\n  function onDeleted(payload) {\n    const path = String(payload?.path ?? '')\n    if (!isSyncable(path)) return\n    pending[path] = { deleted: true, at: Date.now() }\n    markDirty()\n    hooks.refresh()\n  }\n\n  /** 本机改名：基线跟过去（旧路径的基线删掉） */\n  function onRenamed(payload) {\n    const from = String(payload?.from ?? '')\n    const to = String(payload?.to ?? '')\n    if (!from || !to) return\n    if (state.baseline[from]) {\n      state.baseline[to] = { fp: state.baseline[from].fp, at: Date.now() }\n      delete state.baseline[from]\n    }\n    delete pending[from]\n    delete pending[to]\n    shadowMem.delete(from) // 改名前那份影子副本再也对不上路径（哈希跟着 path 走）\n    markDirty()\n    void hooks.persistBaseline()\n    hooks.refresh()\n  }\n\n  /** 外部改动（别的程序 / 同步工具改盘）—— 判定核心 */\n  function onChanged(payload) {\n    void (async () => {\n      const path = String(payload?.path ?? '')\n      const kind = String(payload?.kind ?? 'modify')\n      /**\n       * **插件自己写盘不算外部改动**（rev173.120）：内核给插件口发 `note:changed` 时带\n       * `origin: 'plugin'`（合并结果落盘就是这条）。这类写入的基线 / pending 已由发起方\n       * 对齐过，再走一遍判定只会制造假冲突。\n       *\n       * Rust watcher 那条 `note:changed` 不带 origin —— 它是「磁盘真变了」，\n       * 仍然照常判定（此时基线已对齐 ⇒ 走 `noop` 分支静默返回）。\n       */\n      if (payload?.origin === 'plugin') return\n      if (!isSyncable(path)) return\n\n      if (kind === 'delete') {\n        const p = pending[path]\n        if (p && !p.deleted) {\n          // 本地改过、外面删了 ⇒ 本地版留副本\n          const localText = await readShadow(path)\n          await hooks.keepConflict(path, '外部删除', { localText })\n          delete pending[path]\n        }\n        delete state.baseline[path]\n        markDirty()\n        void hooks.persistBaseline()\n        hooks.refresh()\n        return\n      }\n\n      let text\n      try {\n        text = await api.fs.readText(path)\n      } catch {\n        return // 刚被删掉，等下一个事件\n      }\n      const remoteFp = fingerprint(text)\n      const base = state.baseline[path]\n      const p = pending[path]\n      const verdict = classifyChange({ base, pending: p, remoteFp })\n      const now = Date.now()\n\n      if (verdict === 'noop') {\n        /**\n         * 磁盘内容 == pending ⇒ 两种可能，**都什么也不做**：\n         *   a) 就是我们自己刚那次保存被 watcher 看见了（自写抑制偶尔漏）；\n         *   b) 同步工具把我们那版搬了回来。\n         * 两者在内容上无法区分，正确处理都是「保持 pending」—— 让静默期再把它升为基线。\n         * **绝不能在这里清 pending**：清了之后同一篇再出现真冲突就判不出来了\n         * （rev173.107 实测踩过：清得太早 ⇒ 双端修改被当成普通外部更新）。\n         */\n        return\n      }\n      if (verdict === 'conflict') {\n        /**\n         * 先试**三方合并**（rev173.116）：base = history 同步点，mine = 影子副本，\n         * theirs = 磁盘外部版。合上（0 处真冲突）⇒ 磁盘写合并结果、基线对齐它，本机版不丢。\n         * 合不上 / 没 base ⇒ 原流程：本机版留副本、基线对齐外部版。\n         */\n        const merged = await autoMerge(path, text)\n        if (merged && (await applyMerged(path, merged.text))) return\n        await hooks.keepConflict(path, '双端修改', { localText: await readShadow(path) })\n      }\n      // new / remote / conflict / local-pending：磁盘上是外部版，基线对齐它\n      if (verdict !== 'local-pending') {\n        state.baseline[path] = { fp: remoteFp, at: now }\n        delete pending[path]\n        // 本机版若还有价值，已经在上面的 keepConflict 里留了副本；内存那份不再需要\n        shadowMem.delete(path)\n        markDirty()\n        void hooks.persistBaseline()\n        // 对齐之后两端一致 ⇒ 这是下次冲突要用的「共同祖先」\n        void hooks.markBase(path, text)\n      }\n      hooks.refresh()\n    })()\n  }\n\n  /**\n   * 把磁盘当前状态整体设成基线：用户手动确认「现在两边是一致的」。\n   *\n   * 本地文件夹后端没有远端可对齐，所以「设为基线」＝「我现在相信这些文件已经同步过了」。\n   */\n  async function markSynced() {\n    try {\n      const notes = await api.fs.listNotes()\n      const next = {}\n      const now = Date.now()\n      for (const n of notes) {\n        if (!isSyncable(n.path)) continue\n        try {\n          next[n.path] = { fp: fingerprint(await api.fs.readText(n.path)), at: now }\n        } catch {\n          /* 读不到就跳过 */\n        }\n      }\n      state.baseline = next\n      pending = {}\n      lastScanAt = now\n      await hooks.persistBaseline()\n      await persistPending()\n      hooks.refresh()\n      api.host.notify(`已把 ${Object.keys(next).length} 篇设为同步基线`)\n      return { count: Object.keys(next).length }\n    } catch (e) {\n      api.host.notify(`设置基线失败：${String(e)}`, 'error')\n      return { error: String(e) }\n    }\n  }\n\n  /**\n   * 扫 `.zn/` 的两个已知目录，看有没有**外部同步工具**留下的冲突副本（rev173.114）。\n   *\n   * 为什么只查这两处：影子副本（`SNAPSHOT_DIR`）与冲突副本（`conflictDir`）是会频繁写入的\n   * 私有目录，同步工具没排除 `.zn/` 时最容易在这里「打架」。`listFiles` 不递归、目录不存在\n   * 返回空表，所以调用方不用先判存在。\n   */\n  async function znSyncTrace() {\n    const dirs = [SNAPSHOT_DIR, conflictDir]\n    const hits = []\n    for (const d of dirs) {\n      let files = []\n      try {\n        files = await api.fs.listFiles(d)\n      } catch {\n        continue\n      }\n      for (const f of files) {\n        const base = f.slice(f.lastIndexOf('/') + 1)\n        if (looksLikeSyncConflict(base)) hits.push(f)\n      }\n    }\n    return hits\n  }\n\n  /**\n   * **密码库私有目录的冲突副本**（rev173.164）。\n   *\n   * folder 后端自己不搬文件 —— 是不是「同步得出去」完全看外部工具的排除列表。\n   * 能做的只有两件事：① 给出放行规则 ② 一旦发现密码库出现冲突副本就**明确报警**\n   * （那意味着两端都改过密码库，用户必须自己挑一份 —— 密码库没法三方合并）。\n   *\n   * ⚠️ 这两个目录里出现冲突副本，**不是**「同步工具没排除 `.zn/`」那个错 ——\n   * 恰恰相反，它是用户**按提示放行**之后才可能的正常现象，只是说明碰上双端改。\n   */\n  async function znSecretConflictHits() {\n    const hits = []\n    for (const d of SECRET_DIRS) {\n      let files = []\n      try {\n        files = await api.fs.listFiles(d)\n      } catch {\n        continue\n      }\n      for (const f of files) {\n        const base = f.slice(f.lastIndexOf('/') + 1)\n        if (looksLikeSyncConflict(base)) hits.push(f)\n      }\n    }\n    return hits\n  }\n\n  async function refreshZnTrace() {\n    znHits = await znSyncTrace()\n    secretHits = await znSecretConflictHits()\n    znCheckedAt = Date.now()\n    hooks.refresh()\n    return znHits\n  }\n\n  /* ── 全库扫描（补事件收不到的那些：App 关着的时候同步工具改了文件） ── */\n\n  async function scan(reason = '手动检查') {\n    if (scanning) return { skipped: true }\n    scanning = true\n    const t0 = Date.now()\n    const result = { updated: 0, removed: 0, conflicts: 0, merged: 0 }\n    try {\n      const notes = await api.fs.listNotes()\n      const seen = new Set()\n      for (const n of notes) {\n        if (!isSyncable(n.path)) continue\n        seen.add(n.path)\n        let text\n        try {\n          text = await api.fs.readText(n.path)\n        } catch {\n          continue\n        }\n        const fp = fingerprint(text)\n        const base = state.baseline[n.path]\n        const p = pending[n.path]\n\n        if (!base && !p) {\n          state.baseline[n.path] = { fp, at: Date.now() }\n          // 首次见到 ⇒ 种一个同步点，下次真冲突才有 base 可用\n          void hooks.markBase(n.path, text)\n          result.updated += 1\n          continue\n        }\n        if (base && base.fp === fp) {\n          /**\n           * 基线没变 ⇒ 顺便保证**同步点存在**（rev173.116）：老用户升级前没有 base，\n           * 第一次真冲突会退化成「留两份」。`markBase` 内部先比对内容，没变不会写盘。\n           */\n          void hooks.markBase(n.path, text)\n          continue\n        }\n        // 磁盘与基线不符：可能是外部更新，也可能是双端都改\n        const verdict = classifyChange({ base, pending: p, remoteFp: fp })\n        if (verdict === 'conflict') {\n          // rev173.116：先试三方合并；合上就不进冲突统计\n          const merged = await autoMerge(n.path, text)\n          if (merged && (await applyMerged(n.path, merged.text))) {\n            result.merged += 1\n            result.updated += 1\n            continue\n          }\n          await hooks.keepConflict(n.path, reason, { localText: await readShadow(n.path) })\n          result.conflicts += 1\n        }\n        state.baseline[n.path] = { fp, at: Date.now() }\n        delete pending[n.path]\n        shadowMem.delete(n.path)\n        void hooks.markBase(n.path, text)\n        result.updated += 1\n      }\n\n      // 基线里还有、磁盘上已经没有 ⇒ 外部删除\n      for (const path of Object.keys(state.baseline)) {\n        if (seen.has(path)) continue\n        const p = pending[path]\n        if (p && !p.deleted) {\n          await hooks.keepConflict(path, '外部删除', { localText: await readShadow(path) })\n          result.conflicts += 1\n        }\n        delete state.baseline[path]\n        delete pending[path]\n        shadowMem.delete(path)\n        result.removed += 1\n      }\n\n      lastScanAt = Date.now()\n      lastScanMs = Date.now() - t0\n      markDirty()\n      void hooks.persistBaseline()\n      return result\n    } finally {\n      scanning = false\n      hooks.refresh()\n    }\n  }\n\n  /**\n   * 结算 pending：本机保存后过了静默期还没被外部动过 ⇒ 认为同步工具已传走。\n   * 影子副本此时可以清掉（冲突判定已经不需要它了）。\n   */\n  function settle() {\n    const now = Date.now()\n    let changed = false\n    for (const [path, p] of Object.entries(pending)) {\n      if (now - p.at < SETTLE_MS) continue\n      if (p.deleted) {\n        delete state.baseline[path]\n      } else {\n        state.baseline[path] = { fp: p.fp, at: p.at }\n        void api.fs.purgePrivate(snapshotPath(path)).catch(() => {})\n      }\n      delete pending[path]\n      shadowMem.delete(path)\n      changed = true\n    }\n    if (changed) {\n      markDirty()\n      void hooks.persistBaseline()\n      hooks.refresh()\n    }\n  }\n\n  /**\n   * 处理一条冲突（folder 版）。\n   *\n   * · `local`  —— 把副本内容写回笔记（磁盘现在是外部版，写回＝覆盖），基线对齐写回的内容。\n   *              写盘走 `api.fs.writeText`（插件 origin），不会触发 `note:saved`。\n   * · `remote` —— 磁盘上已经是外部版，什么都不用写，只删副本 + 清记录。\n   *\n   * @param {{path?: string, file?: string|null, choice?: 'local'|'remote'}} payload\n   */\n  async function resolveConflict(payload) {\n    const path = String(payload?.path ?? '')\n    const file = payload?.file ? String(payload.file) : null\n    const choice = payload?.choice === 'local' ? 'local' : 'remote'\n    const idx = state.conflicts.findIndex((c) => c.path === path && c.platform === platform)\n    const rec = idx >= 0 ? state.conflicts[idx] : null\n\n    if (!rec && !file) {\n      api.host.notify('这条冲突记录找不到了', 'warn')\n      return { error: 'no-record' }\n    }\n\n    const notePath = rec?.path || path\n    let kept = false\n    if (choice === 'local') {\n      if (!file) {\n        api.host.notify('本机版没有留存，只能用远端版', 'warn')\n        return { error: 'no-copy' }\n      }\n      let text\n      try {\n        text = await api.fs.readText(`${conflictDir}/${file}`)\n      } catch (e) {\n        api.host.notify(`读不到冲突副本：${String(e)}`, 'error')\n        return { error: String(e) }\n      }\n      try {\n        await api.fs.writeText(notePath, text)\n      } catch (e) {\n        api.host.notify(`写回失败：${String(e)}`, 'error')\n        return { error: String(e) }\n      }\n      state.baseline[notePath] = { fp: fingerprint(text), at: Date.now() }\n      delete pending[notePath]\n      shadowMem.delete(notePath)\n      kept = true\n      void hooks.persistBaseline()\n      await persistPending()\n      void hooks.markBase(notePath, text)\n    }\n\n    if (file) {\n      try {\n        await api.fs.delete(`${conflictDir}/${file}`)\n      } catch (e) {\n        api.host.log('debug', `删冲突副本失败 ${file}：${String(e)}`)\n      }\n    }\n    if (idx >= 0) state.conflicts.splice(idx, 1)\n    void api.store.set('conflicts.v1', state.conflicts).catch(() => {})\n    hooks.refresh()\n    api.host.notify(kept ? `已用本机版覆盖：${notePath}` : `已保留远端版：${notePath}`)\n    return { ok: true, kept }\n  }\n\n  /* ── 开关 / 调度 ── */\n\n  async function toggleAuto() {\n    state.settings.auto = state.settings.auto === false\n    void hooks.persistSettings()\n    api.host.notify(\n      state.settings.auto\n        ? '自动检查已开启（每 5 秒结算一次；启动 / 回前台各补扫一次）'\n        : '自动检查已关闭（「立即检查」仍可用；停用期间的改动照常记账，重新启用时一起处理）',\n    )\n    hooks.refresh()\n    if (state.settings.auto) void scan('启用后检查')\n  }\n\n  /**\n   * 挂上事件与定时器。\n   *\n   * 只有当前后端是 folder 时才调用：webdav 模式下若也挂 `note:saved` 监听，\n   * 每次用户保存都会写一份影子副本（白占磁盘，且与 webdav 的基线语义打架）。\n   */\n  function attach() {\n    if (attached) return\n    attached = true\n\n    const on = (topic, cb) => {\n      const sub = api.event.on(topic, cb)\n      if (sub) {\n        cleanups.push(() => sub.dispose())\n        // 同时挂进插件的订阅总表：`detach` 之外，内核卸载插件时也会自动释放\n        api.subscriptions.push(sub)\n      }\n    }\n    on('note:saved', onSaved)\n    on('note:created', onCreated)\n    on('note:deleted', onDeleted)\n    on('note:renamed', onRenamed)\n    on('note:changed', onChanged)\n\n    const timer = window.setInterval(() => {\n      // 停用只停「结算」；事件照常记账，所以这里仍然要落盘\n      if (state.settings.auto !== false) settle()\n      if (dirty) void persistPending()\n    }, TICK_MS)\n    cleanups.push(() => window.clearInterval(timer))\n    api.subscriptions.push({ dispose: () => window.clearInterval(timer) })\n\n    // 启动后先扫一遍：App 关着的时候同步工具可能已经改过文件（事件收不到）\n    const boot = setTimeout(() => {\n      if (state.settings.auto !== false) void scan('启动检查')\n    }, 1500)\n    cleanups.push(() => clearTimeout(boot))\n    api.subscriptions.push({ dispose: () => clearTimeout(boot) })\n\n    // 切回前台再补一次（手机后台定时器会被挂起）\n    if (typeof document !== 'undefined') {\n      const onVisible = () => {\n        if (state.settings.auto === false) return\n        if (document.visibilityState === 'visible') void scan('回到前台')\n      }\n      document.addEventListener('visibilitychange', onVisible)\n      cleanups.push(() => document.removeEventListener('visibilitychange', onVisible))\n      api.subscriptions.push({\n        dispose: () => document.removeEventListener('visibilitychange', onVisible),\n      })\n    }\n\n    void refreshZnTrace()\n    api.host.log(\n      'info',\n      `同步插件就绪（${platform} · 本地文件夹，自动=${state.settings.auto !== false}）：基线 ${Object.keys(state.baseline).length} 篇`,\n    )\n  }\n\n  function detach() {\n    if (!attached) return\n    attached = false\n    while (cleanups.length > 0) {\n      const fn = cleanups.pop()\n      try {\n        fn()\n      } catch {\n        /* 释放失败不影响切换 */\n      }\n    }\n    shadowMem.clear()\n  }\n\n  /** 读 store（引擎在切到 folder 后端 / 启动时调一次） */\n  async function load() {\n    try {\n      pending = (await api.store.get(KEY_PENDING, {})) ?? {}\n    } catch (e) {\n      api.host.log('warn', `待同步记录读取失败：${String(e)}`)\n      pending = {}\n    }\n    ready = true\n  }\n\n  /** 面板用的统计数字 */\n  function stats() {\n    return {\n      baseline: Object.keys(state.baseline).length,\n      pending: Object.keys(pending).length,\n      conflicts: state.conflicts.length,\n      merged: mergedCount,\n      znHits,\n      secretHits,\n      znCheckedAt,\n      lastScanAt,\n      lastScanMs,\n      enabled: state.settings.auto !== false,\n      scanning,\n      ready,\n    }\n  }\n\n  /** 面板区块（folder 后端的特有几块：说明 / `.zn` 提醒 / 统计 / 按钮 / 上次检查） */\n  function renderSection() {\n    const s = stats()\n    const children = [\n      {\n        type: 'text',\n        value: '库放在同步目录里，搬运交给 Syncthing / OneDrive / 坚果云；这里只盯冲突。',\n        variant: 'caption',\n        tone: 'muted',\n      },\n      {\n        type: 'text',\n        value: s.znHits.length\n          ? `⚠ .zn/ 疑似被同步工具处理过：找到 ${s.znHits.length} 个冲突副本（${s.znHits[0]}）—— 请在同步工具里把 .zn/ 排除掉`\n          : s.znCheckedAt\n            ? `.zn/ 没发现同步冲突痕迹（${new Date(s.znCheckedAt).toLocaleTimeString()} 查过）—— 仍请确认同步工具的排除列表里有 .zn/`\n            : '请确认同步工具的排除列表里有 .zn/：历史版本、影子副本、冲突副本都放在里面，不该被搬来搬去。',\n        variant: 'caption',\n        tone: s.znHits.length ? 'danger' : 'muted',\n      },\n      ...(s.secretHits.length\n        ? [\n            {\n              type: 'text',\n              value: `⚠ 密码库有 ${s.secretHits.length} 份同步冲突副本（${s.secretHits[0]}）—— 两端都改过密码库，请手动挑一份用（密文没法自动合并）`,\n              variant: 'caption',\n              tone: 'danger',\n            },\n          ]\n        : []),\n      { type: 'spacer', size: 'sm' },\n      {\n        type: 'row',\n        gap: 'sm',\n        wrap: true,\n        children: [\n          {\n            type: 'badge',\n            text: s.enabled ? '自动检查：开' : '自动检查：关',\n            tone: s.enabled ? 'success' : 'warn',\n          },\n          { type: 'badge', text: `基线 ${s.baseline} 篇`, tone: 'default' },\n          {\n            type: 'badge',\n            text: `待同步 ${s.pending} 篇`,\n            tone: s.pending > 0 ? 'warn' : 'default',\n          },\n          {\n            type: 'badge',\n            text: `冲突 ${s.conflicts}`,\n            tone: s.conflicts > 0 ? 'danger' : 'success',\n          },\n          // rev173.116：双端改同一篇时自动合上的次数（本进程）\n          ...(s.merged > 0 ? [{ type: 'badge', text: `合并 ${s.merged}`, tone: 'success' }] : []),\n          ...(s.scanning ? [{ type: 'badge', text: '正在检查…', tone: 'warn' }] : []),\n        ],\n      },\n      { type: 'spacer', size: 'sm' },\n      {\n        type: 'row',\n        gap: 'sm',\n        wrap: true,\n        children: [\n          { type: 'button', label: '立即检查', onClick: 'sync.run', disabled: s.scanning },\n          { type: 'button', label: '把当前设为基线', onClick: 'sync.mark-baseline', variant: 'ghost' },\n          {\n            type: 'button',\n            label: s.enabled ? '停用自动检查' : '启用自动检查',\n            onClick: 'sync.toggle-auto',\n            variant: 'ghost',\n          },\n        ],\n      },\n      {\n        type: 'text',\n        value: s.lastScanAt\n          ? `上次检查：${new Date(s.lastScanAt).toLocaleString()}（用时 ${fmtMs(s.lastScanMs)}）`\n          : '上次检查：还没检查过',\n        variant: 'caption',\n        tone: 'muted',\n      },\n    ]\n    return children\n  }\n\n  return {\n    attach,\n    detach,\n    load,\n    scan,\n    settle,\n    markSynced,\n    refreshZnTrace,\n    toggleAuto,\n    resolveConflict,\n    stats,\n    renderSection,\n    /** 测试用：当前 pending 表（只读快照） */\n    __pending: () => pending,\n  }\n}\n\nmodule.exports = { createFolderBackend, KEY_PENDING }\n",
    "lib/backends/git.cjs": "/**\n * 同步后端 · Git 托管（git）—— rev173.288（从 `examples/sync-git` 并入）\n *\n * 走 **仓库 Contents API**（GitHub / Gitea / Gitee），不是 git 协议：插件只有 `net` 原语，\n * 没有 git 实现，也不需要 —— 我们只需要“读一个文件 / 写一个文件 / 删一个文件”。\n *\n * 与 S3 / WebDAV 的差别：\n * · 没有目录、没有 ETag：**`sha` 就是版本号**（用它做乐观锁，与 S3 的 `If-Match` 同一个角色）\n * · 上传是 base64 进 JSON（附件必须走 raw / download_url，否则 png 会被 UTF-8 改写 —— 见 `readBytes`）\n * · 平台对“sha 不匹配”的回码不统一：GitHub 409、其它 422 / 400 ⇒ 一律按冲突处理\n *\n * 引擎侧完全复用（`get` / `put` / `readManifest` / `writeManifest` 同一套方法名），\n * 本文件的 `createGitStorage` 就是把 Contents 客户端适配成那套名字。\n */\nconst { MANIFEST_REL, normalizeManifest } = require('../core.cjs')\n\n/** manifest 在仓库内的落点（与 WebDAV / S3 同一个文件） */\nconst MANIFEST_PATH = MANIFEST_REL\n/** 平台预设：API 根 + 写方法 + 认证方式 */\nconst PROVIDERS = {\n  github: { label: 'GitHub', api: 'https://api.github.com', write: 'PUT', auth: 'bearer' },\n  gitea: { label: 'Gitea / Forgejo', api: 'https://gitea.com/api/v1', write: 'PUT', auth: 'bearer' },\n  gitee: { label: 'Gitee', api: 'https://gitee.com/api/v5', write: 'POST', auth: 'token' },\n}\n\n/**\n * UTF-8 → base64。\n *\n * **不能用 `btoa(text)` 直接编**：它按 Latin-1 走，遇到中文直接抛\n * `InvalidCharacterError`（与 `sync-webdav` 的 Basic 认证同一个坑）。\n */\nfunction b64encode(text) {\n  const bytes = new TextEncoder().encode(String(text ?? ''))\n  let bin = ''\n  for (let i = 0; i < bytes.length; i += 1) bin += String.fromCharCode(bytes[i])\n  return btoa(bin)\n}\n\n/**\n * base64 → UTF-8。\n *\n * **必须先剥掉所有空白**：平台返回的大文件 base64 会每 60 字符插一个 `\\n`，\n * 不剥 `atob` 会抛 `InvalidCharacterError`。\n */\nfunction b64decode(b64) {\n  const clean = String(b64 ?? '').replace(/\\s+/g, '')\n  const bin = atob(clean)\n  const bytes = Uint8Array.from(bin, (c) => c.charCodeAt(0))\n  return new TextDecoder().decode(bytes)\n}\n\n/**\n * 字节 → base64（附件用，rev173.126）。\n *\n * `b64encode` 只吃字符串；图片 / PDF 是二进制，按 UTF-8 编会毁字节，\n * 所以这里逐字节 `String.fromCharCode` 拼出来再 `btoa`。\n */\nfunction b64encodeBytes(bytes) {\n  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes ?? [])\n  let bin = ''\n  const CHUNK = 0x8000 // 一次性拼太长的字符串在部分 WebView 上会爆栈\n  for (let i = 0; i < u8.length; i += CHUNK) {\n    bin += String.fromCharCode.apply(null, Array.from(u8.subarray(i, i + CHUNK)))\n  }\n  return btoa(bin)\n}\n\n/** base64 → 字节（先剥空白：平台返回的大文件 base64 每 60 字符一个 `\\n`） */\nfunction b64decodeBytes(b64) {\n  const clean = String(b64 ?? '').replace(/\\s+/g, '')\n  const bin = atob(clean)\n  return Uint8Array.from(bin, (c) => c.charCodeAt(0))\n}\n\n/** 库内相对路径 → URL 段（逐段编码，保留 `/`） */\nfunction encodeGitPath(path) {\n  return String(path ?? '')\n    .split('/')\n    .filter((s) => s && s !== '.')\n    .map((s) => encodeURIComponent(s))\n    .join('/')\n}\n\n/**\n * 把 Contents API 的一个条目归一成我们的形状。\n *\n * 真实响应（实测 GitHub · 2026-10-25）：\n * `{ name: 'README', sha: '980a0d5f…', size: 13, encoding: 'base64', content: 'SGVsbG8…' }`\n * 目录响应是**数组**（每项 `{ name, path, type: 'file'|'dir', sha }`，没有 content）。\n */\nfunction parseContents(entry) {\n  if (!entry || typeof entry !== 'object') return null\n  if (Array.isArray(entry)) return { dir: entry.map((e) => ({ name: e.name, path: e.path, type: e.type, sha: e.sha })) }\n  if (typeof entry.content !== 'string') return null\n  return { text: b64decode(entry.content), sha: typeof entry.sha === 'string' ? entry.sha : null }\n}\n\n/* ───────────────────────── Contents 客户端 ───────────────────────── */\n\n/**\n * @param {{ provider?: string, apiBase?: string, owner: string, repo: string, branch?: string,\n *           token: string, prefix?: string, net: object }} cfg\n */\nfunction createGitClient(cfg) {\n  const preset = PROVIDERS[cfg.provider] ?? PROVIDERS.github\n  const api = String(cfg.apiBase || preset.api).replace(/\\/+$/, '')\n  const owner = String(cfg.owner ?? '').trim()\n  const repo = String(cfg.repo ?? '').trim()\n  const branch = String(cfg.branch || 'main').trim()\n  const prefix = String(cfg.prefix ?? '').replace(/^\\/+|\\/+$/g, '')\n  const token = String(cfg.token ?? '')\n\n  /** 库内相对路径 → 仓库内路径（带 prefix） */\n  const repoPath = (p) => [prefix, p].filter(Boolean).join('/')\n\n  const headers = (extra = {}) => {\n    const h = { Accept: 'application/json', ...extra }\n    if (token) {\n      h.Authorization = preset.auth === 'bearer' ? `Bearer ${token}` : `token ${token}`\n    }\n    return h\n  }\n\n  /** 读一个文件或目录。文件 ⇒ `{ text, sha }`；目录 ⇒ `{ dir: [...] }`；不存在 ⇒ null */\n  async function read(path) {\n    const p = encodeGitPath(repoPath(path))\n    const url = `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${p}?ref=${encodeURIComponent(branch)}`\n    const res = await cfg.net.fetch({ url, method: 'GET', headers: headers() })\n    if (res.status === 404) return null\n    if (res.status === 401 || res.status === 403) {\n      throw new Error(`认证失败或限流（${res.status}）`)\n    }\n    if (res.status >= 400) throw new Error(`读取失败（${res.status}）：${path}`)\n    try {\n      return parseContents(JSON.parse(res.text()))\n    } catch (e) {\n      throw new Error(`响应解析失败：${String(e)}`)\n    }\n  }\n\n  /**\n   * 写一个文件。`sha` 给了 ⇒ 更新（远端变过就 409 / 422 / 400）；不给 ⇒ 新建。\n   * @returns {Promise<{ ok: boolean, status: number, sha: string|null, conflict?: boolean }>}\n   */\n  async function write(path, text, { sha = null, message = 'ZeroNote 同步' } = {}) {\n    const p = encodeGitPath(repoPath(path))\n    const url = `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${p}`\n    const body = { message, content: b64encode(text), branch, ...(sha ? { sha } : {}) }\n    const res = await cfg.net.fetch({\n      url,\n      method: preset.write,\n      headers: headers({ 'Content-Type': 'application/json' }),\n      body: JSON.stringify(body),\n    })\n    const ok = res.status === 200 || res.status === 201\n    let newSha = null\n    if (ok) {\n      try {\n        newSha = JSON.parse(res.text())?.content?.sha ?? null\n      } catch {\n        /* 有些实现不返回 body，下次读回来即可 */\n      }\n    }\n    /** 平台把「sha 不匹配」报成 409（GitHub）/ 422 / 400（各家不同） */\n    const conflict = !ok && (res.status === 409 || res.status === 422 || res.status === 400)\n    return { ok, status: res.status, sha: newSha, conflict }\n  }\n\n  /**\n   * 读一个文件的原始字节（附件用，rev173.126）。\n   *\n   * ⚠️ **不能只靠 Contents API 的 `content`**：GitHub 的 `GET /contents` 会把文件当 UTF-8 文本\n   * 再 base64 —— 实测 8 字节、含 `0x89` 的 png：`size` 仍是 8，但返回的 `content` 解码后是\n   * 12 字节（`0x89` 变 `EF BF BD`，即 U+FFFD 替换字符）。图片 / PDF 一定不是合法 UTF-8，\n   * 走 JSON 必被改写。所以先要 **raw 媒体类型**拿原始字节；平台不认 raw（回的是 JSON）时\n   * 才回退解析，大文件再走 `download_url`。\n   *\n   * @returns {Promise<{ data: Uint8Array, sha: string|null } | null>} 不存在 ⇒ null\n   */\n  async function readBytes(path) {\n    const p = encodeGitPath(repoPath(path))\n    const url = `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${p}?ref=${encodeURIComponent(branch)}`\n    const raw = await cfg.net.fetch({\n      url,\n      method: 'GET',\n      headers: headers({ Accept: 'application/vnd.github.raw' }),\n    })\n    if (raw.status === 404) return null\n    if (raw.status === 401 || raw.status === 403) {\n      throw new Error(`认证失败或限流（${raw.status}）`)\n    }\n    if (raw.status >= 400) throw new Error(`读取失败（${raw.status}）：${path}`)\n    const buf = raw.bytes ? raw.bytes() : new Uint8Array()\n    // 不认 raw 的实现会回 JSON：首字节是 `{` 且能解析出 content / download_url 才算\n    if (buf[0] !== 0x7b) return { data: buf, sha: null }\n    let j = null\n    try {\n      j = JSON.parse(new TextDecoder().decode(buf))\n    } catch {\n      j = null\n    }\n    if (!j || (!j.content && !j.download_url)) return { data: buf, sha: null }\n    if (typeof j.content === 'string' && j.content) {\n      return { data: b64decodeBytes(j.content), sha: typeof j.sha === 'string' ? j.sha : null }\n    }\n    if (!j.download_url) throw new Error(`远端文件读不到内容（大文件且平台不给 download_url）：${path}`)\n    const r2 = await cfg.net.fetch({ url: j.download_url, method: 'GET', headers: headers() })\n    if (r2.status >= 400) throw new Error(`下载失败（${r2.status}）：${path}`)\n    return { data: r2.bytes ? r2.bytes() : new Uint8Array(), sha: typeof j.sha === 'string' ? j.sha : null }\n  }\n\n  /** 写二进制（附件用）：base64 进 Contents API。冲突语义与 `write` 一致 */\n  async function writeBytes(path, bytes, { sha = null, message = 'ZeroNote 同步：附件' } = {}) {\n    const p = encodeGitPath(repoPath(path))\n    const url = `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${p}`\n    const body = { message, content: b64encodeBytes(bytes), branch, ...(sha ? { sha } : {}) }\n    const res = await cfg.net.fetch({\n      url,\n      method: preset.write,\n      headers: headers({ 'Content-Type': 'application/json' }),\n      body: JSON.stringify(body),\n    })\n    const ok = res.status === 200 || res.status === 201\n    let newSha = null\n    if (ok) {\n      try {\n        newSha = JSON.parse(res.text())?.content?.sha ?? null\n      } catch {\n        /* 有些实现不返回 body，下次读回来即可 */\n      }\n    }\n    const conflict = !ok && (res.status === 409 || res.status === 422 || res.status === 400)\n    return { ok, status: res.status, sha: newSha, conflict }\n  }\n\n  async function remove(path, sha, message = 'ZeroNote 同步：删除') {\n    const p = encodeGitPath(repoPath(path))\n    const url = `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${p}`\n    const body = { message, sha, branch }\n    const res = await cfg.net.fetch({\n      url,\n      method: 'DELETE',\n      headers: headers({ 'Content-Type': 'application/json' }),\n      body: JSON.stringify(body),\n    })\n    return { ok: [200, 204].includes(res.status), status: res.status }\n  }\n\n  return {\n    api,\n    owner,\n    repo,\n    branch,\n\n    /** 连接测试：读一个文件（`manifest` 或根目录）—— 只验认证与路径，不写 */\n    async test() {\n      let res\n      try {\n        res = await cfg.net.fetch({\n          url: `${api}/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}?ref=${encodeURIComponent(branch)}`,\n          method: 'GET',\n          headers: headers(),\n        })\n      } catch (e) {\n        return { ok: false, status: 0, hint: `连不上：${String(e).slice(0, 120)}` }\n      }\n      if (res.status === 200) return { ok: true, status: 200, hint: '连接正常' }\n      if (res.status === 401) return { ok: false, status: 401, hint: '令牌无效（401）' }\n      if (res.status === 403) return { ok: false, status: 403, hint: '令牌无权限或触发限流（403）' }\n      if (res.status === 404) return { ok: false, status: 404, hint: '仓库不存在或没权限（404）——检查 owner / repo' }\n      return { ok: false, status: res.status, hint: `意外状态 ${res.status}` }\n    },\n\n    read,\n    write,\n    readBytes,\n    writeBytes,\n    remove,\n  }\n}\n\n/**\n * 把 Git 客户端适配成 **WebDAV 客户端的同一套方法名**（引擎因此不用改）。\n *\n * 三个映射要点：\n * · `etag` ↔ **`sha`**：Git 没有 ETag，文件版本就是 sha；引擎的乐观锁参数走同一个位置。\n * · `mkdir` 是空操作：仓库没有目录，路径里的 `/` 由 Contents API 自己处理。\n * · `remove` 必须带 sha：先读一次拿当前 sha 再删（删不掉只会让下一轮再试，不报错）。\n */\nfunction createGitStorage(cfg) {\n  const c = createGitClient(cfg)\n\n  /** 读一次文本 + sha；目录 / 不存在都返回 null */\n  async function readOne(rel) {\n    const r = await c.read(rel)\n    if (!r || typeof r.text !== 'string') return null\n    return { text: r.text, sha: r.sha ?? null }\n  }\n\n  return {\n    kind: 'git',\n    test: () => c.test(),\n    async get(rel) {\n      const got = await readOne(rel)\n      return got ? got.text : null\n    },\n    async getWithEtag(rel) {\n      const got = await readOne(rel)\n      return got ? { text: got.text, etag: got.sha ?? undefined } : null\n    },\n    /**\n     * 写文本。`ifMatch` = 期望的 sha（乐观锁）：\n     * 平台会在 sha 不匹配时回 409 / 422 / 400，这里统一折成 `precondition`。\n     */\n    async put(rel, text, ifMatch) {\n      const w = await c.write(rel, text, { sha: ifMatch || null })\n      return {\n        ok: w.ok,\n        status: w.status,\n        etag: w.sha ?? undefined,\n        precondition: !!w.conflict,\n      }\n    },\n    /** 仓库没有目录 */\n    async mkdir() {},\n    async readManifest() {\n      const got = await readOne(MANIFEST_PATH)\n      if (!got) {\n        return { files: {}, attachments: {}, private: {}, privateTree: {}, etag: null, notModified: false }\n      }\n      const m = normalizeManifest(got.text)\n      return { ...m, etag: got.sha, notModified: false }\n    },\n    async writeManifest(manifest) {\n      // 更新已有文件必须带 sha ⇒ 先读当前 sha（没有就是新建）\n      const cur = await readOne(MANIFEST_PATH)\n      const body = JSON.stringify({\n        version: 1,\n        files: manifest.files ?? {},\n        attachments: manifest.attachments ?? {},\n        private: manifest.private ?? {},\n        privateTree: manifest.privateTree ?? {},\n      })\n      const w = await c.write(MANIFEST_PATH, body, { sha: cur?.sha ?? null })\n      return { ok: w.ok, status: w.status, etag: w.sha ?? undefined }\n    },\n    async getBytes(rel) {\n      const r = await c.readBytes(rel)\n      if (!r || !r.data) return { data: null, notModified: false, etag: null }\n      return { data: r.data, notModified: false, etag: r.sha ?? null }\n    },\n    async putBytes(rel, bytes, ifMatch) {\n      const w = await c.writeBytes(rel, bytes, { sha: ifMatch || null })\n      return { ok: w.ok, status: w.status, etag: w.sha ?? undefined, precondition: !!w.conflict }\n    },\n    async remove(rel) {\n      const cur = await readOne(rel)\n      if (!cur?.sha) return { ok: true, status: 404 }\n      return c.remove(rel, cur.sha)\n    },\n    async exists(rel) {\n      const got = await readOne(rel)\n      return !!got\n    },\n  }\n}\n\nmodule.exports = {\n  MANIFEST_PATH,\n  PROVIDERS,\n  b64decode,\n  b64decodeBytes,\n  b64encode,\n  b64encodeBytes,\n  createGitClient,\n  createGitStorage,\n  encodeGitPath,\n  parseContents,\n}",
    "lib/backends/s3.cjs": "/**\n * 同步后端 · S3 兼容存储（s3）—— rev173.287（从 `examples/sync-s3` 并入）\n *\n * 对象存储没有目录、没有 PROPFIND：`_zn/manifest.json` 就是权威索引（与 WebDAV 同一个\n * 文件、同一个格式）。判定与冲突处理全部复用引擎，本文件只负责**协议**：\n *\n *  · AWS SigV4 签名（自己实现，不引 SDK —— 插件只有 `net` 原语，Tauri 里没有 Node SDK）\n *  · 对象读写（path-style：`<endpoint>/<bucket>/<key>`，兼容 MinIO / R2 / B2 / rclone）\n *  · `createS3Storage()` 把客户端**适配成 WebDAV 客户端的同一套方法名**，引擎因此不用改\n *\n * 纯函数 `signRequest` 用 **AWS 官方 SDK 的测试向量**验证（`tests/sync-s3.test.ts`）——\n * 不是自签自验：改错一个字节测试就红。\n *\n * ## 与 WebDAV 的三个差别（决定了实现形态）\n *\n * 1. **没有目录** ⇒ `mkdir` 是空操作（键是平的）。\n * 2. **没有 304 / If-None-Match** ⇒ manifest 每轮全量读（几 KB，可接受）；\n *    附件的 ETag 只用来做「内容没变就不覆盖」的判断，不省传输。\n * 3. **条件写（If-Match）支持参差**：AWS 2024 起支持，很多兼容实现不支持 ⇒\n *    不支持的实现会忽略该头，行为退化成「不做乐观锁」，冲突仍由 manifest 指纹判定拦住。\n */\nconst { MANIFEST_REL, normalizeManifest } = require('../core.cjs')\n\n/** 空 body 的 SHA-256（GET / HEAD / DELETE 的 payload hash） */\nconst EMPTY_SHA256 = 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'\n\n/* ───────────────────────── SigV4 纯函数 ───────────────────────── */\n\n/**\n * RFC 3986 编码（SigV4 要求）。`encodeURIComponent` 少编 `!'()*` 这四个，\n * 漏掉它们会让签名与服务器算的对不上（且只在 key 含这些字符时才暴露，最难查）。\n */\nfunction encodeRfc3986(s) {\n  return encodeURIComponent(String(s ?? '')).replace(\n    /[!'()*]/g,\n    (c) => `%${c.charCodeAt(0).toString(16).toUpperCase()}`,\n  )\n}\n\n/**\n * S3 的 canonical URI：**逐段编码、保留 `/`、不做路径规范化**。\n *\n * S3 与其它 AWS 服务不同：路径**不能**二次编码，也不能把 `//` 折叠、不能解析 `..`\n * （对象键里真的可以有这些字符）。AWS SDK 的测试里就有这条断言\n * （`Key: 'a:b:c'` ⇒ `/a%3Ab%3Ac`）。\n */\nfunction encodeS3Path(path) {\n  const p = String(path ?? '')\n  if (!p) return '/'\n  return `/${p\n    .split('/')\n    .filter((seg, i) => i > 0 || seg !== '')\n    .map((seg) => encodeRfc3986(seg))\n    .join('/')}`\n}\n\n/** canonical query string：按键排序、名字与值都按 RFC3986 编码、空值保留 `=` */\nfunction canonicalQuery(params) {\n  const entries = Object.entries(params ?? {})\n    .filter(([, v]) => v !== undefined && v !== null)\n    .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))\n  return entries.map(([k, v]) => `${encodeRfc3986(k)}=${encodeRfc3986(String(v))}`).join('&')\n}\n\n/**\n * canonical headers + signed headers。\n *\n * 三条必须做对（每条都对应一个「签名对不上但看不出为什么」）：\n * · 头名**转小写**排序；值里的连续空白压成一个空格、首尾去空白；\n * · 每个头都以 `\\n` 结尾（canonical request 里 headers 块的最后也有一个空行）；\n * · `authorization` 自身不参与签名。\n */\nfunction canonicalHeaders(headers) {\n  const lower = {}\n  for (const [k, v] of Object.entries(headers ?? {})) {\n    const name = String(k).toLowerCase()\n    if (name === 'authorization' || v === undefined || v === null) continue\n    lower[name] = String(v).trim().replace(/\\s+/g, ' ')\n  }\n  const names = Object.keys(lower).sort()\n  const canon = names.map((n) => `${n}:${lower[n]}`).join('\\n')\n  return { canonicalHeaders: `${canon}\\n`, signedHeaders: names.join(';') }\n}\n\n/** hex 编码（Uint8Array / ArrayBuffer） */\nfunction toHex(buf) {\n  const u8 = buf instanceof Uint8Array ? buf : new Uint8Array(buf ?? [])\n  let out = ''\n  for (let i = 0; i < u8.length; i += 1) out += u8[i].toString(16).padStart(2, '0')\n  return out\n}\n\nconst textEncoder = () => new TextEncoder()\nconst toBytes = (data) => (typeof data === 'string' ? textEncoder().encode(data) : data)\n\n/** SHA-256（hex） */\nasync function sha256Hex(data) {\n  const digest = await crypto.subtle.digest('SHA-256', toBytes(data))\n  return toHex(digest)\n}\n\n/** HMAC-SHA256（返回字节） */\nasync function hmacSha256(key, data) {\n  const k = await crypto.subtle.importKey('raw', toBytes(key), { name: 'HMAC', hash: 'SHA-256' }, false, [\n    'sign',\n  ])\n  return new Uint8Array(await crypto.subtle.sign('HMAC', k, toBytes(data)))\n}\n\n/** AWS 时间戳 → `20130524T000000Z` */\nfunction amzDate(date) {\n  const d = date instanceof Date ? date : new Date(date)\n  const p = (n) => String(n).padStart(2, '0')\n  return (\n    `${d.getUTCFullYear()}${p(d.getUTCMonth() + 1)}${p(d.getUTCDate())}` +\n    `T${p(d.getUTCHours())}${p(d.getUTCMinutes())}${p(d.getUTCSeconds())}Z`\n  )\n}\n\n/** AWS 时间戳 → `20130524`（凭证作用域的日期段） */\nfunction amzDay(date) {\n  return amzDate(date).slice(0, 8)\n}\n\n/**\n * 算一个 SigV4 签名（**纯计算**，不发请求）。\n *\n * @param {{\n *   method: string, path: string, query?: object, headers: object,\n *   payloadHash: string, region: string, service?: string,\n *   accessKey: string, secretKey: string, date: Date,\n * }} req\n * @returns {Promise<{ authorization: string, headers: object, canonicalRequest: string, stringToSign: string }>}\n */\nasync function signRequest(req) {\n  const service = req.service || 's3'\n  const date = req.date instanceof Date ? req.date : new Date(req.date)\n  const stamp = amzDate(date)\n  const day = amzDay(date)\n  const payloadHash = req.payloadHash || EMPTY_SHA256\n\n  /** 调用方传进来的头 + 三个必带头（覆盖写：同一请求里不能有两个 x-amz-date） */\n  const headers = { ...(req.headers ?? {}) }\n  headers['x-amz-date'] = stamp\n  headers['x-amz-content-sha256'] = payloadHash\n\n  const { canonicalHeaders: canonHeaders, signedHeaders } = canonicalHeaders(headers)\n  const canonicalRequest = [\n    req.method.toUpperCase(),\n    encodeS3Path(req.path ?? ''),\n    canonicalQuery(req.query),\n    canonHeaders,\n    signedHeaders,\n    payloadHash,\n  ].join('\\n')\n\n  const scope = `${day}/${req.region}/${service}/aws4_request`\n  const stringToSign = ['AWS4-HMAC-SHA256', stamp, scope, await sha256Hex(canonicalRequest)].join('\\n')\n\n  const kDate = await hmacSha256(`AWS4${req.secretKey}`, day)\n  const kRegion = await hmacSha256(kDate, req.region)\n  const kService = await hmacSha256(kRegion, service)\n  const kSigning = await hmacSha256(kService, 'aws4_request')\n  const signature = toHex(await hmacSha256(kSigning, stringToSign))\n\n  const signed = { ...headers, authorization: undefined }\n  delete signed.authorization\n  const authorization =\n    `AWS4-HMAC-SHA256 Credential=${req.accessKey}/${scope}, ` +\n    `SignedHeaders=${signedHeaders}, Signature=${signature}`\n\n  return { authorization, headers: { ...headers, Authorization: authorization }, canonicalRequest, stringToSign }\n}\n\n/* ───────────────────────── 响应解析 ───────────────────────── */\n\n/** 取一个 XML 标签的文本（不引 DOMParser：各实现容错不同，正则够用） */\nfunction pickTagText(xml, tag) {\n  const m = new RegExp(`<${tag}>([\\\\s\\\\S]*?)</${tag}>`, 'i').exec(String(xml ?? ''))\n  return m ? m[1].trim() : ''\n}\n\nfunction decodeXml(s) {\n  return String(s ?? '')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&apos;/g, \"'\")\n    .replace(/&amp;/g, '&')\n}\n\n/**\n * 解析 `ListBucketResult` 的 XML。\n *\n * @returns {{ items: { key: string, size: number, etag: string|null }[], truncated: boolean, token: string|null }}\n */\nfunction parseListObjects(xml) {\n  const raw = String(xml ?? '')\n  const out = []\n  const blockRe = /<Contents\\b[^>]*>([\\s\\S]*?)<\\/Contents>/gi\n  let m\n  while ((m = blockRe.exec(raw))) {\n    const body = m[1]\n    const key = pickTagText(body, 'Key')\n    if (!key) continue\n    out.push({\n      key: decodeXml(key),\n      size: Number(pickTagText(body, 'Size') || 0),\n      etag: pickTagText(body, 'ETag') ? decodeXml(pickTagText(body, 'ETag')) : null,\n    })\n  }\n  const truncated = /<IsTruncated>\\s*true\\s*<\\/IsTruncated>/i.test(raw)\n  const token = pickTagText(raw, 'NextContinuationToken')\n  return { items: out, truncated, token: token ? decodeXml(token) : null }\n}\n\n/* ───────────────────────── S3 客户端 ───────────────────────── */\n\n/**\n * S3 客户端（path-style：`<endpoint>/<bucket>/<key>`）。\n *\n * 为什么是 path-style：virtual-hosted 需要 `bucket.s3.amazonaws.com` 这类 DNS，\n * 而 MinIO / R2 / 自建网关大多用 path-style —— 兼容面更宽。\n *\n * @param {{ endpoint: string, region?: string, bucket: string, accessKey: string, secretKey: string, prefix?: string, net: object }} cfg\n * @param {{ date?: () => Date }} [opts] 注 `date` 只是为了让测试可复现\n */\nfunction createS3Client(cfg, opts = {}) {\n  const endpoint = String(cfg.endpoint ?? '').replace(/\\/+$/, '')\n  const base = new URL(endpoint)\n  const region = cfg.region || 'us-east-1'\n  const bucket = String(cfg.bucket ?? '').replace(/^\\/+|\\/+$/g, '')\n  const prefix = String(cfg.prefix ?? '').replace(/^\\/+|\\/+$/g, '')\n  const now = opts.date ?? (() => new Date())\n\n  /** 对象键（含 prefix，不含 bucket） */\n  const fullKey = (key) => [prefix, key].filter(Boolean).join('/')\n\n  /**\n   * 拼 URL。`p` 是**不含前导 `/` 的完整路径段串**（`bucket/…`），逐段编码。\n   *\n   * 前缀只进 query 的 `prefix` 参数、不进路径 —— 以前 `list()` / `test()` 传空 key，\n   * 而 `fullKey('')` 会带上对象前缀 ⇒ 请求打到 `/桶/<前缀>` 上，前缀非空时连接测试\n   * 与列对象直接 404（rev173.126 修）。\n   */\n  const urlFor = (p, query) => {\n    const qs = query && Object.keys(query).length ? `?${canonicalQuery(query)}` : ''\n    return `${endpoint}/${p\n      .split('/')\n      .map((seg) => encodeRfc3986(seg))\n      .join('/')}${qs}`\n  }\n\n  /**\n   * 发一个已签名的请求。\n   *\n   * **host 头参与签名但不显式发送**：HTTP 层会按 URL 自动带同一个值，\n   * 而浏览器 / reqwest 都不允许手工设 Host。\n   */\n  async function request(method, key, { body, query, contentType, extraHeaders, bareBucket = false } = {}) {\n    // `bareBucket`：桶根请求（连接测试 / 列对象）—— prefix 只进 query 的 `prefix` 参数，不进路径\n    const path = bareBucket ? `/${bucket}` : `/${[bucket, fullKey(key)].filter(Boolean).join('/')}`\n    const payloadHash =\n      body === undefined || body === null ? EMPTY_SHA256 : await sha256Hex(body instanceof Uint8Array ? body : String(body))\n    const headers = {\n      host: base.host,\n      ...(contentType ? { 'content-type': contentType } : {}),\n      ...(extraHeaders ?? {}),\n    }\n    const signed = await signRequest({\n      method,\n      path,\n      query,\n      headers,\n      payloadHash,\n      region,\n      service: 's3',\n      accessKey: cfg.accessKey,\n      secretKey: cfg.secretKey,\n      date: now(),\n    })\n    const sendHeaders = { ...signed.headers }\n    delete sendHeaders.host\n    return cfg.net.fetch({\n      url: urlFor(path.replace(/^\\//, ''), query),\n      method,\n      headers: sendHeaders,\n      body,\n    })\n  }\n\n  return {\n    endpoint,\n    bucket,\n    prefix,\n\n    /** 连接测试：列 1 个对象（`max-keys=1`）—— 只验证签名与权限，不拉全表 */\n    async test() {\n      let res\n      try {\n        res = await request('GET', '', { query: { 'list-type': '2', 'max-keys': '1' }, bareBucket: true })\n      } catch (e) {\n        return { ok: false, status: 0, hint: `连不上：${String(e).slice(0, 120)}` }\n      }\n      if (res.status === 200) return { ok: true, status: 200, hint: '连接正常' }\n      if (res.status === 401 || res.status === 403) {\n        const body = String(res.text?.() ?? '')\n        const code = pickTagText(body, 'Code')\n        return { ok: false, status: res.status, hint: `密钥或权限不对（${res.status}${code ? ` ${code}` : ''}）` }\n      }\n      if (res.status === 404) return { ok: false, status: 404, hint: '桶不存在（404）——检查「桶名」' }\n      if (res.status === 301 || res.status === 307) {\n        return { ok: false, status: res.status, hint: `区域不对（${res.status}）——检查「区域」是否填对` }\n      }\n      return { ok: false, status: res.status, hint: `意外状态 ${res.status}` }\n    },\n\n    /** 读文本对象；不存在返回 `{text, etag}` / `null` */\n    async get(key) {\n      const res = await request('GET', key)\n      if (res.status === 404) return null\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${key}`)\n      return { text: res.text(), etag: res.headers?.etag ?? null }\n    },\n\n    /** 读二进制；不存在返回 null */\n    async getBytes(key) {\n      const res = await request('GET', key)\n      if (res.status === 404) return null\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${key}`)\n      return { data: res.bytes(), etag: res.headers?.etag ?? null }\n    },\n\n    /**\n     * 写文本；返回 `{ ok, status, etag, precondition, conflict409 }`（4xx 不抛，调用方判断）。\n     *\n     * `opts.ifMatch` = 条件写：只有远端对象的 ETag 与它相等才写，否则 **412**。\n     * 头参与 SigV4 签名（`request()` 把所有传入头都签）—— AWS 允许签额外头，值必须一致。\n     */\n    async put(key, text, opts = {}) {\n      const body = typeof text === 'string' ? text : String(text ?? '')\n      const extraHeaders = {}\n      if (opts.ifMatch) extraHeaders['if-match'] = String(opts.ifMatch)\n      /**\n       * 空文本 PUT 必须显式带 `Content-Length: 0`。\n       *\n       * 根因在内核 `net_request`：reqwest 对空 Vec 的 body **既不设 Content-Length\n       * 也不设 Transfer-Encoding**，而 rclone `serve s3` 对没有长度的 PUT 回\n       * **411 Length Required** —— 表现为「手机端同步到一篇空笔记就永远卡住」。\n       * 内核侧已补；这里兜一层，让旧内核也能同步空笔记。\n       */\n      if (body.length === 0) extraHeaders['content-length'] = '0'\n      const res = await request('PUT', key, {\n        body,\n        contentType: opts.contentType ?? 'text/markdown; charset=utf-8',\n        extraHeaders,\n      })\n      const ok = res.status === 200 || res.status === 201 || res.status === 204\n      return {\n        ok,\n        status: res.status,\n        etag: res.headers?.etag ?? null,\n        /** 412 = ETag 不匹配（远端被绕过 manifest 改过 / 另一台刚写过） */\n        precondition: res.status === 412,\n        /** 409 ConditionalRequestConflict = 同一对象并发写撞车（AWS 要求取新 ETag 重试） */\n        conflict409: res.status === 409,\n      }\n    },\n\n    async putBytes(key, bytes) {\n      const res = await request('PUT', key, { body: bytes, contentType: 'application/octet-stream' })\n      return {\n        ok: res.status === 200 || res.status === 201 || res.status === 204,\n        status: res.status,\n        etag: res.headers?.etag ?? null,\n      }\n    },\n\n    /** 删一个对象（404 也算成功 —— 幂等） */\n    async remove(key) {\n      const res = await request('DELETE', key)\n      return { ok: [200, 204, 404].includes(res.status), status: res.status }\n    },\n\n    /**\n     * 对象是否存在（中转 ack 用）。\n     *\n     * 正常走 `HEAD`；个别实现不实现 HEAD（405/501）⇒ 回退 GET；\n     * 只判存在性，别的状态一律当「不存在」（下一轮会再试，不会误删）。\n     */\n    async exists(key) {\n      const res = await request('HEAD', key)\n      if (res.status === 200) return true\n      if (res.status === 404) return false\n      if (res.status === 405 || res.status === 501) {\n        const g = await request('GET', key)\n        return g.status === 200\n      }\n      return false\n    },\n\n    /**\n     * 列对象（自动翻页）。返回的 `key` 已剥掉插件的 `prefix` ——\n     * 否则喂回 `get/put/remove` 会被再拼一次前缀（表现为「清理跑完远端还剩对象」）。\n     */\n    async list(listPrefix = '') {\n      const all = []\n      let token = null\n      const rel = (k) => {\n        if (!prefix) return k\n        if (k === prefix) return ''\n        return k.startsWith(`${prefix}/`) ? k.slice(prefix.length + 1) : k\n      }\n      for (let page = 0; page < 50; page += 1) {\n        const query = { 'list-type': '2', 'max-keys': '1000' }\n        const p = [prefix, listPrefix].filter(Boolean).join('/')\n        if (p) query.prefix = p\n        if (token) query['continuation-token'] = token\n        const res = await request('GET', '', { query, bareBucket: true })\n        if (res.status !== 200) throw new Error(`列对象失败（${res.status}）`)\n        const parsed = parseListObjects(res.text())\n        all.push(...parsed.items.map((it) => ({ ...it, key: rel(it.key) })))\n        if (!parsed.truncated || !parsed.token) break\n        token = parsed.token\n      }\n      return all\n    },\n  }\n}\n\n/**\n * 把 S3 客户端适配成 **WebDAV 客户端的同一套方法名**（`get` 返回文本、`readManifest`\n * 返回 `{files, attachments, private, privateTree, etag, notModified}` …）。\n *\n * 这样引擎只有一份，换后端只换 `makeClient()` 的返回 —— 不用在每个调用点写分支。\n */\nfunction createS3Storage(cfg, opts = {}) {\n  const c = createS3Client(cfg, opts)\n  return {\n    kind: 's3',\n    test: () => c.test(),\n    list: (rel = '') => c.list(rel),\n    async get(rel) {\n      const got = await c.get(rel)\n      return got ? got.text : null\n    },\n    /**\n     * 读文本 + 它的 ETag（412 冲突收尾要用：把远端最新版对齐进本机基线时，\n     * 新基线必须带上远端对象的真实 etag，否则下一轮又拿旧 etag 撞 412）。\n     */\n    async getWithEtag(rel) {\n      const got = await c.get(rel)\n      return got ? { text: got.text, etag: got.etag ?? undefined } : null\n    },\n    /**\n     * 写文本；带 `ifMatch` 时若服务端把条件写**当坏请求**（400 / 501）就重试一次不带条件。\n     *\n     * AWS / MinIO 支持 `If-Match`，但一些自建网关与旧实现直接拒 400 —— 不能让整个同步\n     * 挂在「服务端不认识这个头」上。降级后行为退回到「不做乐观锁」，冲突仍由 manifest\n     * 指纹判定拦住（这是 rev173.129 的老需求，并进统一引擎后放在这一层，引擎不用改）。\n     */\n    async put(rel, text, ifMatch) {\n      const r = await c.put(rel, text, { ifMatch })\n      if (ifMatch && (r.status === 400 || r.status === 501)) return c.put(rel, text, {})\n      return r\n    },\n    /** 对象存储没有目录：建\"目录\"是空操作 */\n    async mkdir() {},\n    /**\n     * 读 manifest。S3 没有 `If-None-Match` / 304，所以永远全量读（几 KB）——\n     * `ifNoneMatch` 参数保留只是为了与 WebDAV 签名一致。\n     */\n    async readManifest() {\n      const got = await c.get(MANIFEST_REL)\n      if (!got) {\n        return { files: {}, attachments: {}, private: {}, privateTree: {}, etag: null, notModified: false }\n      }\n      const m = normalizeManifest(got.text)\n      return { ...m, etag: got.etag ?? null, notModified: false }\n    },\n    async writeManifest(manifest) {\n      const body = JSON.stringify({\n        version: 1,\n        files: manifest.files ?? {},\n        attachments: manifest.attachments ?? {},\n        private: manifest.private ?? {},\n        privateTree: manifest.privateTree ?? {},\n      })\n      // 不做条件写：manifest 是「尽力而为」的索引，真冲突靠每篇文件的 etag 兜\n      return c.put(MANIFEST_REL, body)\n    },\n    async getBytes(rel) {\n      const got = await c.getBytes(rel)\n      if (!got) return { data: null, notModified: false, etag: null }\n      return { data: got.data, notModified: false, etag: got.etag ?? null }\n    },\n    putBytes: (rel, bytes) => c.putBytes(rel, bytes),\n    remove: (rel) => c.remove(rel),\n    exists: (rel) => c.exists(rel),\n  }\n}\n\nmodule.exports = {\n  EMPTY_SHA256,\n  amzDate,\n  amzDay,\n  canonicalHeaders,\n  canonicalQuery,\n  createS3Client,\n  createS3Storage,\n  decodeXml,\n  encodeRfc3986,\n  encodeS3Path,\n  hmacSha256,\n  parseListObjects,\n  pickTagText,\n  sha256Hex,\n  signRequest,\n  toHex,\n}\n",
    "lib/backends/webdav.cjs": "/**\n * WebDAV 后端（`sync` 插件的第一个 backend）。\n *\n * 从 `examples/sync-webdav` 原样搬过来 —— 那边的引擎已经与本插件共用一套纯函数\n * （`lib/core.cjs`），这里只留「与 WebDAV 协议有关」的那部分：\n * URL 编码 / Basic 认证 / PROPFIND XML 解析 / 乐观锁 PUT / manifest 读写。\n *\n * 为什么是 `.cjs`：宿主的多文件运行时只认 CommonJS（契约 §3.2），\n * 而仓库是 `\"type\": \"module\"` —— `.cjs` 让 Node 侧（单测）与宿主侧都按 CJS 解析。\n */\nconst { MANIFEST_REL, encodeDavPath, basicAuth, joinUrl, parsePropfind, normalizeManifest } = require('../core.cjs')\n/* ───────────────────────── WebDAV 客户端 ───────────────────────── */\n\n/**\n * 一层薄封装：只认 `ctx.net`，不关心 UI。\n *\n * @param {{ baseUrl: string, username: string, password: string, root: string, net: object }} cfg\n */\nfunction createDavClient(cfg) {\n  const baseUrl = String(cfg.baseUrl ?? '').trim()\n  const root = String(cfg.root ?? '').trim().replace(/^\\/+|\\/+$/g, '')\n  const auth = basicAuth(cfg.username, cfg.password)\n\n  const urlFor = (rel = '') => joinUrl(baseUrl, root, rel)\n\n  /** 发一个请求，返回原始 `NetResponse`（**不抛 4xx**，调用方自己看 status） */\n  const request = (method, rel, { headers = {}, body, timeoutMs = 30000 } = {}) =>\n    cfg.net.fetch({\n      url: urlFor(rel),\n      method,\n      headers: { Authorization: auth, ...headers },\n      body,\n      timeoutMs,\n    })\n\n  /** 建目录（逐级）；405 = 已存在算成功。sync 里上传前靠它建 `<根>/<父目录>` */\n  const mkdirPath = async (rel) => {\n    const parts = String(rel ?? '')\n      .split('/')\n      .filter(Boolean)\n    let acc = ''\n    for (const part of parts) {\n      acc = acc ? `${acc}/${part}` : part\n      const res = await request('MKCOL', acc)\n      if (![200, 201, 204, 405].includes(res.status)) {\n        throw new Error(`建目录失败（${res.status}）：${acc}`)\n      }\n    }\n  }\n\n  /**\n   * 建**同步根本身**（逐级 MKCOL；405 = 已存在算成功）。\n   *\n   * ⚠️ **不能复用 `mkdirPath`**（rev173.118 修）：它收的是「相对同步根」的路径，而\n   * `request()` 又会经 `urlFor()` 再拼一次 `root` —— `mkdirPath(root)` 实际会去建\n   * `<根>/<root>/<root>`，实测在远端多出一个空的 `ZeroNote/` 子目录（rev173.117 实测发现）。\n   * 这里直接用「不含 root」的 URL 拼法。\n   */\n  const mkdirRoot = async () => {\n    const parts = root.split('/').filter(Boolean)\n    let acc = ''\n    for (const part of parts) {\n      acc = acc ? `${acc}/${part}` : part\n      const res = await cfg.net.fetch({\n        url: joinUrl(baseUrl, '', acc),\n        method: 'MKCOL',\n        headers: { Authorization: auth },\n        timeoutMs: 30000,\n      })\n      if (![200, 201, 204, 405].includes(res.status)) {\n        throw new Error(`建目录失败（${res.status}）：${acc}`)\n      }\n    }\n  }\n\n  return {\n    baseUrl,\n    root,\n    urlFor,\n    request,\n\n    /**\n     * 连接测试：对同步根发 `PROPFIND Depth: 0`。返回 `{ ok, status, hint }`。\n     *\n     * **404 且填了「同步目录」⇒ 自动把它建出来再测一次**（rev173.108 实测踩到：\n     * 用户第一次配时远端还没有那个子目录，直接报 404 会让人以为地址填错了）。\n     */\n    async test() {\n      const probe = () =>\n        request('PROPFIND', '', {\n          headers: { Depth: '0', 'Content-Type': 'application/xml; charset=utf-8' },\n          body: '<?xml version=\"1.0\"?><d:propfind xmlns:d=\"DAV:\"><d:prop><d:resourcetype/></d:prop></d:propfind>',\n        })\n\n      let res = await probe()\n      let created = false\n      if (res.status === 404 && root) {\n        try {\n          await mkdirRoot()\n          res = await probe()\n          created = res.status === 207 || res.status === 200\n        } catch {\n          /* 建不出来就照旧按 404 报 */\n        }\n      }\n      if (res.status === 207 || res.status === 200) {\n        const hint = created\n          ? '连接正常（已自动创建同步目录）'\n          : root\n            ? '连接正常'\n            : '连接正常，但「同步目录」为空 —— 坚果云这类服务的 WebDAV 根不可直接写，建议填一个子目录（如 ZeroNote）'\n        return { ok: true, status: res.status, hint }\n      }\n      if (res.status === 401) return { ok: false, status: 401, hint: '账号或密码不对（401）' }\n      if (res.status === 403) return { ok: false, status: 403, hint: '没有权限（403）' }\n      if (res.status === 429 || res.status === 503) {\n        // 坚果云高频请求 / 连续失败后会回 503 + `<s:exception>BlockedTemporarily</s:exception>`\n        return { ok: false, status: res.status, hint: '远端临时限流 / 封禁（503）—— 等 10–30 分钟再试' }\n      }\n      if (res.status === 404) return { ok: false, status: 404, hint: '远端目录不存在（404）——检查「同步目录」' }\n      if (res.status === 405) return { ok: false, status: 405, hint: '这个地址不支持 WebDAV（405）' }\n      return { ok: false, status: res.status, hint: `意外状态 ${res.status}` }\n    },\n\n    /** 列目录（Depth: 1）。返回不含根自身的条目 */\n    async list(rel = '') {\n      const res = await request('PROPFIND', rel, {\n        headers: { Depth: '1', 'Content-Type': 'application/xml; charset=utf-8' },\n        body: '<?xml version=\"1.0\"?><d:propfind xmlns:d=\"DAV:\"><d:prop><d:resourcetype/><d:getetag/><d:getcontentlength/></d:prop></d:propfind>',\n      })\n      if (res.status !== 207 && res.status !== 200) {\n        throw new Error(`列目录失败（${res.status}）：${rel || '/'}`)\n      }\n      const rootPrefix = new URL(urlFor(rel)).pathname.replace(/\\/+$/, '')\n      return parsePropfind(res.text(), { rootPrefix }).filter((e) => e.path !== '')\n    },\n\n    /**\n     * 读一个文件；**不存在返回 `null`**（不抛）。\n     *\n     * ⚠️ `409` 也要当\"不存在\"（rev173.108 实测坚果云）：对**父目录不存在**的资源\n     * 它回 `409 Conflict` 而不是规范的 `404` —— 首次同步读 `_zn/manifest.json`\n     * 就会撞上（`_zn/` 还没建）。把 409 当错误抛的话，第一次同步永远失败。\n     */\n    async get(rel) {\n      const res = await request('GET', rel)\n      if (res.status === 404 || res.status === 409) return null\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${rel}`)\n      return res.text()\n    },\n\n    /**\n     * 读文本 + 它的 ETag（与 S3 后端的同名方法对应）。\n     *\n     * 412 冲突收尾时用它：把远端最新版对齐进本机基线，新基线要带上**远端真实 etag**，\n     * 否则下一轮又拿旧 etag 撞 412。\n     */\n    async getWithEtag(rel) {\n      const res = await request('GET', rel)\n      if (res.status === 404 || res.status === 409) return null\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${rel}`)\n      return { text: res.text(), etag: res.headers?.etag ?? undefined }\n    },\n\n    /**\n     * 写一个文件。返回 `{ ok, status, etag }`：\n     * · `ok: true` = 写成功（201/204/200）\n     * · `status: 412` = **乐观锁失败**（远端在我们读 manifest 之后又变了）⇒ 调用方按冲突处理\n     */\n    async put(rel, text, ifMatch) {\n      const headers = { 'Content-Type': 'text/markdown; charset=utf-8' }\n      if (ifMatch) headers['If-Match'] = ifMatch\n      const res = await request('PUT', rel, { headers, body: text })\n      const etag = res.headers['etag'] ?? null\n      const ok = res.status === 200 || res.status === 201 || res.status === 204\n      return { ok, status: res.status, etag }\n    },\n\n    /**\n     * 建目录（逐级）；405 = 已存在，算成功。\n     *\n     * 注意这里传的是**相对同步根**的路径：`mkdir('日记/2026')` 会建 `<根>/日记` 与 `<根>/日记/2026`。\n     * 建同步根本身要传 `root`（`test()` 里那个 404 自动创建走的就是这条）。\n     */\n    mkdir: mkdirPath,\n\n    /**\n     * 读远端 manifest；没有返回空表。\n     *\n     * **`If-None-Match` 304 短路径（rev173.111）**：自动同步每 5 秒一轮，manifest 大多数时候\n     * 没变 —— 把上轮的 etag 传上去，远端回 304 就不用再拉一遍几 KB 的 JSON。\n     * 调用方拿到 `notModified: true` 时用自己缓存的表。\n     *\n     * @param {string|null} [ifNoneMatch] 上一轮拿到的 etag\n     * @returns {Promise<{files: object|null, attachments: object|null, etag: string|null, notModified: boolean}>}\n     */\n    async readManifest(ifNoneMatch) {\n      const res = await request('GET', MANIFEST_REL, {\n        headers: ifNoneMatch ? { 'If-None-Match': ifNoneMatch } : {},\n      })\n      if (res.status === 304) {\n        return {\n          files: null,\n          attachments: null,\n          private: null,\n          privateTree: null,\n          etag: ifNoneMatch ?? null,\n          notModified: true,\n        }\n      }\n      /**\n       * `404` / `409` = 还没有 manifest（坚果云对**父目录不存在**的 GET 回 409）⇒ 空表。\n       * 这里不再走 `get()`：它把 404/409 吞成 null，拿不到响应的 ETag。\n       */\n      if (res.status === 404 || res.status === 409) {\n        return { files: {}, attachments: {}, private: {}, privateTree: {}, etag: null, notModified: false }\n      }\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${MANIFEST_REL}`)\n      const m = normalizeManifest(res.text())\n      return { ...m, etag: res.headers?.etag ?? null, notModified: false }\n    },\n\n    /** 写远端 manifest（先确保 `_zn/` 存在；`attachments` / `private` 段原样带上）。返回 PUT 结果（带新 etag） */\n    async writeManifest(manifest) {\n      await this.mkdir('_zn')\n      const body = JSON.stringify({\n        version: 1,\n        files: manifest.files ?? {},\n        attachments: manifest.attachments ?? {},\n        private: manifest.private ?? {},\n        privateTree: manifest.privateTree ?? {},\n      })\n      // 不做 If-Match：manifest 是\"尽力而为\"的索引，真冲突靠每篇文件的 etag 兜\n      return this.put(MANIFEST_REL, body)\n    },\n\n    /* ── 二进制（附件同步用）：字节进出，不做任何编码假设 ── */\n\n    /**\n     * 读二进制。返回 `{ data, notModified, etag }`：\n     *\n     * · `data: Uint8Array`               ⇒ 正常内容\n     * · `data: null, notModified: false` ⇒ 远端没有这份（404 / 409）\n     * · `data: null, notModified: true`  ⇒ **带了 `If-None-Match`，远端没变**（304）\n     *\n     * 304 短路径（rev173.117）：与 manifest 同一套做法 —— 附件这种几 MB 的东西，\n     * 远端没变就不该再拉一遍字节。调用方拿到 `notModified` 时自己决定用本机已有的副本。\n     */\n    async getBytes(rel, ifNoneMatch) {\n      const res = await request('GET', rel, {\n        headers: ifNoneMatch ? { 'If-None-Match': ifNoneMatch } : {},\n      })\n      const etag = res.headers?.etag ?? null\n      if (res.status === 304) return { data: null, notModified: true, etag: ifNoneMatch ?? etag }\n      if (res.status === 404 || res.status === 409) return { data: null, notModified: false, etag }\n      if (res.status >= 400) throw new Error(`下载失败（${res.status}）：${rel}`)\n      return { data: res.bytes(), notModified: false, etag }\n    },\n\n    /** 写二进制。返回 `{ ok, status }` */\n    async putBytes(rel, bytes) {\n      const res = await request('PUT', rel, {\n        headers: { 'Content-Type': 'application/octet-stream' },\n        body: bytes,\n      })\n      return { ok: [200, 201, 204].includes(res.status), status: res.status }\n    },\n\n    /** 删一个文件（不存在也算成功 —— apply 幂等） */\n    async remove(rel) {\n      const res = await request('DELETE', rel)\n      return { ok: [200, 202, 204, 404, 409].includes(res.status), status: res.status }\n    },\n\n    /** 远端有没有这个资源（PROPFIND Depth 0） */\n    async exists(rel) {\n      const res = await request('PROPFIND', rel, { headers: { Depth: '0' } })\n      return res.status === 207 || res.status === 200\n    },\n  }\n}\n\n\nmodule.exports = { createDavClient }\n",
    "lib/core.cjs": "/**\n * 同步 · WebDAV（sync-webdav）—— rev173.108\n *\n * 直连用户自己的 WebDAV（坚果云 / Nextcloud / 群晖 / dufs），**不依赖任何第三方同步工具**。\n * 与 `sync-folder` 的差别：那个不搬文件（库放同步目录，搬运交给 Syncthing 之类），\n * 这个自己搬 —— 因为远端是网络存储，App 必须自己发请求。\n *\n * ## 为什么请求走 `ctx.net` 而不是自己 `fetch`\n *\n * WebDAV 的 `PROPFIND` / `MKCOL` / `MOVE` 带自定义方法与非简单头，WebView 里必然触发 CORS\n * preflight；服务器不回 CORS 头时前端只能看到 `TypeError: Failed to fetch`，\n * **分不清 CORS / 断网 / 401**（2026-10-12 踩过）。`ctx.net` 由 Rust 侧发请求，没有 CORS。\n *\n * ## 同步模型\n *\n * 远端 `<根>/_zn/manifest.json` 是唯一权威：\n * ```json\n * { \"version\": 1, \"files\": { \"日记/2026.md\": { \"fp\": \"1a:abc\", \"etag\": \"\\\"x\\\"\", \"at\": 123 } } }\n * ```\n * 每篇的 `fp` 是内容指纹（与 `sync-folder` 同一套算法），`etag` 给 `If-Match` 用。\n *\n * 一次同步：\n *   1. `GET manifest`（带 `If-None-Match`；没变 ⇒ 304，直接结束）\n *   2. 逐篇比较：`base`（上次同步的 fp） vs 本地 fp vs 远端 fp\n *      · 只有本地变 ⇒ `PUT`（带 `If-Match: 上次的 etag`）\n *      · 只有远端变 ⇒ `GET` 并写回本地\n *      · 两边都变 ⇒ **冲突**：本地版留 `.zn/conflicts/<平台>/…`，然后取远端版\n *      · `If-Match` 拿到 **412**（远端在我们读 manifest 之后又变了）⇒ 同样按冲突处理\n *   3. 更新本地 `baseline`，把 manifest 推回远端\n *\n * ## 凭据\n *\n * **不落磁盘明文**：密码走 `ctx.host.secrets`（Windows 凭据管理器 / Android Keystore），\n * 账号与地址落 `store`（那不是机密）。断开连接 = 删凭据 + 清设置。\n */\n\nconst PANEL_ID = 'sync.status'\nconst KEY_SETTINGS = 'settings.v1'\nconst KEY_BASELINE = 'baseline.v1'\nconst KEY_CONFLICTS = 'conflicts.v1'\nconst KEY_DEVICE = 'device.v1'\n/** 最近若干次同步的耗时（rev173.119，画趋势用） */\nconst KEY_TIMING = 'timing.v1'\nconst SECRET_KEY = 'sync.webdav.password'\n\nconst CONFLICT_ROOT = '.zn/conflicts'\n/** manifest 在远端的落点（相对同步根） */\nconst MANIFEST_REL = '_zn/manifest.json'\n\n/**\n * **私有文件**清单（rev173.164 · 期 1c；rev173.182 按环拆 vault）。\n *\n * 这些是库内 `.zn/` 下的密文，不是 `.md`、`listNotes` 永远拿不到，所以要单独搬。\n *\n * 为什么密码库必须同步**多个**文件：\n *  · `secrets.zn`        —— 整库密文（真正的数据）\n *  · `vault.<环>.json`   —— KDF salt + 被主密码包裹的 DEK（**没有它，另一台拿到密文也解不开**）\n *\n * 为什么 vault 按环拆（rev173.182）：整文件同步时，两台设备各改一个环的密码（重包裹）\n * 会同时改同一个文件 ⇒ 判冲突 ⇒ 取远端 ⇒ **另一边的重包裹丢了**，那台设备解不开。\n * 拆开之后两个环各是一个同步单元，互不干扰。\n *\n * `vault.json`（旧单文件）仍留在清单里：还没迁移的库还在用它；迁移完成后文件会消失，\n * 那几条分支自然变成\"两边都没有\"的 no-op。\n *\n * 三个文件里都没有明文（只有公开参数与密文块），所以\"上云\"不等于\"泄露\"；\n * 但没有主密码，谁也解不开 —— 这是需求 §10.1「加密后同步」要的效果。\n */\nconst PRIVATE_FILES = [\n  '.zn/secrets/secrets.zn',\n  '.zn/security/vault.notes.json',\n  '.zn/security/vault.secrets.json',\n  '.zn/security/vault.json',\n]\n/** 私密文件夹的**根文件**（不在 notes/ 或 trash/ 里，单独列出） */\nconst PRIVATE_ROOT_FILES = ['.zn/private/index.zn']\n/** 私密文件夹的**目录树**（数量可变 ⇒ 逐个文件走同一套方向判定，见 `syncPrivateTree`） */\nconst PRIVATE_DIRS = ['.zn/private/notes', '.zn/private/trash']\n\n/**\n * 私密树单个文件的同步方向（**纯函数**，单测覆盖全部分支）。\n *\n * `localFp` / `remoteFp` / `baseFp` 都是指纹字符串或 `null`（null = 那边没有这个文件）。\n *\n * 与笔记同步的 `decideSync` **语义一致但不共用**：笔记那边删除了不会传播（保守），\n * 私密树这边**两边都传播** —— 私密笔记在面板里删除是真删除，不传播的话同步一轮就复活。\n */\nfunction decideTreeAction(localFp, remoteFp, baseFp) {\n  const l = localFp || null\n  const r = remoteFp || null\n  const b = baseFp || null\n  // 两边一致（或两边都没有）⇒ 只刷新 baseline\n  if (l === r) return 'noop'\n  // 远端有、本地没有\n  if (!l && r) return b ? 'delete-remote' : 'pull'\n  // 本地有、远端没有\n  if (l && !r) return b ? 'delete-local' : 'push'\n  // 两边都有、内容不同\n  const localChanged = l !== b\n  const remoteChanged = r !== b\n  if (!b) return 'conflict' // 没有基线且两边不同：谁都不该覆盖谁（与 `!base` 的笔记判据同一套）\n  if (remoteChanged && !localChanged) return 'pull'\n  if (localChanged && !remoteChanged) return 'push'\n  return 'conflict'\n}\n/** 单次同步最多处理多少篇（防止第一次全量时把界面吊死） */\nconst MAX_FILES_PER_RUN = 200\n/** 自动同步节拍：前台每 5 秒跑一次（坚果云 600 次/30min ≈ 12 次/分钟，5 秒正好 12 次） */\nconst AUTO_MS = 5000\n/**\n * **限流退避档位**（rev173.279 · 真人使用测试 #12「坚果云同步很容易触发限流」）。\n *\n * 5 秒一轮 = 360 次 / 30 分钟，加上附件与 manifest 的请求，撞上坚果云 600 次的上限很快\n * （真机截图：`下载失败（503）`）。旧行为是**撞上就永久停自动同步**（`stopAuto()` + 关开关 +\n * 让用户手动重开）—— 用户以为同步坏了，而且重开后又 5 秒一轮，很快再撞。\n *\n * 改成**指数退避**：15 s → 60 s → 300 s，任何一轮成功立刻复位回 5 s。\n * 认证失败（401 / 403）仍然立刻停 —— 那种情况重试只会让封禁更久。\n */\nconst BACKOFF_MS = [15000, 60000, 300000]\n/** 冲突记录上限 */\nconst MAX_CONFLICTS = 100\n/**\n * 耗时历史上限（rev173.119）。\n *\n * 只记「有变化」的轮次与手动同步 —— 静默的空转轮 5 秒一条，会把趋势冲成一条平线，\n * 而用户真正想看的是\"有活干那几轮要多久\"。\n */\nconst MAX_TIMING = 50\n\n/* ───────────────────────── 纯函数（tests/sync.test.ts 单测） ───────────────────────── */\n\n/** 内容指纹：长度 + FNV-1a 32 位（与 sync-folder 同一套，两边判据一致） */\nfunction fingerprint(text) {\n  const s = typeof text === 'string' ? text : String(text ?? '')\n  let h = 0x811c9dc5\n  for (let i = 0; i < s.length; i += 1) {\n    h ^= s.charCodeAt(i)\n    h = (h + (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24)) >>> 0\n  }\n  return `${s.length.toString(36)}:${h.toString(36)}`\n}\n\n/** 库内相对路径 → URL 段（逐段编码，保留 `/`；空格与中文都要编码） */\nfunction encodeDavPath(rel) {\n  return String(rel ?? '')\n    .split('/')\n    .filter((s) => s && s !== '.')\n    .map((s) => encodeURIComponent(s))\n    .join('/')\n}\n\n/**\n * Basic 认证头。**必须按 UTF-8 编码再 base64** —— `btoa('中文:密码')` 会抛\n * `InvalidCharacterError`（超出 Latin-1）。坚果云这类用邮箱当账号的没事，\n * 但用户自己填中文用户名就崩。\n */\nfunction basicAuth(user, pass) {\n  const bytes = new TextEncoder().encode(`${user ?? ''}:${pass ?? ''}`)\n  let bin = ''\n  for (let i = 0; i < bytes.length; i += 1) bin += String.fromCharCode(bytes[i])\n  return `Basic ${btoa(bin)}`\n}\n\n/** 把 `<base>/<root>/<rel>` 拼成一个合法 URL（去掉多余斜杠，但保留协议部分的 `//`） */\nfunction joinUrl(base, root, rel) {\n  const b = String(base ?? '').trim().replace(/\\/+$/, '')\n  const r = encodeDavPath(root)\n  const p = encodeDavPath(rel)\n  return [b, r, p].filter(Boolean).join('/')\n}\n\n/**\n * 解析 `PROPFIND Depth: 1` 的 207 XML。\n *\n * 容错要点（各家服务器都踩过）：\n * · 命名空间前缀不一定是 `d:`（Nextcloud 用 `d`，坚果云用 `D`，还有不写前缀的）；\n * · `<d:href>` 是**已编码**的绝对路径，要比 `decodeURIComponent` 之后才好用；\n * · 目录的 `resourcetype` 里带 `<d:collection/>`；\n * · `getetag` 可能带引号（原样保留 —— `If-Match` 要用一模一样的那串）。\n *\n * @returns {{ path: string, href: string, isDir: boolean, etag: string | null, size: number | null }[]}\n *          `path` 是**去掉同步根前缀**后的相对路径（根自身返回空串）\n */\n/** XML 实体解码（WebDAV 的 href 里 `&amp;` 很常见） */\nfunction decodeEntities(s) {\n  return String(s ?? '').replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, (m, ent) => {\n    const e = String(ent).toLowerCase()\n    if (e === 'lt') return '<'\n    if (e === 'gt') return '>'\n    if (e === 'amp') return '&'\n    if (e === 'quot') return '\"'\n    if (e === 'apos') return \"'\"\n    if (e.startsWith('#x')) return String.fromCodePoint(parseInt(e.slice(2), 16) || 0)\n    if (e.startsWith('#')) return String.fromCodePoint(parseInt(e.slice(1), 10) || 0)\n    return m\n  })\n}\n\n/** 从一段 XML 里取标签内容（容忍命名空间前缀与属性） */\nfunction pickTag(block, name) {\n  const re = new RegExp(`<(?:[\\\\w.-]+:)?${name}\\\\b[^>]*>([\\\\s\\\\S]*?)</(?:[\\\\w.-]+:)?${name}\\\\s*>`, 'i')\n  const m = re.exec(block)\n  return m ? m[1] : null\n}\n\n/**\n * 解析 `PROPFIND Depth: 1` 的 207 XML。\n *\n * **故意不用 `DOMParser`**（rev173.108 实测）：`happy-dom` 对 `application/xml` 的\n * `getElementsByTagNameNS` / CSS 选择器支持不完整（单测全红），而 WebDAV 的 207 结构是固定的\n * —— 一堆扁平的 `<response>`，每块里几个单值标签。用「切块 + 取标签」的正则更小、更可测，\n * 也不再依赖宿主对 XML 命名空间的支持（旧 Android WebView 一样跑）。\n *\n * 容错：前缀 `d:` / `D:` / 无前缀都认；`&amp;` 这类实体解码；坏数据返回空表而非抛错。\n *\n * @returns {{ path: string, href: string, isDir: boolean, etag: string | null, size: number | null }[]}\n *          `path` 是**去掉同步根前缀**后的相对路径（根自身被过滤掉）\n */\nfunction parsePropfind(xml, { rootPrefix = '' } = {}) {\n  const text = String(xml ?? '')\n  if (!text.trim()) return []\n  const blocks = [...text.matchAll(/<(?:[\\w.-]+:)?response\\b[^>]*>([\\s\\S]*?)<\\/(?:[\\w.-]+:)?response\\s*>/gi)].map(\n    (m) => m[1],\n  )\n  const prefix = rootPrefix ? decodeURIComponent(rootPrefix).replace(/\\/+$/, '') : ''\n\n  return blocks.map((block) => {\n    const rawHref = decodeEntities(pickTag(block, 'href') ?? '').trim()\n    const rawEtag = decodeEntities(pickTag(block, 'getetag') ?? '').trim()\n    const rawLen = decodeEntities(pickTag(block, 'getcontentlength') ?? '').trim()\n    const isDir = /<(?:[\\w.-]+:)?collection\\b/i.test(block) || /\\/$/.test(rawHref)\n\n    let path = ''\n    try {\n      path = decodeURIComponent(rawHref)\n    } catch {\n      path = rawHref\n    }\n    if (prefix && path.startsWith(prefix)) path = path.slice(prefix.length)\n    path = path.replace(/^\\/+/, '').replace(/\\/+$/, '')\n\n    const etag = rawEtag || null\n    const size = /^\\d+$/.test(rawLen) ? Number(rawLen) : null\n    // 根自身解析成空串（调用方按需过滤）\n    if (isDir && path === '') return { path: '', href: rawHref, isDir: true, etag, size: null }\n    return { path, href: rawHref, isDir, etag, size }\n  })\n}\n\n/**\n * 判定一篇该怎么走。\n *\n * @param {{fp: string, etag?: string} | null} base    上次同步时的版本\n * @param {string} localFp                              本地当前指纹\n * @param {string | null} remoteFp                      远端当前指纹（manifest 里的；`null` = 远端没有这篇）\n * @returns {'noop'|'push'|'pull'|'conflict'|'push-new'|'pull-new'|'remote-deleted'}\n */\nfunction decideSync({ base, localFp, remoteFp }) {\n  const hasBase = !!base\n  if (remoteFp == null) {\n    // 远端没有这篇\n    if (!hasBase) return 'push-new' // 本地新增\n    return base.fp === localFp ? 'remote-deleted' : 'conflict' // 远端删了、本地改过 ⇒ 冲突\n  }\n  if (!hasBase) {\n    /**\n     * 远端有、本地没有基线（换了设备 / store 被清 / 首次见这篇）：\n     * - 两边内容相同 ⇒ 直接对齐基线，不必白拉一次\n     * - 两边不同 ⇒ **不能假定远端更权威**：本机可能改过。以前一律 `pull-new`，\n     *   store 丢过就会静默用远端盖掉本地（丢字）。现在判冲突 ⇒ 本机版先留副本\n     *   再取远端版；history 同步点还在时会先试三方合并，合得上就两端一致。\n     */\n    if (localFp === remoteFp) return 'noop'\n    return 'conflict'\n  }\n  const localChanged = localFp !== base.fp\n  const remoteChanged = remoteFp !== base.fp\n  if (!localChanged && !remoteChanged) return 'noop'\n  if (remoteChanged && !localChanged) return 'pull'\n  if (!remoteChanged && localChanged) return 'push'\n  // 两边都变了；如果两边恰好变成同一个内容（同一份改动各自应用），不算冲突\n  return localFp === remoteFp ? 'noop' : 'conflict'\n}\n\n/**\n * 冲突时尝试**三方合并**（rev173.115）。\n *\n * 输入是三方：`base` = 上次成功同步时的内容（history 插件打的同步点）、\n * `mine` = 本机当前、`theirs` = 远端当前。只有**完全合上**（没有一处真冲突）才返回文本 ——\n * 有冲突段时两边都要人看，自动选一边会让用户以为\"已经合好了\"。\n *\n * 返回 `null` = 不合并，调用方走原来的「留两份 + 取远端」流程。\n *\n * @param {{ base?: string|null, mine?: string|null, theirs?: string|null, mergeLines?: Function }} args\n * @returns {{ text: string } | null}\n */\nfunction tryAutoMerge({ base, mine, theirs, mergeLines }) {\n  if (typeof base !== 'string' || typeof mine !== 'string' || typeof theirs !== 'string') return null\n  if (typeof mergeLines !== 'function') return null\n  // 只有一边变过 ⇒ 不是\"双端都改\"，交给 decideSync 的普通分支（这里合并没有意义）\n  if (base === mine || base === theirs) return null\n  let r\n  try {\n    r = mergeLines(base, mine, theirs)\n  } catch {\n    return null // 合并实现抛错 ⇒ 退回「留两份」，不丢字\n  }\n  if (!r || !Number.isFinite(r.conflicts) || r.conflicts > 0) return null\n  if (typeof r.text !== 'string') return null\n  // 合出来还是远端版 ⇒ 本机改动在远端已存在，没必要多写一次盘 + 一次 PUT\n  if (r.text === theirs) return null\n  return { text: r.text }\n}\n\n/** 冲突副本文件名（`.zn/conflicts/<平台>/<YYYY-MM-DD HHmm>-<名>.md`，与 sync-folder 同一套规则） */\nfunction conflictFileName(path, at, taken = () => false) {\n  const d = new Date(at)\n  const pad = (n) => String(n).padStart(2, '0')\n  const stamp = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}${pad(d.getMinutes())}`\n  const file = String(path ?? '').split('/').pop() || 'note.md'\n  const base = file.replace(/\\.md$/i, '') || 'note'\n  let name = `${stamp}-${base}.md`\n  let i = 2\n  while (taken(name)) {\n    name = `${stamp}-${base}-${i}.md`\n    i += 1\n  }\n  return name\n}\n\n/* ───────────────── 本地文件夹后端（`lib/backends/folder.cjs`）的纯函数 ───────────────── */\n\n/**\n * 本机版本**影子副本**目录（rev173.286 · 从 sync-folder 并入）。\n *\n * 本地文件夹后端不搬文件：库放在 Syncthing / OneDrive / 坚果云目录里，搬运交给那个工具。\n * 外部改了磁盘之后，**本机那一版就只剩这里** —— 所以 `note:saved` 时要另存一份。\n * 放在 `.zn/` 下（不进文件树），且必须让外部工具排除。\n */\nconst SNAPSHOT_DIR = '.zn/sync/last'\n/**\n * 静默期：本机保存后多久没人动过，就认为同步工具已经把它搬走了。\n * 20 秒够 Syncthing 传一轮；短了会把「还没传出”当成”已同步」，双端改会被静默覆盖。\n */\nconst SETTLE_MS = 20_000\n/** 结算节拍（只看时间戳，不碰磁盘） */\nconst TICK_MS = 5_000\n/** 本地文件夹后端的「本机改过、还没确认被搬走」记录 */\nconst KEY_PENDING = 'pending.v1'\n/**\n * **密码库私有目录**（rev173.164 · 期 1c）。要跨设备同步密码库，外部工具必须放行这三处\n * （`.zn/` 其余部分继续排除）。这里只用来检查它们有没有被外部工具造出冲突副本。\n */\nconst SECRET_DIRS = ['.zn/secrets', '.zn/security', '.zn/private']\n\n/** 两位补零 */\nfunction pad2(n) {\n  return String(n).padStart(2, '0')\n}\n\n/** 短散列（路径 → 影子副本文件名用），同一套实现，不为它引第二个算法 */\nfunction shortHash(s) {\n  return fingerprint(String(s ?? '')).split(':')[1] ?? '0'\n}\n\n/** 影子副本路径（`<库>/.zn/sync/last/<hash32>.md`） */\nfunction snapshotPath(path) {\n  return `${SNAPSHOT_DIR}/${shortHash(path)}.md`\n}\n\n/**\n * 这条路径算不算要同步的笔记。\n *\n * **必须排掉 `.zn/`**：影子副本、冲突副本都是 `.md`，内核 rev173.107 已不再为它们发\n * `note:saved`，插件这一侧也自己判一道 —— 一旦漏过来就**自我递归**\n * （实测踩过：每写一份副本又触发一次保存，几秒内 1900 多次 writeText）。\n */\nfunction isSyncable(path) {\n  const s = String(path ?? '')\n  if (!/\\.md$/i.test(s)) return false\n  if (s.startsWith('.zn/') || s === '.zn') return false\n  return !s.split('/').includes('.zn')\n}\n\n/**\n * 文件名像不像「外部同步工具自己造的冲突副本」——`.zn/` **没被排除**的痕迹（rev173.114）。\n *\n * 插件管不到 Syncthing / OneDrive / 坚果云的排除配置，但可以在私有目录里找它们留下的指纹：\n * · Syncthing：`<名>.sync-conflict-20261024-123456-ABCDEF.md`\n * · OneDrive / Windows：`<名>-主机名.md`、`<名> (conflicted copy).md`\n * · 坚果云 / 中文客户端：`<名> (冲突副本).md`\n *\n * 注意：**不能**把 `2026-10-24 2053-双链验收.md` 这种我们自己的冲突副本当命中\n * （没有「副本 / 冲突」关键词）。\n */\nfunction looksLikeSyncConflict(name) {\n  const s = String(name ?? '')\n  if (!s) return false\n  return /\\.sync-conflict-/i.test(s) || /conflicted copy/i.test(s) || /\\(冲突/.test(s) || /冲突副本/.test(s)\n}\n\n/**\n * 判定一次外部改动 —— **本地文件夹后端的心脏**（原 `sync-folder` 的 `classifyChange`）。\n *\n * 三种状态：`baseline[path]` = 双方一致的版本 · `pending[path]` = 本机改过、还没确认被搬走 ·\n * `remoteFp` = 磁盘上现在的指纹。\n *\n * 为什么保存时不直接更新 baseline：那样「本机改完、同步还没传出去、对端又改了」会变成\n * 「只有外部变了」⇒ 本地改动被静默覆盖。所以保存只写 pending，等 `SETTLE_MS` 静默期\n * 才升为 baseline。\n *\n * | baseline | pending | 磁盘指纹 | 结论 |\n * |---|---|---|---|\n * | 无 | 无 | 任意 | `new` ⇒ 收下并记基线 |\n * | 有 | 无 | == baseline | `noop` |\n * | 有 | 无 | != baseline | `remote` ⇒ 别处更新，收下 |\n * | 有 | 有（内容） | == pending | `noop`（自己那版被同步工具搬回来了） |\n * | 有 | 有（内容） | != pending 且 != baseline | `conflict` ⇒ 留副本 |\n * | 有 | 有（删除） | 任意 | `remote` ⇒ 本地删了但别处还有，**恢复别处的** |\n *\n * @param {{fp?: string} | null | undefined} base    基线版本\n * @param {{fp?: string, deleted?: boolean} | null | undefined} pending 本机待同步版本\n * @param {string} remoteFp                          磁盘上的当前指纹\n * @returns {'new'|'noop'|'remote'|'conflict'|'local-pending'}\n */\nfunction classifyChange({ base, pending, remoteFp }) {\n  const hasPending = !!(pending && (pending.deleted || pending.fp))\n  if (!base && !hasPending) return 'new'\n  if (!hasPending) return base.fp === remoteFp ? 'noop' : 'remote'\n  // 本机删过：别处还有这文件 ⇒ 恢复别处的（方案 A：本地删、外部改 ⇒ 恢复外部版）\n  if (pending.deleted) return 'remote'\n  if (pending.fp === remoteFp) return 'noop'\n  if (base && base.fp === remoteFp) return 'local-pending'\n  return 'conflict'\n}\n\n/** 远端 manifest 的形状校验（坏数据当作空，不让同步整个停摆） */\nfunction normalizeManifest(raw) {\n  try {\n    const j = typeof raw === 'string' ? JSON.parse(raw) : raw\n    const files = j && typeof j === 'object' && j.files && typeof j.files === 'object' ? j.files : {}\n    const out = {}\n    for (const [path, v] of Object.entries(files)) {\n      if (!v || typeof v !== 'object') continue\n      if (typeof v.fp !== 'string') continue\n      out[path] = {\n        fp: v.fp,\n        /**\n         * `etag` 是统一后的字段名；**老 Git manifest 里叫 `sha`**（rev173.288 兼容）——\n         * 不认它的话，老仓库升上来首轮会丢掉乐观锁版本号（不会丢数据，但少了保护）。\n         */\n        etag: typeof v.etag === 'string' ? v.etag : typeof v.sha === 'string' ? v.sha : undefined,\n        at: Number(v.at) || 0,\n      }\n    }\n    // 附件段（rev173.109）：`cleaned` = 中转模式下云端副本已删（本地还留着）\n    const atts = j && typeof j === 'object' && j.attachments && typeof j.attachments === 'object' ? j.attachments : {}\n    const attachments = {}\n    for (const [path, v] of Object.entries(atts)) {\n      if (!v || typeof v !== 'object') continue\n      if (typeof v.fp !== 'string') continue\n      attachments[path] = {\n        fp: v.fp,\n        ext: typeof v.ext === 'string' ? v.ext : '',\n        at: Number(v.at) || 0,\n        ...(v.cleaned ? { cleaned: true } : {}),\n        // `mode` 记录**上传方**当时的模式（rev173.126）：取文件时按它决定去原路径还是 `_zn/relay/`，\n        // 否则一台 full、一台 relay 时 relay 那台永远找不到文件\n        ...(v.mode === 'full' || v.mode === 'relay' ? { mode: v.mode } : {}),\n      }\n    }\n    /**\n     * 私有文件段（rev173.164 · 期 1c）：密码库这类**不进 `listNotes`** 的密文\n     * （不是 `.md`、又在 `.zn/` 下），按固定清单单独搬运。\n     */\n    const privs = j && typeof j === 'object' && j.private && typeof j.private === 'object' ? j.private : {}\n    const priv = {}\n    for (const [rel, v] of Object.entries(privs)) {\n      if (!v || typeof v !== 'object') continue\n      if (typeof v.fp !== 'string') continue\n      priv[rel] = { fp: v.fp, at: Number(v.at) || 0 }\n    }\n    /**\n     * 私密文件夹树（rev173.182 · 期 3）：与 `private` 同形状，只是**数量可变**\n     * （每篇私密笔记一个密文）。老 manifest 没有这一段 ⇒ 空对象（首轮全部当\"新\"推上去）。\n     */\n    const trees = j && typeof j === 'object' && j.privateTree && typeof j.privateTree === 'object' ? j.privateTree : {}\n    const privateTree = {}\n    for (const [rel, v] of Object.entries(trees)) {\n      if (!v || typeof v !== 'object') continue\n      if (typeof v.fp !== 'string') continue\n      privateTree[rel] = { fp: v.fp, at: Number(v.at) || 0 }\n    }\n    return { version: 1, files: out, attachments, private: priv, privateTree }\n  } catch {\n    return { version: 1, files: {}, attachments: {}, private: {}, privateTree: {} }\n  }\n}\n\n/**\n * 二进制指纹：长度 + FNV-1a（逐字节）。\n *\n * 为什么单独一个：文本那份按 `charCodeAt` 走，UTF-16 码元与 UTF-8 字节对不上 ——\n * 拿它给图片算指纹，两端算出来的值会不同（同一张 PNG 在不同编码路径上指纹不一致），\n * 于是每次同步都以为\"变了\"。\n */\nfunction fingerprintBytes(bytes) {\n  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes ?? [])\n  let h = 0x811c9dc5\n  for (let i = 0; i < u8.length; i += 1) {\n    h ^= u8[i]\n    h = (h + (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24)) >>> 0\n  }\n  return `${u8.length.toString(36)}:${h.toString(36)}`\n}\n\n/** 附件扩展名（含点，小写）；没有就空串 */\nfunction extOf(path) {\n  const name = String(path ?? '').split('/').pop() ?? ''\n  const i = name.lastIndexOf('.')\n  return i > 0 ? name.slice(i).toLowerCase() : ''\n}\n\n/** 父目录（库内相对路径，无父目录时返回空串） */\nfunction dirOf(path) {\n  const s = String(path ?? '')\n  const i = s.lastIndexOf('/')\n  return i > 0 ? s.slice(0, i) : ''\n}\n\n/** 这条路径算不算「附件」（图片 / PDF / 任意非 Markdown 文件，且不在 `.zn/` 里） */\nfunction isAttachment(path) {\n  const s = String(path ?? '')\n  if (!s) return false\n  if (s.startsWith('.zn/') || s.split('/').includes('.zn')) return false\n  return !/\\.(md|markdown)$/i.test(s)\n}\n\n/**\n * 远端这条附件要不要拉到本地（rev173.117）。\n *\n * 以前只看「本地有没有这个路径」（`localPaths.has(path)`）—— 远端把 **同一路径的图换掉**\n * （改图 / 重新截图 / 别的设备覆盖）时，本地永远停在旧版本，同步看起来\"没事\"。\n * 现在按 manifest 的 `fp` 判：\n *\n * · 远端 `cleaned`（中转模式已清理）⇒ 不拉\n * · 本地没有 ⇒ 拉\n * · 本地指纹与远端不同 ⇒ 拉（远端更新过）\n * · 相同 ⇒ 不拉\n *\n * @param {string|null} localFp 本地现有文件的指纹；没有这份就传 null\n * @param {{fp?: string, cleaned?: boolean}|null} remoteEntry\n */\nfunction needsAttachmentPull(localFp, remoteEntry) {\n  if (!remoteEntry || remoteEntry.cleaned) return false\n  if (!localFp) return true\n  return localFp !== remoteEntry.fp\n}\n\n/**\n * 耗时给人看的写法（rev173.117 同步耗时统计）。\n *\n * 小于 1 秒说毫秒（\"320 毫秒\"比\"0.3 秒\"更少歧义），1 秒以上保留一位小数；\n * 10 秒以上不带小数（\"12 秒\"），避免面板宽度抖动。\n */\nfunction fmtMs(ms) {\n  const n = Number(ms)\n  if (!Number.isFinite(n) || n < 0) return '—'\n  if (n < 1000) return `${Math.round(n)} 毫秒`\n  if (n < 10000) return `${(n / 1000).toFixed(1)} 秒`\n  return `${Math.round(n / 1000)} 秒`\n}\n\n/**\n * 追加一条耗时记录（rev173.119）。\n *\n * `limit` 之外的旧记录丢掉 —— 面板只需要看最近的趋势，不是审计日志。\n * 非数组 / 坏条目一律容错成空表起步（store 里的数据可能是上一版写的）。\n */\nfunction pushTiming(history, entry, limit = MAX_TIMING) {\n  const list = Array.isArray(history) ? history.filter((e) => e && typeof e === 'object') : []\n  const next = [...list, entry]\n  return next.length > limit ? next.slice(next.length - limit) : next\n}\n\n/**\n * 最近若干次的耗时摘要（rev173.119）：`{ count, avg, max }`。\n * 没有可用记录返回 `null`（面板据此决定画不画这一行）。\n */\nfunction timingSummary(history) {\n  const list = (Array.isArray(history) ? history : []).filter((e) => e && Number.isFinite(e.total))\n  if (!list.length) return null\n  let sum = 0\n  let max = 0\n  for (const e of list) {\n    sum += e.total\n    if (e.total > max) max = e.total\n  }\n  return { count: list.length, avg: Math.round(sum / list.length), max: Math.round(max) }\n}\n\n/** sparkline 的八档字符（低 → 高） */\nconst SPARK = '▁▂▃▄▅▆▇█'\n\n/**\n * 字符 sparkline（rev173.119）：把一组耗时映射成 `▁▂▃▄▅▆▇█` 的走势。\n *\n * 三条约定（都对应一个\"画出来会误导人\"的坑）：\n * · 只取**最后 `width` 个** —— 趋势看最近的，早期的慢轮不该压扁现在的波形；\n * · 全部相等时用中间档（`▄`）—— `min === max` 除零会得到 `NaN` 索引、直接崩；\n * · 最大值 ≤ 0（异常数据）时全用最低档，不抛错。\n */\nfunction sparkline(values, width = 24) {\n  const nums = (Array.isArray(values) ? values : []).filter((v) => Number.isFinite(v))\n  if (!nums.length) return ''\n  const tail = nums.slice(-Math.max(1, width))\n  const min = Math.min(...tail)\n  const max = Math.max(...tail)\n  if (max <= 0) return SPARK[0].repeat(tail.length)\n  const span = max - min\n  return tail\n    .map((v) => {\n      if (span === 0) return SPARK[3]\n      const i = Math.round(((v - min) / span) * (SPARK.length - 1))\n      return SPARK[Math.max(0, Math.min(SPARK.length - 1, i))]\n    })\n    .join('')\n}\n\n/**\n * 中转文件 / ack 标记的**远端文件名**。\n *\n * ⚠️ **必须把指纹里的 `:` 换掉**（rev173.109 实测）：`fingerprint` 的格式是 `<长度>:<散列>`，\n * 直接拿来当文件名时，Windows 会把它当 **NTFS 备用数据流** —— `fs.writeFile('8tj:1te3kiy.png')`\n * 只建出一个 0 字节的 `8tj`（内容进了流里），远端看到的就是空文件。\n * 顺带也避开 `/` `\\` 这些在各家 DAV 实现里含义不一的字符。\n */\nfunction relayName(fp, ext) {\n  return `${String(fp ?? '').replace(/[:/\\\\]/g, '-')}${ext || ''}`\n}\n\nmodule.exports = {\n  PRIVATE_FILES,\n  PRIVATE_ROOT_FILES,\n  PRIVATE_DIRS,\n  PANEL_ID,\n  KEY_SETTINGS,\n  KEY_BASELINE,\n  KEY_CONFLICTS,\n  KEY_DEVICE,\n  KEY_TIMING,\n  SECRET_KEY,\n  CONFLICT_ROOT,\n  MANIFEST_REL,\n  MAX_FILES_PER_RUN,\n  AUTO_MS,\n  BACKOFF_MS,\n  MAX_CONFLICTS,\n  MAX_TIMING,\n  SPARK,\n  SNAPSHOT_DIR,\n  SETTLE_MS,\n  TICK_MS,\n  KEY_PENDING,\n  SECRET_DIRS,\n  pad2,\n  shortHash,\n  snapshotPath,\n  isSyncable,\n  looksLikeSyncConflict,\n  classifyChange,\n  decideTreeAction,\n  fingerprint,\n  encodeDavPath,\n  basicAuth,\n  joinUrl,\n  parsePropfind,\n  decideSync,\n  tryAutoMerge,\n  conflictFileName,\n  normalizeManifest,\n  fingerprintBytes,\n  extOf,\n  dirOf,\n  isAttachment,\n  needsAttachmentPull,\n  fmtMs,\n  pushTiming,\n  timingSummary,\n  sparkline,\n  relayName,\n}",
    "signature.json": "{\n  \"alg\": \"ed25519\",\n  \"keyId\": \"aqua-2026\",\n  \"sig\": \"OT4r7PxIgjeBzm8m9cGeZu/pMZq63RYi/95GygOLkc3QCAUX4f9pi3kSsQ0wEBiVKOr2k5V+4vhKxDqcUVopDA==\"\n}\n"
  }
}
