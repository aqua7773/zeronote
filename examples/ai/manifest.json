{
  "manifestVersion": 1,
  "id": "ai",
  "name": "AI 管家",
  "version": "0.6.0",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "对话式 AI 管家：用一句话定义任务，按事件 / 定时 / 手动触发自动干活（第二版可调用户授权的插件命令）",
  "category": "tool",
  "capabilities": [
    "fs:read",
    "fs:write",
    "doc:read",
    "doc:write",
    "index:query",
    "command",
    "view:main",
    "store",
    "net"
  ],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "ai.open", "title": "AI：打开对话" },
      { "id": "ai.set-provider", "title": "AI：切换服务商" },
      { "id": "ai.save-key", "title": "AI：保存 API Key" },
      { "id": "ai.clear-key", "title": "AI：删除 API Key" },
      { "id": "ai.save-model", "title": "AI：保存模型名" },
      { "id": "ai.save-baseurl", "title": "AI：保存自有端点" },
      { "id": "ai.test", "title": "AI：测试连接" },
      { "id": "ai.send", "title": "AI：发送消息" },
      { "id": "ai.stop", "title": "AI：停止生成" },
      { "id": "ai.clear", "title": "AI：新对话" },
      { "id": "ai.accept", "title": "AI：采用待确认的改动" },
      { "id": "ai.reject", "title": "AI：放弃待确认的改动" },
      { "id": "ai.tasks", "title": "AI：打开任务面板" },
      { "id": "ai.task-toggle", "title": "AI：启用 / 停用任务" },
      { "id": "ai.task-run", "title": "AI：立即跑一个任务" },
      { "id": "ai.task-runs", "title": "AI：展开 / 收起任务运行记录" },
      { "id": "ai.task-delete", "title": "AI：删除任务" },
      { "id": "ai.wizard-done", "title": "AI：完成首次配置向导" },
      { "id": "ai.toggle-command", "title": "AI：允许 / 撤销某条插件命令" },
      { "id": "ai.sample", "title": "AI：分类抽样（20 篇，人工核对）" }
    ],
    "panels": [
      { "id": "ai.chat", "title": "AI", "location": "main" },
      { "id": "ai.tasks", "title": "AI 任务", "location": "main" }
    ]
  }
}
