        {
          "id": "accounting.exportCsv",
          "title": "记账：导出 CSV"
        },
        {
          "id": "accounting.importCsv",
          "title": "记账：导入 CSV（微信/支付宝账单）"
        },
        {
          "id": "accounting.diag",
          "title": "记账：原始通知诊断"
        },
        {
          "id": "accounting.backToList",
          "title": "记账：返回账单列表"
        },
        {
          "id": "accounting.check",
          "title": "记账：检查通知权限"
        },
        {
          "id": "accounting.openSettings",
          "title": "记账：打开通知使用权设置"
        },
        {
          "id": "accounting.addExpense",
          "title": "记账：记一笔支出"
        },
        {
          "id": "accounting.addIncome",
          "title": "记账：记一笔收入"
        },
        {
          "id": "accounting.editCategory",
          "title": "记账：改这笔的分类"
        },
        {
          "id": "accounting.pickCategory",
          "title": "记账：选定分类"
        },
        {
          "id": "accounting.cancelEdit",
          "title": "记账：取消改分类"
        },
        {
          "id": "accounting.addCategory",
          "title": "记账：新增自定义分类"
        }
      ],
      "panels": [
        {
          "id": "accounting.ledger",
          "title": "记账",
          "location": "main"
        }
      ]
    },
    "sha256": "6e2cc12f8213cb9b062b5ff38a12c7ec049e40e3fcadb05126d34e28a59db42e"
  },
  "files": {
    "index.js": "/**\n * ZeroNote 记账插件 v0.1（2026-10-19 rev173.16）\n *\n * 数据流：\n *   原生 NotificationCaptureService（白名单 + 去重 + 缓存）\n *     → 本插件「同步通知」命令调 `plugin:notification-capture|drain`\n *     → parseNotification() 解析金额/收支/商户 → classify() 自动分类\n *     → 跨来源去重（微信 + 银行同金额）→ store 落库\n *\n * 设计：**单文件**（v0.1 的插件经 Blob URL 加载，相对导入解析不了）；\n * 解析/分类写成命名导出，`tests/accounting-parse.test.ts` 直接单测。\n *\n * 平台：手机端是主战场（通知捕获）；桌面可手动记账，`drain` 返回空数组。\n */\n\nconst PANEL_ID = 'accounting.ledger'\nconst STORE_KEY = 'transactions'\n/** 用户改分类后学到的「商户 → 分类」（与内置规则分开存，便于以后清空重学） */\nconst CATEGORY_KEY = 'categoryMap'\n/** 用户自定义的分类列表（未设置时用内置 CATEGORIES） */\nconst CATEGORY_LIST_KEY = 'categories'\nconst MAX_TX = 500\n/** 每月分类预算（rev173.73）：`{ 分类: 金额 }` —— 金额跨月沿用，消耗每月重算 */\nconst BUDGET_KEY = 'budgets'\n/** 手动改分类时可选的分类 */\nconst CATEGORIES = ['餐饮', '交通', '购物', '通讯', '居住', '医疗', '娱乐', '收入', '其他']\n\n/** 最近一次同步拿到的**原始通知**（诊断用；只存本机 store，不导出、不上传） */\nconst RAW_KEY = 'rawNotices'\nconst MAX_RAW = 20\n\n/* ───────────────────────── 纯函数（可单测） ───────────────────────── */\n\nconst pad = (n) => String(n).padStart(2, '0')\n\n/** 毫秒 → 「YYYY-MM」月份键（统计按自然月分组） */\nexport function monthKey(ms) {\n  const d = new Date(ms)\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}`\n}\n\n/** 明显不是账单的通知（验证码、还款提醒、余额播报…）——先杀掉，避免误记 */\nconst IGNORE = [/验证码/, /已过期/, /已失效/, /已还清/, /还款成功/, /余额/, /账单已出/, /积分/]\n\nconst PAY_PHRASES = [\n  '付款成功',\n  '支付成功',\n  '收款到账',\n  '转账成功',\n  '已支付',\n  '已收款',\n  '向你转账',\n  '向你付款',\n  '红包',\n  '收款',\n  '付款',\n  '转账',\n  '到账',\n  '消费',\n  '扣款',\n]\n\n/**\n * 「已完成支付」短语（项目 rev173.75 / 记账子项 173.77）：**没金额也认**。\n *\n * 为什么：`isPaymentNotice` 以前要求「有金额，或含 收款/付款/转账/红包」，\n * 于是「微信支付｜支付成功 美团外卖」这类**不重复写金额**的完成通知被直接丢掉\n * （rev173.73 实测发现 ②）。用户 2026-10-21 选「放宽 + 加单笔删除」：\n * 这类通知进「金额待补」，误记了可以在列表里删掉。\n *\n * 只收**完成态**：`付款 / 收款 / 转账` 这类方向词无金额时多半是提醒或营销文案，不全放。\n */\nconst DONE_PHRASES = ['支付成功', '付款成功', '已支付', '已付款', '扣款成功', '消费成功']\n\nconst INCOME_WORDS = [\n  '到账',\n  '收入',\n  '收到',\n  '收款',\n  '转入',\n  '进账',\n  '红包',\n  '退款',\n  '已收',\n  '已到账',\n  '入账',\n  '给你转账',\n  '转给你',\n  '向你付款',\n]\n\nconst EXPENSE_WORDS = [\n  '支付',\n  '付款',\n  '消费',\n  '支出',\n  '转出',\n  '扣费',\n  '已付',\n  '扣款',\n  '缴费',\n  '充值',\n  '转账成功',\n  '已转账',\n]\n\n/** 商户 → 分类（用户 2026-10-19 要「自动分类」；先内置常用商户，后续加学习） */\nconst MERCHANT_MAP = {\n  美团: '餐饮',\n  饿了么: '餐饮',\n  星巴克: '咖啡',\n  瑞幸: '咖啡',\n  Manner: '咖啡',\n  肯德基: '餐饮',\n  麦当劳: '餐饮',\n  海底捞: '餐饮',\n  滴滴: '交通',\n  高德: '交通',\n  地铁: '交通',\n  公交: '交通',\n  加油: '交通',\n  中石化: '交通',\n  中石油: '交通',\n  12306: '交通',\n  京东: '购物',\n  淘宝: '购物',\n  天猫: '购物',\n  拼多多: '购物',\n  唯品会: '购物',\n  盒马: '购物',\n  永辉: '购物',\n  沃尔玛: '购物',\n  中国移动: '通讯',\n  中国联通: '通讯',\n  中国电信: '通讯',\n  话费: '通讯',\n  电费: '居住',\n  水费: '居住',\n  燃气: '居住',\n  物业: '居住',\n  医院: '医疗',\n  药房: '医疗',\n  药店: '医疗',\n  影院: '娱乐',\n  电影: '娱乐',\n  腾讯视频: '娱乐',\n  爱奇艺: '娱乐',\n  工资: '收入',\n  奖金: '收入',\n  报销: '收入',\n}\n\nconst KEYWORDS = [\n  [/外卖|餐饮|饭店|餐厅|美食|咖啡|奶茶/, '餐饮'],\n  [/打车|出行|地铁|公交|加油|机票|火车|高铁|停车/, '交通'],\n  [/超市|便利店|购物|商城|京东|淘宝|拼多多|电商/, '购物'],\n  [/话费|流量|宽带|中国移动|中国联通|中国电信/, '通讯'],\n  [/电费|水费|燃气|物业|房租|家政/, '居住'],\n  [/医院|药房|药店|挂号|体检|疫苗/, '医疗'],\n  [/电影|影院|游戏|会员|视频/, '娱乐'],\n  [/工资|奖金|报销|退款|收款/, '收入'],\n]\n\n/** 从一段通知文本里找金额（按优先级，最后才用\"带小数的数字\"兜底） */\nexport function extractAmount(text) {\n  if (!text) return null\n  const patterns = [\n    /[¥￥]\\s*(\\d+(?:\\.\\d{1,2})?)/,\n    /(\\d+(?:\\.\\d{1,2})?)\\s*元/,\n    /(?:金额|收款|付款|转账|红包|到账|成功)[：:\\s]*(\\d+(?:\\.\\d{1,2})?)/,\n    /(\\d+\\.\\d{1,2})/,\n  ]\n  for (const p of patterns) {\n    const m = p.exec(text)\n    if (!m) continue\n    const v = Number(m[1])\n    if (Number.isFinite(v) && v > 0) return v\n  }\n  return null\n}\n\n/** 这条通知像不像「一笔交易」 */\nexport function isPaymentNotice(title, text) {\n  const s = `${title || ''} ${text || ''}`\n  if (!s.trim()) return false\n  if (IGNORE.some((re) => re.test(s))) return false\n  const hasPhrase = PAY_PHRASES.some((p) => s.includes(p))\n  if (!hasPhrase) return false\n  // 有金额 ⇒ 认；明确收付/转账/红包 ⇒ 认（金额可后补）；\n  // 完成态短语（支付成功…）⇒ 也认，进「金额待补」（rev173.75）\n  return (\n    extractAmount(s) !== null ||\n    /收款|付款|转账|红包/.test(s) ||\n    DONE_PHRASES.some((p) => s.includes(p))\n  )\n}\n\n/** 收入 / 支出（收入关键词优先，默认支出） */\nexport function detectType(title, text) {\n  const s = `${title || ''}${text || ''}`\n  if (INCOME_WORDS.some((w) => s.includes(w))) return 'income'\n  if (EXPENSE_WORDS.some((w) => s.includes(w))) return 'expense'\n  return 'expense'\n}\n\n/** 商户 / 对方名称 —— 匹配不到就用 App 名兜底 */\nexport function extractMerchant(title, text, app) {\n  const s = `${title || ''} ${text || ''}`\n  const patterns = [\n    /商户[：:]\\s*([^，。|\\s]{1,20})/,\n    /收款方[：:]\\s*([^，。|\\s]{1,20})/,\n    /向(.{1,20}?)付款/,\n    /(?:在|于)(.{1,20}?)支付/,\n    /(.{1,20}?)订单支付/,\n    /给(.{1,20}?)转账/,\n    /来自(.{1,20}?)(?:\\s|$)/,\n  ]\n  for (const p of patterns) {\n    const m = p.exec(s)\n    const v = m && m[1] ? m[1].trim() : ''\n    if (v) return v\n  }\n  const t = (title || '').trim()\n  if (t && t.length <= 20 && !/微信|支付宝/.test(t)) return t\n  return app || '未知商户'\n}\n\n/** 自动分类：用户改过的映射 → 商户表 → 关键词 → 「其他」 */\nexport function classify(merchant, text, userMap = {}) {\n  const m = merchant || ''\n  // 学习层：用户在面板里改过一次分类 ⇒ 下次同商户直接命中\n  for (const [k, cat] of Object.entries(userMap || {})) {\n    if (k && m.includes(k)) return cat\n  }\n  for (const [k, cat] of Object.entries(MERCHANT_MAP)) {\n    if (m.includes(k) || (text || '').includes(k)) return cat\n  }\n  for (const [re, cat] of KEYWORDS) {\n    if (re.test(m) || re.test(text || '')) return cat\n  }\n  return '其他'\n}\n\n/**\n * 通知原文 → 交易记录（不像交易就返回 null）。\n * `n` = `{ pkg, app, title, text, time }`（原生缓存的结构）；\n * `userMap` = 用户改分类后学到的 `商户 → 分类`（可省略）。\n */\nexport function parseNotification(n, userMap = {}) {\n  if (!n || !n.text) return null\n  const title = n.title || ''\n  const text = n.text || ''\n  if (!isPaymentNotice(title, text)) return null\n  const amount = extractAmount(text) ?? 0\n  const type = detectType(title, text)\n  const merchant = extractMerchant(title, text, n.app)\n  const time = Number(n.time) || Date.now()\n  return {\n    id: `tx-${time}-${(n.pkg || 'unknown').split('.').pop()}`,\n    amount,\n    type,\n    merchant,\n    category: classify(merchant, text, userMap),\n    source: n.app || n.pkg || '通知',\n    pkg: n.pkg || '',\n    time,\n    raw: `${title} | ${text}`.slice(0, 300),\n    status: amount > 0 ? 'confirmed' : 'pending',\n  }\n}\n\n/**\n * 跨来源去重：同金额、同方向、时间窗内（默认 90s）且**来源不同** ⇒ 认为是同一笔\n * （微信支付 + 银行扣款各来一条）。保留先到的那条。\n */\nexport function dedupeTransactions(list, windowMs = 90000) {\n  const out = []\n  for (const tx of list) {\n    const dup = out.find(\n      (x) =>\n        x.amount === tx.amount &&\n        x.type === tx.type &&\n        Math.abs(x.time - tx.time) <= windowMs &&\n        x.pkg !== tx.pkg,\n    )\n    if (!dup) out.push(tx)\n  }\n  return out\n}\n\n/**\n * 诊断：这条通知**为什么没被记上**（`parseNotification` 返回 null 时的原因）。\n * 只解释、不改写——用于「原始通知」视图，让用户能对照原文补规则。\n */\nexport function describeNotice(n, userMap = {}) {\n  const tx = parseNotification(n, userMap)\n  if (tx) return { ok: true, reason: '' }\n  if (!n || !(`${n.title || ''}${n.text || ''}`.trim())) {\n    return { ok: false, reason: '空通知' }\n  }\n  const s = `${n.title || ''} | ${n.text || ''}`\n  const ignored = IGNORE.find((re) => re.test(s))\n  if (ignored) return { ok: false, reason: `命中忽略规则 ${ignored}（验证码/还款/余额类）` }\n  if (!PAY_PHRASES.some((p) => s.includes(p))) {\n    return { ok: false, reason: '没有支付短语（付款成功 / 收款到账 / 转账…）' }\n  }\n  if (extractAmount(s) === null) return { ok: false, reason: '有支付短语，但没找到金额' }\n  return { ok: false, reason: '未知原因' }\n}\n\n/* ───────────────────── 统计（rev173.28）───────────────────── */\n\n/** 某年某月（month 1–12）的**支出**按分类汇总；降序，pct 为占本月支出的比例 */\nexport function summarizeByCategory(txs, year, month) {\n  const key = `${year}-${pad(month)}`\n  const list = (txs || []).filter(\n    (t) =>\n      t &&\n      t.type === 'expense' &&\n      Number.isFinite(Number(t.amount)) &&\n      monthKey(t.time) === key,\n  )\n  const total = list.reduce((s, t) => s + Number(t.amount), 0)\n  const map = new Map()\n  for (const t of list) {\n    const category = t.category || '其他'\n    const row = map.get(category) || { category, amount: 0, count: 0 }\n    row.amount += Number(t.amount)\n    row.count += 1\n    map.set(category, row)\n  }\n  const rows = [...map.values()].sort((a, b) => b.amount - a.amount)\n  return { total, rows: rows.map((r) => ({ ...r, pct: total > 0 ? r.amount / total : 0 })) }\n}\n\n/**\n * 预算执行情况（rev173.73）：本月每个**设了预算**的分类花了多少、剩多少、超没超。\n *\n * `budgets` = `{ 分类: 金额 }`；只统计 `type === 'expense'` 且落在该月的记录。\n * 顺序：超支的排前面，再按使用率降序（统计视图直接按这个顺序画）。\n */\nexport function budgetStatus(txs, budgets, year, month) {\n  const key = `${year}-${pad(month)}`\n  const spent = new Map()\n  for (const t of txs || []) {\n    if (!t || t.type !== 'expense') continue\n    if (monthKey(t.time) !== key) continue\n    const c = t.category || '其他'\n    spent.set(c, (spent.get(c) || 0) + Number(t.amount || 0))\n  }\n  const rows = []\n  for (const [category, raw] of Object.entries(budgets || {})) {\n    const budget = Number(raw)\n    if (!(budget > 0)) continue\n    const used = spent.get(category) || 0\n    rows.push({\n      category,\n      budget,\n      spent: used,\n      left: budget - used,\n      over: used > budget,\n      pct: Math.min(1, used / budget),\n    })\n  }\n  return rows.sort((a, b) => Number(b.over) - Number(a.over) || b.pct - a.pct)\n}\n\n/** 近 n 个月（含本月）的支出/收入，按月升序；没有记录的月份补 0 */\nexport function monthlyTrend(txs, n = 6, now = Date.now()) {\n  const base = new Date(now)\n  const out = []\n  for (let i = n - 1; i >= 0; i--) {\n    const d = new Date(base.getFullYear(), base.getMonth() - i, 1)\n    const key = `${d.getFullYear()}-${pad(d.getMonth() + 1)}`\n    const list = (txs || []).filter((t) => t && monthKey(t.time) === key)\n    const sum = (type) =>\n      list.filter((t) => t.type === type).reduce((s, t) => s + (Number(t.amount) || 0), 0)\n    out.push({\n      key,\n      label: `${d.getMonth() + 1}月`,\n      expense: sum('expense'),\n      income: sum('income'),\n    })\n  }\n  return out\n}\n\n/** SVG 柱状图（近 n 月支出）。颜色全走主题变量，自动跟随深浅色 */\nexport function trendSvg(trend) {\n  const W = 320\n  const H = 132\n  const padL = 6\n  const padR = 6\n  const padT = 18\n  const padB = 24\n  const n = Math.max(1, trend.length)\n  const max = Math.max(1, ...trend.map((m) => Number(m.expense) || 0))\n  const innerW = W - padL - padR\n  const innerH = H - padT - padB\n  const slot = innerW / n\n  const barW = Math.min(26, slot * 0.5)\n  const bars = trend\n    .map((m, i) => {\n      const value = Number(m.expense) || 0\n      const x = padL + slot * i + (slot - barW) / 2\n      const h = value > 0 ? Math.max(2, (value / max) * innerH) : 0\n      const y = padT + innerH - h\n      const cx = (x + barW / 2).toFixed(1)\n      const label = esc(String(m.label))\n      const valueText = value > 0 ? esc(fmtShort(value)) : ''\n      return (\n        `<g>` +\n        `<rect x=\"${x.toFixed(1)}\" y=\"${y.toFixed(1)}\" width=\"${barW.toFixed(\n          1,\n        )}\" height=\"${h.toFixed(1)}\" rx=\"3\" fill=\"var(--zn-accent)\" opacity=\"${\n          value > 0 ? 0.85 : 0.15\n        }\" />` +\n        (valueText\n          ? `<text x=\"${cx}\" y=\"${(y - 4).toFixed(1)}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--zn-fg-muted)\">${valueText}</text>`\n          : '') +\n        `<text x=\"${cx}\" y=\"${H - 7}\" text-anchor=\"middle\" font-size=\"9\" fill=\"var(--zn-fg-muted)\">${label}</text>` +\n        `</g>`\n      )\n    })\n    .join('')\n  return `<svg viewBox=\"0 0 ${W} ${H}\" width=\"100%\" height=\"auto\" style=\"max-width:480px;display:block\" role=\"img\" aria-label=\"近 ${n} 个月支出趋势\">${bars}</svg>`\n}\n\n/** 金额缩写：12345.6 → 1.2万；1234 → 1.2k；< 1000 取整 */\nfunction fmtShort(v) {\n  const n = Number(v) || 0\n  if (n >= 10000) return `${(n / 10000).toFixed(1)}万`\n  if (n >= 1000) return `${(n / 1000).toFixed(1)}k`\n  return String(Math.round(n))\n}\n\n/** HTML 转义 —— 分类名 / 商户名来自通知原文，html 节点是 innerHTML 直投 */\nfunction esc(s) {\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;')\n}\n\n/* ───────────────────── CSV 导出（rev173.29）───────────────────── */\n\n/** 账单 → CSV（RFC 4180；默认带 UTF-8 BOM，Excel 打开中文不乱码） */\nexport function toCsv(txs, opts = {}) {\n  const bom = opts.bom !== false\n  const rows = [['时间', '类型', '金额', '商户', '分类', '来源', '状态']]\n  for (const t of txs || []) {\n    rows.push([\n      fmtDateTime(t.time),\n      t.type === 'income' ? '收入' : '支出',\n      (Number(t.amount) || 0).toFixed(2),\n      t.merchant || '',\n      t.category || '',\n      t.source || '',\n      t.status === 'pending' ? '金额待补' : '已确认',\n    ])\n  }\n  const body = rows.map((r) => r.map(csvCell).join(',')).join('\\r\\n')\n  return (bom ? '\\uFEFF' : '') + body + '\\r\\n'\n}\n\n/** CSV 单元格转义：含逗号 / 双引号 / 换行时用双引号包起来，内部引号翻倍 */\nfunction csvCell(v) {\n  const s = String(v == null ? '' : v)\n  return /[\",\\r\\n]/.test(s) ? `\"${s.replace(/\"/g, '\"\"')}\"` : s\n}\n\n/** 毫秒 → 「YYYY-MM-DD HH:mm:ss」（导出用，带年份便于对账） */\nfunction fmtDateTime(ms) {\n  const d = new Date(ms)\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(\n    d.getHours(),\n  )}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`\n}\n\n/** 毫秒 → 「YYYYMMDD」（导出文件名） */\nfunction dateStamp(ms) {\n  const d = new Date(ms)\n  return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`\n}\n\n/* ───────────────────── CSV 导入（rev173.30）───────────────────── */\n\n/** 拆一行 CSV（RFC 4180：双引号包裹、内部 `\"\"` 转义） */\nfunction splitCsvLine(line) {\n  const out = []\n  let cur = ''\n  let quoted = false\n  for (let i = 0; i < line.length; i++) {\n    const ch = line[i]\n    if (quoted) {\n      if (ch === '\"') {\n        if (line[i + 1] === '\"') {\n          cur += '\"'\n          i++\n        } else {\n          quoted = false\n        }\n      } else {\n        cur += ch\n      }\n    } else if (ch === '\"') {\n      quoted = true\n    } else if (ch === ',') {\n      out.push(cur)\n      cur = ''\n    } else {\n      cur += ch\n    }\n  }\n  out.push(cur)\n  return out\n}\n\n/** 账单时间「2026-10-19 12:36:06」→ 毫秒（本地时区；解析不出返回 0） */\nfunction parseBillTime(s) {\n  const m = /(\\d{4})[-/](\\d{1,2})[-/](\\d{1,2})\\s+(\\d{1,2}):(\\d{2})(?::(\\d{2}))?/.exec(\n    String(s || ''),\n  )\n  if (!m) return 0\n  return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], +(m[6] || 0)).getTime()\n}\n\n/**\n * 解析**微信 / 支付宝**导出的账单 CSV（两家表头都含「交易时间 / 交易对方 / 收/支」）。\n * 返回 `{ ok, source, rows, reason }`；「/」（不计收支）与金额解析失败的行跳过。\n */\nexport function parseBillCsv(text) {\n  const src = String(text || '').replace(/^\\uFEFF/, '')\n  const lines = src.split(/\\r?\\n/)\n  const headerIdx = lines.findIndex(\n    (l) => /交易时间/.test(l) && /交易对方/.test(l) && /(收\\/支|收支)/.test(l),\n  )\n  if (headerIdx < 0) {\n    return {\n      ok: false,\n      source: '',\n      rows: [],\n      reason: '不是可识别的账单（表头需含「交易时间 / 交易对方 / 收/支」）',\n    }\n  }\n  const header = splitCsvLine(lines[headerIdx]).map((h) => h.replace(/\\s/g, ''))\n  const col = (...names) => {\n    for (const n of names) {\n      const i = header.findIndex((h) => h.includes(n))\n      if (i >= 0) return i\n    }\n    return -1\n  }\n  const iTime = col('交易时间')\n  const iCounter = col('交易对方')\n  const iGoods = col('商品')\n  const iDir = col('收/支', '收支')\n  const iAmount = col('金额')\n  const iNo = col('交易单号', '交易订单号')\n  if (iTime < 0 || iDir < 0 || iAmount < 0) {\n    return { ok: false, source: '', rows: [], reason: '账单缺少必要列（交易时间 / 收/支 / 金额）' }\n  }\n  const source = /微信支付账单|微信支付|微信昵称/.test(src.slice(0, 4000))\n    ? '微信账单'\n    : '支付宝账单'\n  const rows = []\n  for (let i = headerIdx + 1; i < lines.length; i++) {\n    const line = lines[i].trim()\n    if (!line || line.startsWith('-----')) continue\n    const cells = splitCsvLine(line)\n    const dir = (cells[iDir] || '').trim()\n    if (dir !== '支出' && dir !== '收入') continue\n    const amount = Number(String(cells[iAmount] || '').replace(/[¥￥,\\s]/g, ''))\n    if (!(amount > 0)) continue\n    const time = parseBillTime(cells[iTime])\n    if (!time) continue\n    const merchant = ((cells[iCounter] || '').trim() || (cells[iGoods] || '').trim() || '未知商户')\n    const goods = iGoods >= 0 ? cells[iGoods] || '' : ''\n    const no = (iNo >= 0 ? cells[iNo] || '' : '').trim()\n    rows.push({\n      id: `imp-${no || `${time}-${amount}`}`,\n      amount,\n      type: dir === '收入' ? 'income' : 'expense',\n      merchant,\n      category: dir === '收入' ? '收入' : classify(merchant, goods),\n      source: '导入',\n      pkg: 'import',\n      time,\n      raw: line.slice(0, 300),\n      status: 'confirmed',\n      ...(no ? { txNo: no } : {}),\n    })\n  }\n  if (!rows.length) {\n    return { ok: false, source, rows: [], reason: '账单里没有可导入的收支记录' }\n  }\n  return { ok: true, source, rows, reason: '' }\n}\n\n/** 导入去重：有交易单号按单号；没有则按「时间(分钟) + 金额 + 商户 + 收支」 */\nexport function mergeImported(txs, imported) {\n  const keyOf = (t) =>\n    t.txNo\n      ? `no:${t.txNo}`\n      : `k:${Math.floor(t.time / 60000)}|${t.amount}|${t.merchant}|${t.type}`\n  const seen = new Set((txs || []).map(keyOf))\n  const list = [...(txs || [])]\n  let added = 0\n  let skipped = 0\n  for (const t of imported || []) {\n    const k = keyOf(t)\n    if (seen.has(k)) {\n      skipped++\n      continue\n    }\n    seen.add(k)\n    list.push(t)\n    added++\n  }\n  list.sort((a, b) => a.time - b.time)\n  return { added, skipped, list }\n}\n\n/* ───────────────────────── 插件本体 ───────────────────────── */\n\nfunction fmtTime(ms) {\n  const d = new Date(ms)\n  return `${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`\n}\n\n/** Tauri IPC（插件在宿主页面里跑，拿注入的全局入口；桌面/浏览器没有它） */\nfunction ipc() {\n  return globalThis.__TAURI_INTERNALS__ || null\n}\n\nexport default {\n  async apply(ctx) {\n    const { command, view, host, store, subscriptions, fs } = ctx\n\n    /** 内存镜像：store 是异步的，面板 render 是同步的 */\n    let txs = []\n    try {\n      txs = (await store.get(STORE_KEY, [])) || []\n    } catch {\n      txs = []\n    }\n    /** 用户改分类学到的「商户 → 分类」（classify 的最优先层） */\n    let userMap = {}\n    try {\n      userMap = (await store.get(CATEGORY_KEY, {})) || {}\n    } catch {\n      userMap = {}\n    }\n    /** 分类列表（用户可自定义；默认内置 9 个） */\n    let categories = CATEGORIES\n    try {\n      const saved = await store.get(CATEGORY_LIST_KEY, null)\n      if (Array.isArray(saved) && saved.length) categories = saved\n    } catch {\n      categories = CATEGORIES\n    }\n    /** 最近一次同步拿到的原始通知（诊断视图用） */\n    let raws = []\n    try {\n      const saved = await store.get(RAW_KEY, [])\n      if (Array.isArray(saved)) raws = saved\n    } catch {\n      raws = []\n    }\n    /** 每月分类预算（rev173.73）：`{ 分类: 金额 }`，跨月沿用 */\n    let budgets = {}\n    try {\n      const saved = await store.get(BUDGET_KEY, {})\n      if (saved && typeof saved === 'object' && !Array.isArray(saved)) budgets = saved\n    } catch {\n      budgets = {}\n    }\n    /** 正在改分类的交易 id（null = 列表视图） */\n    let editingId = null\n    /** 正在补金额的交易 id（rev173.75） */\n    let amountEditId = null\n    /** 待确认删除的分类名（rev173.74；null = 不在确认态） */\n    let catDelete = null\n    /** 待确认删除的交易 id（rev173.75；null = 不在确认态） */\n    let txDeleteId = null\n    /** 面板视图：账单列表 / 统计 / 预算 / 分类管理 / 诊断 */\n    let mode = 'list'\n    let status = { enabled: false, note: '正在检查通知权限…' }\n\n    const refresh = () => {\n      try {\n        view.refresh(PANEL_ID)\n      } catch {\n        /* 面板还没注册时会抛；忽略 */\n      }\n    }\n\n    async function persist() {\n      if (txs.length > MAX_TX) txs = txs.slice(-MAX_TX)\n      await store.set(STORE_KEY, txs)\n    }\n\n    async function checkPermission() {\n      // 桌面没有通知监听：别把「未授权」当成用户没开权限\n      if (ctx.host.platform !== 'android') {\n        status = { enabled: false, note: '当前平台没有通知捕获（桌面只能手动记账）' }\n        refresh()\n        return status\n      }\n      const t = ipc()\n      if (!t) {\n        status = { enabled: false, note: '当前平台没有通知捕获（桌面只能手动记账）' }\n        refresh()\n        return status\n      }\n      try {\n        const on = await t.invoke('plugin:notification-capture|is_enabled')\n        status = {\n          enabled: !!on,\n          note: on\n            ? '通知使用权已开：支付通知会自动进「待同步」'\n            : '通知使用权未开：点「打开授权页」去系统设置勾选本应用',\n        }\n      } catch (e) {\n        status = { enabled: false, note: `权限检查失败：${String(e)}` }\n      }\n      refresh()\n      return status\n    }\n\n    /**\n     * 拉取通知缓存并入库。\n     *\n     * `silent`：启动自动同步用（rev173.76）——没有新账单、也没权限时不打扰用户，\n     * 只有真的补上了才提示一次。\n     */\n    async function sync(opts) {\n      const silent = !!(opts && opts.silent)\n      const t = ipc()\n      if (!t) {\n        if (!silent) host.notify('通知捕获只在 Android 上可用', 'warn')\n        return\n      }\n      let raw = '[]'\n      try {\n        raw = await t.invoke('plugin:notification-capture|drain')\n      } catch (e) {\n        if (!silent) host.notify(`同步失败：${String(e)}`, 'error')\n        return\n      }\n      let notices = []\n      try {\n        notices = JSON.parse(raw || '[]')\n      } catch {\n        notices = []\n      }\n      let added = 0\n      const seen = []\n      for (const n of notices) {\n        const tx = parseNotification(n, userMap)\n        // 诊断留痕：**每条**原始通知都记一笔（含未识别的），只存本机 store\n        seen.push({\n          pkg: n.pkg || '',\n          app: n.app || '',\n          title: String(n.title || '').slice(0, 80),\n          text: String(n.text || '').slice(0, 200),\n          time: Number(n.time) || Date.now(),\n          ok: !!tx,\n          reason: tx ? '' : describeNotice(n, userMap).reason,\n        })\n        if (!tx) continue\n        if (txs.some((x) => x.id === tx.id)) continue\n        txs.push(tx)\n        added++\n      }\n      txs = dedupeTransactions(txs)\n      txs.sort((a, b) => a.time - b.time)\n      await persist()\n      if (seen.length) {\n        raws = seen.slice(-MAX_RAW)\n        try {\n          await store.set(RAW_KEY, raws)\n        } catch {\n          /* 诊断数据存不下不影响记账 */\n        }\n      }\n      if (!silent || added > 0) {\n        host.notify(added > 0 ? `同步完成：新增 ${added} 条账单` : '同步完成：没有新账单')\n      }\n      refresh()\n    }\n\n    async function openSettings() {\n      const t = ipc()\n      if (!t) {\n        host.notify('只有 Android 有通知使用权设置', 'warn')\n        return\n      }\n      try {\n        await t.invoke('plugin:notification-capture|open_settings')\n      } catch (e) {\n        host.notify(`打开设置失败：${String(e)}`, 'error')\n      }\n    }\n\n    /**\n     * 改一笔的分类，并**记住这个商户**（学习）：下次同商户的通知直接归到该类。\n     * 「手动记账 / 未知商户」不学 —— 那不是商户名，学了会污染映射。\n     */\n    async function pickCategory(id, category) {\n      if (!id || !category) return\n      const tx = txs.find((t) => t.id === id)\n      if (!tx) return\n      tx.category = category\n      const m = (tx.merchant || '').trim()\n      if (m && !['手动记账', '未知商户', '未知'].includes(m)) {\n        userMap[m] = category\n        try {\n          await store.set(CATEGORY_KEY, userMap)\n        } catch {\n          /* 学习失败不影响本条修改 */\n        }\n      }\n      await persist()\n      editingId = null\n      refresh()\n      host.notify(`已归到「${category}」${m && !['手动记账', '未知商户'].includes(m) ? `；以后「${m}」自动归类` : ''}`)\n    }\n\n    /** 新增一个自定义分类（只增不删；删了会留下孤立的分类名，后续做管理页） */\n    async function addCategory(payload) {\n      const name = String((payload && payload.value) || '').trim()\n      if (!name) {\n        host.notify('先输入分类名', 'warn')\n        return\n      }\n      if (categories.includes(name)) {\n        host.notify('已经有这个分类了', 'warn')\n        return\n      }\n      categories = [...categories, name]\n      try {\n        await store.set(CATEGORY_LIST_KEY, categories)\n      } catch {\n        /* 存不下不影响本次使用 */\n      }\n      refresh()\n      host.notify(`已新增分类「${name}」，点它给这笔归类`)\n    }\n\n    /* ───────── 预算（rev173.73）· 分类管理（rev173.74）· 补金额（rev173.75） ───────── */\n\n    async function persistBudgets() {\n      try {\n        await store.set(BUDGET_KEY, budgets)\n      } catch {\n        /* 存不下不影响本次显示 */\n      }\n    }\n\n    /** 设/清一个分类的每月预算（`value` 来自输入框；0 或空 = 清除） */\n    function setBudget(payload) {\n      const category = String((payload && payload.category) || '').trim()\n      if (!category) return\n      const raw = payload && payload.value\n      const amount = Number(raw)\n      if (raw === '' || raw == null || Number.isNaN(amount)) {\n        host.notify('先输入金额（填 0 = 清除该分类预算）', 'warn')\n        return\n      }\n      if (amount > 0) {\n        budgets = { ...budgets, [category]: amount }\n      } else {\n        const next = { ...budgets }\n        delete next[category]\n        budgets = next\n      }\n      void persistBudgets()\n      refresh()\n      host.notify(\n        amount > 0 ? `「${category}」每月预算 ¥${amount}` : `已清除「${category}」的预算`,\n      )\n    }\n\n    /** 分类上移 / 下移（顺序就是选分类时的按钮顺序） */\n    function moveCategory(payload) {\n      const category = String((payload && payload.category) || '')\n      const dir = payload && payload.dir === 'up' ? -1 : 1\n      const i = categories.indexOf(category)\n      if (i < 0) return\n      const j = i + dir\n      if (j < 0 || j >= categories.length) return\n      const next = categories.slice()\n      const tmp = next[i]\n      next[i] = next[j]\n      next[j] = tmp\n      categories = next\n      void (async () => {\n        try {\n          await store.set(CATEGORY_LIST_KEY, categories)\n        } catch {\n          /* 存不下不影响本次排序 */\n        }\n      })()\n      refresh()\n    }\n\n    /** 删除分类前先看影响面：这个分类下有 N 笔 ⇒ 提示会归入「其他」 */\n    function askDeleteCategory(payload) {\n      const category = String((payload && payload.category) || '')\n      if (!category || category === '其他') {\n        host.notify('「其他」是兜底分类，不能删', 'warn')\n        return\n      }\n      if (categories.length <= 2) {\n        host.notify('至少保留两个分类（含「其他」）', 'warn')\n        return\n      }\n      catDelete = category\n      refresh()\n    }\n\n    async function deleteCategory() {\n      const category = catDelete\n      if (!category) return\n      catDelete = null\n      const affected = txs.filter((t) => t.category === category)\n      for (const t of affected) t.category = '其他'\n      categories = categories.filter((c) => c !== category)\n      const nextBudgets = { ...budgets }\n      delete nextBudgets[category]\n      budgets = nextBudgets\n      if (affected.length) await persist()\n      try {\n        await store.set(CATEGORY_LIST_KEY, categories)\n      } catch {\n        /* 存不下不影响本次删除 */\n      }\n      await persistBudgets()\n      // 学习映射里指向该分类的商户一并清掉，否则下次又归到已删的分类\n      let learned = 0\n      for (const merchant of Object.keys(userMap)) {\n        if (userMap[merchant] === category) {\n          delete userMap[merchant]\n          learned++\n        }\n      }\n      if (learned) {\n        try {\n          await store.set(CATEGORY_KEY, userMap)\n        } catch {\n          /* 学习映射清理失败不影响主流程 */\n        }\n      }\n      mode = 'cats'\n      refresh()\n      host.notify(\n        affected.length\n          ? `已删除「${category}」；${affected.length} 笔归入「其他」`\n          : `已删除「${category}」`,\n      )\n    }\n\n    function cancelCatDelete() {\n      catDelete = null\n      refresh()\n    }\n\n    /** 金额待补的交易：打开补录视图 / 保存 / 取消 */\n    function fillAmount(payload) {\n      amountEditId = (payload && payload.id) || null\n      refresh()\n    }\n\n    async function saveAmount(payload) {\n      const tx = txs.find((t) => t.id === amountEditId)\n      const amount = Number(payload && payload.value)\n      if (!tx) {\n        amountEditId = null\n        refresh()\n        return\n      }\n      if (!(amount > 0)) {\n        host.notify('金额要大于 0', 'warn')\n        return\n      }\n      tx.amount = amount\n      tx.status = 'confirmed'\n      amountEditId = null\n      await persist()\n      refresh()\n      host.notify(`已补金额 ¥${amount}（${tx.merchant}）`)\n    }\n\n    function cancelAmountEdit() {\n      amountEditId = null\n      refresh()\n    }\n\n    /**\n     * 单笔删除（项目 rev173.75 / 记账子项 173.77）。\n     *\n     * 为什么要它：放宽识别后，完成态但没金额的通知会先进「金额待补」；\n     * 误识别（营销文案里带「支付成功」）也得能清掉 —— 以前只有改分类，删不掉。\n     * 先确认再删：**没有回收站、不可恢复**（与分类删除同一套确认页做法）。\n     */\n    function askRemoveTx(payload) {\n      const id = String((payload && payload.id) || '')\n      if (!id) return\n      txDeleteId = id\n      refresh()\n    }\n\n    async function removeTx() {\n      const id = txDeleteId\n      if (!id) return\n      txDeleteId = null\n      const tx = txs.find((t) => t.id === id)\n      txs = txs.filter((t) => t.id !== id)\n      await persist()\n      refresh()\n      host.notify(tx ? `已删除 ${tx.merchant} ¥${tx.amount.toFixed(2)}` : '已删除这条记录')\n    }\n\n    function cancelRemoveTx() {\n      txDeleteId = null\n      refresh()\n    }\n\n    async function addManual(payload) {\n      const raw = payload && payload.value\n      const amount = Number(raw)\n      if (!(amount > 0)) {\n        host.notify('先输入金额（如 23.5）', 'warn')\n        return\n      }\n      const type = payload && payload.type === 'income' ? 'income' : 'expense'\n      txs.push({\n        id: `tx-${Date.now()}-manual`,\n        amount,\n        type,\n        merchant: '手动记账',\n        category: type === 'income' ? '收入' : '其他',\n        source: '手动',\n        pkg: 'manual',\n        time: Date.now(),\n        raw: '',\n        status: 'confirmed',\n      })\n      await persist()\n      refresh()\n      host.notify(`已记一笔${type === 'income' ? '收入' : '支出'}：¥${amount}`)\n    }\n\n    /**\n     * 导出 CSV：桌面走系统「另存为」；Android 的 SAF 另存为不受支持（host.saveFile 会明确报错）\n     * ⇒ 写进库根目录，用户在文件树里能看到、再自行分享。\n     */\n    async function exportCsv() {\n      if (!txs.length) {\n        host.notify('还没有账单可导出', 'warn')\n        return\n      }\n      const csv = toCsv(txs)\n      const name = `ZeroNote记账-${dateStamp(Date.now())}.csv`\n      if (host.platform !== 'android') {\n        try {\n          const path = await host.saveFile({ defaultName: name, content: csv })\n          if (path) host.notify(`已导出 ${txs.length} 条到 ${path}`)\n          return\n        } catch (e) {\n          host.notify(`另存为失败：${String(e)}；改为写入库内`, 'warn')\n        }\n      }\n      try {\n        await fs.writeText(name, csv)\n        host.notify(`已写入库根目录：${name}（共 ${txs.length} 条）`)\n      } catch (e) {\n        host.notify(`导出失败：${String(e)}`, 'error')\n      }\n    }\n\n    /**\n     * 导入微信 / 支付宝账单 CSV。\n     * 桌面 `pickFile()` 给绝对路径；Android 给 `content://`（先经 uri-reader 复制到缓存）。\n     * 编码兜底：先严格 UTF-8，失败再按 GBK（支付宝导出常是 GBK）。\n     */\n    async function importCsv() {\n      let picked = null\n      try {\n        picked = await host.pickFile()\n      } catch (e) {\n        host.notify(`选择文件失败：${String(e)}`, 'error')\n        return\n      }\n      if (!picked) return\n      try {\n        let path = picked\n        if (/^content:\\/\\//i.test(picked)) {\n          const r = await host.readContentUri(picked)\n          path = r.path\n        }\n        const res = await fetch(host.assetUrlAbs(path))\n        const buf = await res.arrayBuffer()\n        let text = ''\n        try {\n          text = new TextDecoder('utf-8', { fatal: true }).decode(buf)\n        } catch {\n          text = new TextDecoder('gbk').decode(buf)\n        }\n        const parsed = parseBillCsv(text)\n        if (!parsed.ok) {\n          host.notify(parsed.reason, 'warn')\n          return\n        }\n        const { added, skipped, list } = mergeImported(txs, parsed.rows)\n        if (!added) {\n          host.notify(`没有新账单（重复 ${skipped} 条）`, 'warn')\n          return\n        }\n        txs = list\n        await persist()\n        refresh()\n        host.notify(`导入 ${added} 条（${parsed.source}），跳过重复 ${skipped} 条`)\n      } catch (e) {\n        host.notify(`导入失败：${String(e)}`, 'error')\n      }\n    }\n\n    function render() {\n      if (txDeleteId) return renderRemoveTx()\n      if (mode === 'stats') return renderStats()\n      if (mode === 'diag') return renderDiag()\n      if (mode === 'budget') return renderBudget()\n      if (mode === 'cats') return renderCats()\n      if (amountEditId) return renderAmount()\n\n      // 改分类视图：只显示这笔 + 分类按钮列表\n      if (editingId) {\n        const tx = txs.find((t) => t.id === editingId)\n        if (tx) {\n          return {\n            type: 'stack',\n            gap: 'md',\n            children: [\n              {\n                type: 'row',\n                align: 'center',\n                wrap: true,\n                gap: 'sm',\n                children: [\n                  { type: 'button', label: '返回', onClick: 'accounting.cancelEdit', variant: 'ghost' },\n                  {\n                    type: 'text',\n                    value: `给「${tx.merchant} ¥${tx.amount.toFixed(2)}」选分类`,\n                    variant: 'title',\n                  },\n                ],\n              },\n              {\n                type: 'list',\n                items: categories.map((c) => ({\n                  key: c,\n                  node: {\n                    type: 'button',\n                    label: c,\n                    onClick: 'accounting.pickCategory',\n                    payload: { id: tx.id, category: c },\n                  },\n                })),\n              },\n              {\n                type: 'row',\n                align: 'center',\n                wrap: true,\n                gap: 'sm',\n                children: [\n                  { type: 'input', bind: 'acc-newcat', placeholder: '自定义分类，如「宠物」' },\n                  {\n                    type: 'button',\n                    label: '新增分类',\n                    onClick: 'accounting.addCategory',\n                    send: 'acc-newcat',\n                  },\n                ],\n              },\n            ],\n          }\n        }\n        editingId = null\n      }\n\n      const key = monthKey(Date.now())\n      const inMonth = txs.filter((t) => monthKey(t.time) === key)\n      const spend = inMonth\n        .filter((t) => t.type === 'expense')\n        .reduce((s, t) => s + t.amount, 0)\n      const income = inMonth\n        .filter((t) => t.type === 'income')\n        .reduce((s, t) => s + t.amount, 0)\n      const recent = txs.slice(-20).reverse()\n\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'text', value: '记账', variant: 'title' },\n              { type: 'button', label: '同步通知', onClick: 'accounting.sync' },\n              { type: 'button', label: '统计', onClick: 'accounting.stats', variant: 'ghost' },\n              { type: 'button', label: '预算', onClick: 'accounting.budget', variant: 'ghost' },\n              { type: 'button', label: '分类', onClick: 'accounting.cats', variant: 'ghost' },\n              { type: 'button', label: '导出 CSV', onClick: 'accounting.exportCsv', variant: 'ghost' },\n              { type: 'button', label: '导入 CSV', onClick: 'accounting.importCsv', variant: 'ghost' },\n              { type: 'button', label: '诊断', onClick: 'accounting.diag', variant: 'ghost' },\n              { type: 'button', label: '检查权限', onClick: 'accounting.check', variant: 'ghost' },\n              { type: 'button', label: '打开授权页', onClick: 'accounting.openSettings', variant: 'ghost' },\n            ],\n          },\n          {\n            type: 'text',\n            value: `本月支出 ¥${spend.toFixed(2)} · 收入 ¥${income.toFixed(2)} · 结余 ¥${(income - spend).toFixed(2)}`,\n          },\n          {\n            type: 'text',\n            value: status.note,\n            variant: 'caption',\n            tone: status.enabled ? 'success' : 'warn',\n          },\n          { type: 'divider' },\n          {\n            type: 'list',\n            empty: '还没有账单。点「同步通知」拉取支付通知，或在下面手动记一笔。',\n            items: recent.map((t) => ({\n              key: t.id,\n              node: {\n                type: 'row',\n                align: 'center',\n                wrap: true,\n                gap: 'sm',\n                children: [\n                  {\n                    type: 'text',\n                    value: `${fmtTime(t.time)} · ${t.merchant} ¥${t.amount.toFixed(2)}`,\n                  },\n                  {\n                    type: 'button',\n                    label:\n                      t.category === '其他'\n                        ? t.type === 'income'\n                          ? '收入'\n                          : '其他 · 待分类'\n                        : t.category || '其他',\n                    onClick: 'accounting.editCategory',\n                    payload: { id: t.id },\n                    variant: 'ghost',\n                  },\n                  ...(t.status === 'pending'\n                    ? [\n                        { type: 'badge', text: '金额待补', tone: 'warn' },\n                        {\n                          type: 'button',\n                          label: '补金额',\n                          onClick: 'accounting.fillAmount',\n                          payload: { id: t.id },\n                          variant: 'ghost',\n                        },\n                      ]\n                    : []),\n                  // 单笔删除（项目 rev173.75）：误识别的通知也能清掉，先确认再删\n                  {\n                    type: 'button',\n                    label: '删除',\n                    onClick: 'accounting.askRemoveTx',\n                    payload: { id: t.id },\n                    variant: 'ghost',\n                  },\n                ],\n              },\n            })),\n          },\n          { type: 'divider' },\n          { type: 'text', value: '手动记一笔', variant: 'caption', tone: 'muted' },\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'input', bind: 'acc-amount', placeholder: '金额，如 23.5' },\n              {\n                type: 'button',\n                label: '记支出',\n                onClick: 'accounting.addExpense',\n                send: 'acc-amount',\n              },\n              {\n                type: 'button',\n                label: '记收入',\n                onClick: 'accounting.addIncome',\n                send: 'acc-amount',\n                variant: 'ghost',\n              },\n            ],\n          },\n        ],\n      }\n    }\n\n    /** 预算视图（rev173.73）：每个分类一行「分类 · 当前预算 · 输入 · 存」 */\n    function renderBudget() {\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'button', label: '返回账单', onClick: 'accounting.backToList', variant: 'ghost' },\n              { type: 'text', value: '每月预算', variant: 'title' },\n            ],\n          },\n          {\n            type: 'text',\n            value: '预算按「分类 + 每月」算；填 0 再点存 = 取消该分类预算。',\n            variant: 'caption',\n            tone: 'muted',\n          },\n          {\n            type: 'list',\n            items: categories.map((c) => ({\n              key: c,\n              node: {\n                type: 'row',\n                align: 'center',\n                wrap: true,\n                gap: 'sm',\n                children: [\n                  { type: 'text', value: c },\n                  {\n                    type: 'text',\n                    value: `当前 ¥${Number(budgets[c] || 0).toFixed(2)}`,\n                    variant: 'caption',\n                    tone: 'muted',\n                  },\n                  { type: 'input', bind: `acc-budget-${c}`, placeholder: '每月金额' },\n                  {\n                    type: 'button',\n                    label: '存',\n                    onClick: 'accounting.setBudget',\n                    payload: { category: c },\n                    send: `acc-budget-${c}`,\n                  },\n                ],\n              },\n            })),\n          },\n        ],\n      }\n    }\n\n    /** 分类管理（rev173.74）：排序 + 删除（删除前先看影响面） */\n    function renderCats() {\n      if (catDelete) {\n        const n = txs.filter((t) => t.category === catDelete).length\n        return {\n          type: 'stack',\n          gap: 'md',\n          children: [\n            { type: 'text', value: `删除分类「${catDelete}」？`, variant: 'title' },\n            {\n              type: 'text',\n              value: n\n                ? `该分类下有 ${n} 笔记录，删除后归入「其他」；它的预算与学习映射也会一并清掉。`\n                : '该分类下没有记录。',\n              tone: 'warn',\n            },\n            {\n              type: 'row',\n              align: 'center',\n              wrap: true,\n              gap: 'sm',\n              children: [\n                { type: 'button', label: '确认删除', onClick: 'accounting.deleteCategory' },\n                // eslint-disable-next-line -- 文案里的命令 id 是契约\n                { type: 'button', label: '取消', onClick: 'accounting.cancelCatDelete', variant: 'ghost' },\n              ],\n            },\n          ],\n        }\n      }\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'button', label: '返回账单', onClick: 'accounting.backToList', variant: 'ghost' },\n              { type: 'text', value: '分类管理', variant: 'title' },\n            ],\n          },\n          {\n            type: 'text',\n            value: '顺序就是选分类时的按钮顺序；「其他」是兜底分类，不能删。',\n            variant: 'caption',\n            tone: 'muted',\n          },\n          {\n            type: 'list',\n            items: categories.map((c, i) => ({\n              key: c,\n              node: {\n                type: 'row',\n                align: 'center',\n                wrap: true,\n                gap: 'sm',\n                children: [\n                  { type: 'text', value: `${i + 1}. ${c}` },\n                  {\n                    type: 'button',\n                    label: '↑',\n                    onClick: 'accounting.moveCategory',\n                    payload: { category: c, dir: 'up' },\n                    variant: 'ghost',\n                  },\n                  {\n                    type: 'button',\n                    label: '↓',\n                    onClick: 'accounting.moveCategory',\n                    payload: { category: c, dir: 'down' },\n                    variant: 'ghost',\n                  },\n                  ...(c === '其他'\n                    ? []\n                    : [\n                        {\n                          type: 'button',\n                          label: '删除',\n                          onClick: 'accounting.askDeleteCategory',\n                          payload: { category: c },\n                          variant: 'ghost',\n                        },\n                      ]),\n                ],\n              },\n            })),\n          },\n        ],\n      }\n    }\n\n    /**\n     * 删除单笔确认页（项目 rev173.75）：**没有回收站**，所以先把这笔的原文摆出来。\n     */\n    function renderRemoveTx() {\n      const tx = txs.find((t) => t.id === txDeleteId)\n      if (!tx) {\n        txDeleteId = null\n        return render()\n      }\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          { type: 'text', value: '删除这笔记录？', variant: 'title' },\n          {\n            type: 'text',\n            value: `${fmtTime(tx.time)} · ${tx.merchant} ¥${tx.amount.toFixed(2)}${tx.status === 'pending' ? '（金额待补）' : ''}`,\n            tone: 'warn',\n          },\n          { type: 'text', value: `原文：${tx.raw || '（无）'}`, variant: 'caption', tone: 'muted' },\n          { type: 'text', value: '删除后无法恢复（不进回收站）。', variant: 'caption', tone: 'muted' },\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'button', label: '确认删除', onClick: 'accounting.removeTx' },\n              { type: 'button', label: '取消', onClick: 'accounting.cancelRemoveTx', variant: 'ghost' },\n            ],\n          },\n        ],\n      }\n    }\n\n    /** 补金额（rev173.75）：通知里没识别到金额、但确实是支付的记录 */\n    function renderAmount() {\n      const tx = txs.find((t) => t.id === amountEditId)\n      if (!tx) {\n        amountEditId = null\n        return render()\n      }\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'button', label: '返回', onClick: 'accounting.cancelAmount', variant: 'ghost' },\n              { type: 'text', value: '补金额', variant: 'title' },\n            ],\n          },\n          { type: 'text', value: `${fmtTime(tx.time)} · ${tx.merchant}` },\n          { type: 'text', value: `原文：${tx.raw || '（无）'}`, variant: 'caption', tone: 'muted' },\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              { type: 'input', bind: 'acc-amount-fill', placeholder: '金额，如 23.5' },\n              {\n                type: 'button',\n                label: '保存金额',\n                onClick: 'accounting.saveAmount',\n                send: 'acc-amount-fill',\n              },\n            ],\n          },\n        ],\n      }\n    }\n\n    /** 统计视图（rev173.28）：本月分类占比 + 近 6 个月支出柱状图 */\n    function renderStats() {\n      const now = new Date()\n      const key = monthKey(Date.now())\n      const inMonth = txs.filter((t) => monthKey(t.time) === key)\n      const spend = inMonth\n        .filter((t) => t.type === 'expense')\n        .reduce((s, t) => s + t.amount, 0)\n      const income = inMonth\n        .filter((t) => t.type === 'income')\n        .reduce((s, t) => s + t.amount, 0)\n      const sum = summarizeByCategory(txs, now.getFullYear(), now.getMonth() + 1)\n      const budgetsNow = budgetStatus(txs, budgets, now.getFullYear(), now.getMonth() + 1)\n      const trend = monthlyTrend(txs, 6)\n\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              {\n                type: 'button',\n                label: '返回账单',\n                onClick: 'accounting.backToList',\n                variant: 'ghost',\n              },\n              { type: 'text', value: '统计', variant: 'title' },\n              { type: 'button', label: '预算', onClick: 'accounting.budget', variant: 'ghost' },\n            ],\n          },\n          {\n            type: 'text',\n            value: `本月支出 ¥${spend.toFixed(2)} · 收入 ¥${income.toFixed(2)} · 结余 ¥${(\n              income - spend\n            ).toFixed(2)}`,\n          },\n          ...(sum.rows.length\n            ? [\n                { type: 'text', value: '支出分类占比', variant: 'caption', tone: 'muted' },\n                ...sum.rows.map((r) => {\n                  const pct = Math.round(r.pct * 100)\n                  return {\n                    type: 'progress',\n                    value: r.amount,\n                    max: sum.total || 1,\n                    label: `${r.category} ¥${r.amount.toFixed(2)} · ${\n                      pct === 0 && r.amount > 0 ? '<1' : pct\n                    }% · ${r.count} 笔`,\n                  }\n                }),\n              ]\n            : [{ type: 'text', value: '本月还没有支出记录', tone: 'muted' }]),\n          { type: 'divider' },\n          { type: 'text', value: '预算执行（本月）', variant: 'caption', tone: 'muted' },\n          ...(budgetsNow.length\n            ? budgetsNow.map((b) => ({\n                type: 'progress',\n                value: b.spent,\n                max: b.budget,\n                label: `${b.category} ¥${b.spent.toFixed(2)} / ¥${b.budget.toFixed(2)} · ${\n                  b.over ? `超 ¥${(b.spent - b.budget).toFixed(2)}` : `剩 ¥${b.left.toFixed(2)}`\n                }`,\n              }))\n            : [{ type: 'text', value: '还没有设置预算（点上面「预算」）', tone: 'muted' }]),\n          { type: 'divider' },\n          { type: 'text', value: '近 6 个月支出', variant: 'caption', tone: 'muted' },\n          { type: 'html', value: trendSvg(trend) },\n        ],\n      }\n    }\n\n    /** 原始通知诊断（rev173.28.1）：同步时留下的原文 + 为什么没记上 */\n    function renderDiag() {\n      const list = raws.slice().reverse()\n      return {\n        type: 'stack',\n        gap: 'md',\n        children: [\n          {\n            type: 'row',\n            align: 'center',\n            wrap: true,\n            gap: 'sm',\n            children: [\n              {\n                type: 'button',\n                label: '返回账单',\n                onClick: 'accounting.backToList',\n                variant: 'ghost',\n              },\n              { type: 'text', value: '原始通知', variant: 'title' },\n            ],\n          },\n          {\n            type: 'text',\n            value:\n              '点「同步通知」后，最近 20 条原文会留在这里（只在本机 store，不导出）。「未识别」的行是解析规则没认出来的 —— 对照原文就能看出该补什么。',\n            variant: 'caption',\n            tone: 'muted',\n          },\n          {\n            type: 'list',\n            empty: '还没有同步记录。先去「同步通知」拉一次通知。',\n            items: list.map((r, i) => ({\n              key: `${r.time}-${i}`,\n              node: {\n                type: 'stack',\n                gap: 'sm',\n                children: [\n                  {\n                    type: 'row',\n                    align: 'center',\n                    wrap: true,\n                    gap: 'sm',\n                    children: [\n                      {\n                        type: 'text',\n                        value: `${fmtTime(r.time)} · ${r.app || r.pkg || '未知'}`,\n                        variant: 'caption',\n                        tone: 'muted',\n                      },\n                      {\n                        type: 'badge',\n                        text: r.ok ? '已记账' : '未识别',\n                        tone: r.ok ? 'success' : 'warn',\n                      },\n                    ],\n                  },\n                  {\n                    type: 'text',\n                    value: `${r.title ? `${r.title} · ` : ''}${r.text || ''}`,\n                    variant: 'caption',\n                  },\n                  ...(r.reason\n                    ? [{ type: 'text', value: `原因：${r.reason}`, variant: 'caption', tone: 'warn' }]\n                    : []),\n                ],\n              },\n            })),\n          },\n        ],\n      }\n    }\n\n    subscriptions.push(\n      command.register({\n        id: 'accounting.sync',\n        title: '记账：同步支付通知',\n        run: () => sync(),\n      }),\n      command.register({\n        id: 'accounting.stats',\n        title: '记账：统计',\n        run: () => {\n          mode = 'stats'\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.exportCsv',\n        title: '记账：导出 CSV',\n        run: () => exportCsv(),\n      }),\n      command.register({\n        id: 'accounting.importCsv',\n        title: '记账：导入 CSV（微信/支付宝账单）',\n        run: () => importCsv(),\n      }),\n      command.register({\n        id: 'accounting.diag',\n        title: '记账：原始通知诊断',\n        run: () => {\n          mode = 'diag'\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.backToList',\n        title: '记账：返回账单列表',\n        run: () => {\n          mode = 'list'\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.check',\n        title: '记账：检查通知权限',\n        run: () => checkPermission(),\n      }),\n      command.register({\n        id: 'accounting.openSettings',\n        title: '记账：打开通知使用权设置',\n        run: () => openSettings(),\n      }),\n      command.register({\n        id: 'accounting.addExpense',\n        title: '记账：记一笔支出（用金额输入框）',\n        run: (p) => addManual({ value: p && p.value, type: 'expense' }),\n      }),\n      command.register({\n        id: 'accounting.addIncome',\n        title: '记账：记一笔收入（用金额输入框）',\n        run: (p) => addManual({ value: p && p.value, type: 'income' }),\n      }),\n      command.register({\n        id: 'accounting.editCategory',\n        title: '记账：改这笔的分类',\n        run: (p) => {\n          editingId = (p && p.id) || null\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.pickCategory',\n        title: '记账：选定分类',\n        run: (p) => pickCategory(p && p.id, p && p.category),\n      }),\n      command.register({\n        id: 'accounting.cancelEdit',\n        title: '记账：取消改分类',\n        run: () => {\n          editingId = null\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.addCategory',\n        title: '记账：新增自定义分类',\n        run: (p) => addCategory(p),\n      }),\n      /* ── 预算 / 分类管理 / 补金额（rev173.73–173.75）── */\n      command.register({\n        id: 'accounting.budget',\n        title: '记账：设置每月预算',\n        run: () => {\n          mode = 'budget'\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.setBudget',\n        title: '记账：保存某个分类的预算',\n        run: (p) => setBudget(p),\n      }),\n      command.register({\n        id: 'accounting.cats',\n        title: '记账：分类管理（排序 / 删除）',\n        run: () => {\n          mode = 'cats'\n          catDelete = null\n          refresh()\n        },\n      }),\n      command.register({\n        id: 'accounting.moveCategory',\n        title: '记账：移动分类',\n        run: (p) => moveCategory(p),\n      }),\n      command.register({\n        id: 'accounting.askDeleteCategory',\n        title: '记账：删除分类（先确认）',\n        run: (p) => askDeleteCategory(p),\n      }),\n      command.register({\n        id: 'accounting.deleteCategory',\n        title: '记账：确认删除分类',\n        run: () => deleteCategory(),\n      }),\n      command.register({\n        id: 'accounting.cancelCatDelete',\n        title: '记账：取消删除分类',\n        run: () => cancelCatDelete(),\n      }),\n      command.register({\n        id: 'accounting.fillAmount',\n        title: '记账：补金额',\n        run: (p) => fillAmount(p),\n      }),\n      command.register({\n        id: 'accounting.saveAmount',\n        title: '记账：保存补录金额',\n        run: (p) => saveAmount(p),\n      }),\n      command.register({\n        id: 'accounting.cancelAmount',\n        title: '记账：取消补金额',\n        run: () => cancelAmountEdit(),\n      }),\n      /* ── 单笔删除（项目 rev173.75）── */\n      command.register({\n        id: 'accounting.askRemoveTx',\n        title: '记账：删除这笔（先确认）',\n        run: (p) => askRemoveTx(p),\n      }),\n      command.register({\n        id: 'accounting.removeTx',\n        title: '记账：确认删除这笔',\n        run: () => removeTx(),\n      }),\n      command.register({\n        id: 'accounting.cancelRemoveTx',\n        title: '记账：取消删除这笔',\n        run: () => cancelRemoveTx(),\n      }),\n      view.registerPanel({\n        id: PANEL_ID,\n        title: '记账',\n        location: 'main',\n        render,\n      }),\n    )\n\n    // 启动即检查一次权限（不阻塞插件加载）\n    void checkPermission()\n    /**\n     * rev173.76：启动自动拉一次通知缓存（静默）。\n     *\n     * 为什么：App 没开时收到的支付通知只进原生缓存，原来必须用户手动点「同步通知」才入库；\n     * 忘了点就一直躺着（最多压 200 条）。启动静默 drain 一次，没有新账单就不打扰。\n     */\n    void sync({ silent: true })\n  },\n}\n",
    "signature.json": "{\n  \"alg\": \"ed25519\",\n  \"keyId\": \"aqua-2026\",\n  \"sig\": \"hLa4eBJCT2PuMU5fbljG7ooi7wuxMcaH690qOo0Mau0P/RDsm1NZILMTGV4dSzbWsAwqdGlyAysq+9jAwcViBw==\"\n}\n"
  }
}
