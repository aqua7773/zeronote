<?xml version="1.0" encoding="utf-8"?>
<!-- ZeroNote 通知捕获插件：声明 NotificationListenerService。
     系统通过 BIND_NOTIFICATION_LISTENER_SERVICE 权限绑定它；
     用户必须在「设置 → 通知使用权」里手动勾选本应用（系统不会弹窗申请）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="app.tauri.notificationcapture.NotificationCaptureService"
      android:exported="true"
      android:label="ZeroNote 通知捕获"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
