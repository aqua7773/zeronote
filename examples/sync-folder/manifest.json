{
  "manifestVersion": 1,
  "id": "sync-folder",
  "name": "同步 · 本地文件夹",
  "version": "0.2.0",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "库放在同步目录（Syncthing / OneDrive / 坚果云）里时，替你盯住双端冲突；双端改同一篇能自动合",
  "category": "tool",
  "capabilities": ["fs:read", "fs:write", "doc:read", "store", "event", "command", "view:main", "host"],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "sync-folder.open", "title": "同步：打开同步状态" },
      { "id": "sync-folder.scan", "title": "同步：立即检查一次" },
      { "id": "sync-folder.mark-synced", "title": "同步：把当前状态设为基线" }
    ],
    "panels": [{ "id": "sync-folder.status", "title": "同步", "location": "main" }]
  }
}
