<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 方案 D：把笔记库放公共存储（/storage/emulated/0/Documents/ZeroNote）。
         让文件管理器能看到库、插件能直接拷进 .zn/plugins/、数据卸载不丢。
         ⚠️ 敏感权限：Google Play 只批给文件管理器/备份类应用（自用无碍）。
         用户授权入口：设置 → 应用 → ZeroNote → 特殊权限 → 所有文件访问
         开发期等价命令：adb shell appops set com.aqua.zeronote.debug MANAGE_EXTERNAL_STORAGE allow -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.zeronote"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- windowSoftInputMode="adjustResize"：**软键盘弹起时把 WebView 压矮**，
             而不是把整个页面往上平移（默认的 adjustUnspecified 会选 pan/nothing）。
             没有它，编辑器底部那条 Markdown 快捷输入栏（`view` 的 editor-toolbar 位置）
             会被键盘整个盖住 —— 手机上的实测现象。
             前端配合：布局用百分比高度（`html/body/#root/.zn-app { height: 100% }`），
             视口一变矮就自然缩，不需要 `100vh` 那种固定高度。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/markdown" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.markdown" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/pdf" />
                <data android:pathPattern=".*\\.pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:pathPattern=".*\\.epub" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:pathPattern=".*\\.mobi" />
                <data android:pathPattern=".*\\.azw3" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:pathPattern=".*\\.fb2" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:pathPattern=".*\\.cbz" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
            
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- ── 桌面组件（rev173.242 · 需求 §15）──────────────────────────────
             快速输入：组件本体是一个按钮，点击开对话框样式的 QuickCaptureActivity。

             · receiver 用 exported="false"：更新广播来自系统，系统对非导出 receiver 有特权；
               导出反而让任意应用能伪造 APPWIDGET_UPDATE（官方模板同样用 false）。
             · Activity 也 exported="false"：只被本应用的 PendingIntent 启动。
             · excludeFromRecents + theme=对话框 ⇒ 不在「最近任务」里留一张卡片。 -->
        <receiver
            android:name=".QuickCaptureWidget"
            android:exported="false"
            android:label="@string/widget_quick_capture_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_capture_info" />
        </receiver>

        <!-- 最近笔记：只显示公开笔记，条数随组件高度 1/3/5/7 档变化（需求 §15.3） -->
        <receiver
            android:name=".RecentNotesWidget"
            android:exported="false"
            android:label="@string/widget_recent_notes_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_notes_info" />
        </receiver>

        <!-- 今日打卡：点一行 = 打一次卡（写回 habit 插件的 store，需求 §15.2）
             ⚠️ 这个 receiver 同时收「点击」广播 ⇒ exported 仍为 false，
             广播由本应用自己的 PendingIntent 发出，外部应用发不进来。 -->
        <receiver
            android:name=".HabitWidget"
            android:exported="false"
            android:label="@string/widget_habit_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habit_info" />
        </receiver>

        <activity
            android:name=".QuickCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_capture_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.zeronote.Dialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />
    </application>
</manifest>
