{
  "manifestVersion": 1,
  "id": "tag-panel",
  "name": "标签",
  "version": "0.2.0",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "按标签浏览与跳转",
  "category": "tool",
  "capabilities": ["index:query", "doc:read", "command", "view:main", "view:modal", "editor:mark", "host"],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "tag-panel.open", "title": "标签：打开标签面板" },
      { "id": "tag-panel.select", "title": "标签：筛选这个标签" },
      { "id": "tag-panel.clear", "title": "标签：取消筛选" },
      { "id": "tag-panel.rebuild", "title": "标签：重建索引" },
      { "id": "tag-panel.openNote", "title": "标签：打开该笔记" },
      { "id": "tag-panel.show-for-tag", "title": "标签：看这个标签下的笔记" },
      { "id": "tag-panel.openInWindow", "title": "标签：在那篇的独立窗口打开" }
    ],
    "panels": [
      { "id": "tag-panel.board", "title": "标签", "location": "main" },
      { "id": "tag-panel.peek", "title": "标签", "location": "modal" }
    ]
  }
}
