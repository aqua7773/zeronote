{
  "manifestVersion": 1,
  "id": "sync",
  "name": "同步",
  "version": "0.1.5",
  "apiVersion": "^0.2.0",
  "entry": "index.cjs",
  "files": [
    "lib/core.cjs",
    "lib/backends/webdav.cjs",
    "lib/backends/folder.cjs",
    "lib/backends/s3.cjs",
    "lib/backends/git.cjs",
    "styles.css"
  ],
  "styles": ["styles.css"],
  "platforms": ["desktop", "android"],
  "description": "多后端同步：WebDAV / S3 / Git / 本地文件夹，一个插件搞定；冲突直接在编辑页里两段选一段。⚠️ 装前请先卸载旧的 sync-webdav / sync-s3 / sync-git / sync-folder（同时启用会抢同一批文件）",
  "category": "tool",
  "capabilities": [
    "fs:read",
    "fs:write",
    "doc:read",
    "store",
    "command",
    "view:main",
    "editor:line-action",
    "editor:line-class",
    "net"
  ],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "sync.open", "title": "同步：打开设置与状态" },
      { "id": "sync.test", "title": "同步：测试连接" },
      { "id": "sync.run", "title": "同步：立即同步一次" },
      { "id": "sync.set-backend", "title": "同步：切换同步方式（WebDAV / S3 / Git / 本地文件夹）" },
      { "id": "sync.mark-baseline", "title": "同步：把当前状态设为基线（本地文件夹）" },
      { "id": "sync.set-provider", "title": "同步：选择 Git 平台（GitHub / Gitea / Gitee）" },
      { "id": "sync.toggle-auto", "title": "同步：开关自动同步" },
      { "id": "sync.set-attachments", "title": "同步：设置附件同步方式（不同步 / 中转 / 永久）" },
      { "id": "sync.save", "title": "同步：保存设置" },
      { "id": "sync.open-conflict", "title": "同步：打开冲突副本" },
      { "id": "sync.resolve-conflict", "title": "同步：处理一条冲突（保留本机版 / 远端版）" },
      { "id": "sync.pick-conflict", "title": "同步：保留冲突里的这一段" },
      { "id": "sync.disconnect", "title": "同步：断开并清除凭据" }
    ],
    "panels": [{ "id": "sync.status", "title": "同步", "location": "main" }]
  }
}
