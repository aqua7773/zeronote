{
  "manifestVersion": 1,
  "id": "secrets",
  "name": "密码库",
  "version": "0.1.0",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "绝密账号库：平台 / 账号两级，整库加密存 .zn/secrets/，需要先装「安全」插件提供密钥环",
  "category": "tool",
  "capabilities": ["command", "fs:read", "fs:write", "view:main"],
  "activationEvents": ["onStartup"],
  "dependencies": ["security"],
  "contributes": {
    "commands": [
      { "id": "secrets.open", "title": "密码库：打开" },
      { "id": "secrets.lock", "title": "密码库：立即锁定" },
      { "id": "secrets.new-platform", "title": "密码库：新建平台" },
      { "id": "secrets.goto-recycle", "title": "密码库：回收站" },
      { "id": "secrets.recheck", "title": "密码库：重新检查密钥环" }
    ],
    "panels": [{ "id": "secrets.panel", "title": "密码库", "location": "main" }]
  }
}
