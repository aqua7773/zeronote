{
  "manifestVersion": 1,
  "id": "security",
  "name": "安全",
  "version": "0.5.3",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "styles": ["styles.css"],
  "platforms": ["desktop", "android"],
  "description": "主密码与密钥环（私密笔记 / 账号密码 + 可新建自定义环）；密钥环由面板下拉分配给插件（一环一插件）；指纹一次绑定、多环继承",
  "category": "tool",
  "capabilities": ["command", "fs:read", "fs:write", "view:main", "view:statusbar", "host"],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "security.open", "title": "安全：打开面板" },
      { "id": "security.open-ring", "title": "安全：打开密钥环（解锁 / 管理）" },
      { "id": "security.test-ring", "title": "安全：测试密钥环主密码" },
      { "id": "security.select", "title": "安全：切换密钥环" },
      { "id": "security.setup", "title": "安全：建立密钥环" },
      { "id": "security.unlock", "title": "安全：解锁" },
      { "id": "security.unlock-ring", "title": "安全：解锁密钥环（指纹优先，回落主密码）" },
      { "id": "security.lock", "title": "安全：立即锁定" },
      { "id": "security.change-password", "title": "安全：换主密码" },
      { "id": "security.recover-answer", "title": "安全：用恢复问题解锁" },
      { "id": "security.recover-code", "title": "安全：用恢复码解锁" },
      { "id": "security.reset-after-recovery", "title": "安全：恢复后重设主密码" },
      { "id": "security.biometric-unlock", "title": "安全：用生物识别解锁" },
      { "id": "security.biometric-bind", "title": "安全：绑定生物识别" },
      { "id": "security.biometric-toggle", "title": "安全：绑定 / 解除这台设备的指纹" },
      { "id": "security.biometric-unbind", "title": "安全：解除生物识别" },
      { "id": "security.assign-ring", "title": "安全：把密钥环分配给插件 / 解除分配" },
      { "id": "security.assign-menu", "title": "安全：展开密钥环分配菜单" },
      { "id": "security.create-ring", "title": "安全：新建密钥环" },
      { "id": "security.delete-ring", "title": "安全：删除密钥环（需输入主密码）" },
      { "id": "security.rotate-ring", "title": "安全：把某个插件的数据换到另一把密钥环" },
      { "id": "security.self-test", "title": "安全：自检" }
    ],
    "panels": [
      { "id": "security.panel", "title": "安全", "location": "main" },
      { "id": "security.status", "title": "安全", "location": "statusbar" }
    ]
  }
}
