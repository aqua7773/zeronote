{
  "manifestVersion": 1,
  "id": "sync-git",
  "name": "同步 · Git",
  "version": "0.5.2",
  "apiVersion": "^0.2.0",
  "entry": "index.js",
  "platforms": ["desktop", "android"],
  "description": "用代码托管平台的 Contents API 同步（GitHub / Gitea / Gitee），sha 当乐观锁，双端改同一篇能自动合，附件可选中转或永久同步",
  "category": "tool",
  "capabilities": ["fs:read", "fs:write", "doc:read", "store", "event", "command", "view:main", "host", "net", "service"],
  "activationEvents": ["onStartup"],
  "contributes": {
    "commands": [
      { "id": "sync-git.open", "title": "同步：打开 Git 设置与状态" },
      { "id": "sync-git.test", "title": "同步：测试 Git 连接" },
      { "id": "sync-git.sync", "title": "同步：立即同步一次（Git）" },
      { "id": "sync-git.set-attachments", "title": "同步：设置附件同步方式（Git）" },
      { "id": "sync-git.toggle-auto", "title": "同步：开关自动同步（Git）" },
      { "id": "sync-git.set-provider", "title": "同步：选择 Git 平台（GitHub / Gitea / Gitee）" },
      { "id": "sync-git.save", "title": "同步：保存 Git 设置" },
      { "id": "sync-git.disconnect", "title": "同步：断开 Git 并清除令牌" }
    ],
    "panels": [{ "id": "sync-git.status", "title": "同步 · Git", "location": "main" }]
  }
}
