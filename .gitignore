# 依赖与构建产物
node_modules/
dist/
dist-ssr/
target/
src-tauri/target/

# 环境
.env
.env.local
*.local

# 日志
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.sw?

# ZeroNote 私有目录（库内，不入库）
.zn/

# 本地测试库 / 临时验证库（验收夹具，不入库）
_test-vault/
_tmp-*/

# 过程产物：窗口截图（不入库）
_shots/

# 过程产物：出包日志与签名中转（APK/so/zip 都是可重出的中间物，不入库；说明见 _build/README.md）
_build/*
!_build/README.md

# 内核快照（自愈用；内容与仓库重复，不入库 —— 要异地恢复走 GitHub，见 docs/架构原则-2026-10-13.md §4.5）
_kernel-snapshots/

# 插件运行时 store（把插件目录 junction 到 examples/ 做开发时会写进源码目录，不入库）
examples/*/store.json

# 本地日志（Android dev 等）
.self-logs/

# Tauri Android 构建缓存（`gen/android/` 本身入库，但它的 Kotlin/Gradle 中间产物不入库）
src-tauri/gen/android/.kotlin/

# 临时配置备份（rev112 release 构建用，不入库）
src-tauri/tauri.conf.json.dev-backup
