<?xml version="1.0" encoding="utf-8"?>
<!-- 快速输入对话框的布局（rev173.242 · 需求 §15.1「点击后弹出轻量输入框」） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/quick_capture_title"
        android:textColor="@color/widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_capture_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="top|start"
        android:hint="@string/quick_capture_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="8"
        android:minLines="3"
        android:textColor="@color/widget_text"
        android:textColorHint="@color/widget_text_faint"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_capture_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_capture_cancel"
            android:textAllCaps="false"
            android:textColor="@color/widget_text_faint" />

        <Button
            android:id="@+id/quick_capture_save"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_capture_save"
            android:textAllCaps="false"
            android:textColor="@color/widget_text" />

    </LinearLayout>

</LinearLayout>
